---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import HubOverlay from '../chrome/HubOverlay.astro';
import ChatTrigger from '../chrome/ChatTrigger.astro';
import type { HubId } from '../content/ui/site';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  variant?: 'landing' | 'hub' | 'minimal';
  hub?: HubId;
  showChat?: boolean;
}

const {
  title,
  description = 'Pamana — prostate cancer support for Aotearoa New Zealand',
  variant = 'hub',
  hub = 'patient',
  showChat = true,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader variant={variant} hub={hub} />
    <HubOverlay />
    <main>
      <slot />
    </main>
    {showChat && <ChatTrigger />}
    <SiteFooter />
  </body>
</html>

<style is:global>
  main {
    min-height: calc(100vh - 160px);
  }
</style>
