---
const { label, buttonItems = [] } = Astro.props;
const id = `font-size-${label.toLowerCase().replace(/\s+/g, '-')}`;

function sizeClass(value: string) {
  if (value === 'small') return 'text-xs';
  if (value === 'medium') return 'text-sm';
  return 'text-base';
}
---

<div class="hidden md:flex items-center">
  <span class="text-sm font-medium mr-3">{label}</span>
  <div class="flex rounded-md overflow-hidden border border-[var(--color-palette-two)]" id={id}>
    {buttonItems.map((item) => (
      <button
        type="button"
        class={`${sizeClass(item.value)} px-3 py-1 transition-colors`}
        data-value={item.value}
        aria-label={item.ariaLabel}
      >
        {item.label}
      </button>
    ))}
  </div>
</div>

<script define:vars={{ id }}>
  const root = document.documentElement;
  const sizeClasses = ['text-sm', 'text-base', 'text-lg', 'text-xl'];

  function applyFontSize(value) {
    root.classList.remove(...sizeClasses);
    if (value === 'small') root.classList.add('text-sm');
    else if (value === 'large') root.classList.add('text-xl');
    else root.classList.add('text-base');
    localStorage.setItem('fontSizePreference', value);
  }

  const stored = localStorage.getItem('fontSizePreference') || 'medium';
  applyFontSize(stored);

  const group = document.getElementById(id);
  group?.querySelectorAll('button[data-value]').forEach((button) => {
    if (button.getAttribute('data-value') === stored) {
      button.classList.add('bg-[var(--color-palette-three)]', 'text-[var(--color-palette-five)]');
    }
    button.addEventListener('click', () => {
      const value = button.getAttribute('data-value');
      applyFontSize(value);
      group.querySelectorAll('button[data-value]').forEach((btn) => {
        btn.classList.remove('bg-[var(--color-palette-three)]', 'text-[var(--color-palette-five)]');
      });
      button.classList.add('bg-[var(--color-palette-three)]', 'text-[var(--color-palette-five)]');
    });
  });
</script>
