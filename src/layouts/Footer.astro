---
import footer from '../../data/footer.json';
import FooterSection from './FooterSection.astro';
import NewsletterForm from './NewsletterForm.astro';
import SocialLinks from './SocialLinks.astro';
---

<footer class="mt-auto w-full border-t border-[var(--color-palette-two)] bg-[var(--color-palette-one)]">
  <div class="container mx-auto max-w-[2000px] px-4 py-8 md:px-8">
    <nav aria-label="Footer" class="flex flex-col justify-between gap-10 pt-2 lg:flex-row lg:gap-16">
      <NewsletterForm
        title={footer.newsletterSection.title}
        description={footer.newsletterSection.description}
        placeholder={footer.newsletterSection.placeholder}
        buttonText={footer.newsletterSection.buttonText}
      />
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {footer.sections.map((section) => (
          <FooterSection title={section.title} links={section.links} />
        ))}
      </div>
    </nav>
    <hr class="my-6 border-[var(--color-palette-four)]" />
    <div class="flex flex-col items-center gap-4 md:flex-row md:justify-between">
      <p class="text-center text-xs text-[var(--color-palette-gray)] md:text-left">{footer.copyright}</p>
      <SocialLinks
        links={footer.socialLinks.map((link) => ({
          label: link.ariaLabel,
          href: link.url,
          icon: link.platform.toLowerCase(),
        }))}
      />
    </div>
  </div>
</footer>
