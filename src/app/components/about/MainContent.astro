---
import { Image } from 'astro:assets';
import { aboutData } from '../../data/about';
import Markdown from '../Markdown.astro';
import corgi from '../../assets/images/corgi.jpg';

const { mainContent } = aboutData;
---

<section class="py-12">
  <Markdown content={mainContent} class="mb-8" />
  <figure>
    <Image 
      src={corgi} 
      alt="Corgi" 
      class="border-2 border-white rounded-lg"
      width={1200}
      height={800}
      format="webp"
      quality={80}
    />
    <figcaption class="mt-2 text-sm italic">
      Credit: photo by <a href="https://unsplash.com/@alvannee">Alvan Nee</a> on
      <a href="https://unsplash.com/photos/long-coated-white-and-brown-dog-lvFlpqEvuRM"> Unsplash </a>
    </figcaption>
  </figure>
</section>
