---
import { Image } from 'astro:assets';
import logoDark from '/assets/images/home-icon/logo-13232A-6DA3C0.png';

// Define props with optional className
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`flex items-center ${className}`}>
  <Image 
    src={logoDark} 
    alt="BluePrintNZ Logo" 
    width={150} 
    height={50} 
    class="logo-image" 
    format="webp"
    quality={90}
  />
</div>

<style>
  /* Ensure logo maintains its aspect ratio and doesn't compress */
  .logo-image {
    width: auto;
    min-width: 150px;
    height: auto;
    max-height: 50px;
    object-fit: contain;
  }
  
  /* Responsive adjustments to prevent overflow */
  @media (max-width: 480px) {
    .logo-image {
      min-width: 120px;
    }
  }
</style>
