---
interface Props {
  title: string;
  description: string;
  placeholder: string;
  buttonText: string;
}

const { title, description, placeholder, buttonText } = Astro.props;
---

<div class="flex flex-col md:max-lg:w-1/2 lg:max-w-sm">
  <p class="font-semibold text-base md:text-lg text-neutral">{title}</p>
  <p class="mb-5 pt-2 text-primary text-sm">
    {description}
  </p>
  <form
    action="#"
    method="post"
    class="flex flex-col sm:flex-row gap-3">
    <input 
      class="h-10 rounded-lg border border-primary bg-secondary px-4 py-2 text-neutral text-sm focus:outline-none focus:ring-[1px] focus:ring-primary flex-grow" 
      type="email"
      placeholder={placeholder}
      name="email"
      id="email"
      required>
    <button
      type="submit"
      class="h-10 px-5 border border-secondary/10 text-sm font-light bg-accent hover:bg-accent/80 text-neutral hover:cursor-pointer rounded-lg">
      {buttonText}
    </button>
  </form>
</div>
