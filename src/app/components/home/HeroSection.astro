---
import { Image } from 'astro:assets';
import { homeData } from '../../data/home';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Markdown from '../Markdown.astro';
import PixelRibbon from '../shared/PixelRibbon.astro';
import placeholderImage from '../../assets/images/placeholder-image.jpg';

const { hero } = homeData;
---

<section class="py-12">
  <Container>
    <!-- Desktop layout (md and up) -->
    <div class="hidden md:flex md:flex-row items-center gap-8 mb-10 w-full">
      <div class="w-full md:w-1/2">
        <div class="mb-6">
          <h1 class="mb-2 text-[var(--color-primary)]">{hero.title}</h1>
        </div>
        <Markdown content={hero.slogan} class="mb-8 text-lg" />
        <Button href={hero.ctaLink} size="lg" class="custom-button">{hero.ctaText}</Button>
      </div>
      <div class="w-full md:w-1/2 flex justify-center">
        <!-- Desktop Carousel -->
        <div class="carousel-container w-full relative">
          <div class="carousel-slides">
            {hero.carouselImages.map((image, index) => (
              <div class="carousel-slide" data-index={index}>
                <Image
                  src={placeholderImage}
                  alt={image.alt}
                  class="w-full max-w-full rounded-lg shadow-lg object-cover"
                  width={800}
                  height={600}
                  loading={index === 0 ? "eager" : "lazy"}
                  format="webp"
                  quality={80}
                />
              </div>
            ))}
          </div>
          
          <!-- Carousel Navigation -->
          <div class="carousel-nav flex justify-center mt-4">
            {hero.carouselImages.map((_, index) => (
              <button 
                class="carousel-dot w-3 h-3 mx-1 rounded-full bg-gray-300 hover:bg-gray-500 transition-colors" 
                data-index={index}
                aria-label={`Go to slide ${index + 1}`}
              ></button>
            ))}
          </div>
          
          <!-- Carousel Controls -->
          <button class="carousel-prev absolute top-1/2 left-2 transform -translate-y-1/2 bg-white bg-opacity-50 rounded-full p-2 hover:bg-opacity-75 transition-all z-10" aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button class="carousel-next absolute top-1/2 right-2 transform -translate-y-1/2 bg-white bg-opacity-50 rounded-full p-2 hover:bg-opacity-75 transition-all z-10" aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Mobile layout (sm and below) with text overlay -->
    <div class="md:hidden relative mb-10">
      <div class="carousel-container relative">
        <div class="carousel-slides">
          {hero.carouselImages.map((image, index) => (
            <div class="carousel-slide" data-index={index}>
              <div class="relative flex justify-center">
                <Image
                  src={placeholderImage}
                  alt={image.alt}
                  class="w-full rounded-lg shadow-lg object-cover"
                  width={800}
                  height={600}
                  loading={index === 0 ? "eager" : "lazy"}
                  format="webp"
                  quality={80}
                />
                <!-- Gradient overlay for better text visibility -->
                <div class="absolute inset-0 bg-gradient-to-t from-[rgba(0,15,46,0.8)] to-transparent rounded-lg"></div>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Mobile Carousel Navigation -->
        <div class="carousel-nav flex justify-center mt-2 absolute bottom-4 left-0 right-0 z-10">
          {hero.carouselImages.map((_, index) => (
            <button 
              class="carousel-dot w-2 h-2 mx-1 rounded-full bg-white bg-opacity-70 hover:bg-opacity-100 transition-colors" 
              data-index={index}
              aria-label={`Go to slide ${index + 1}`}
            ></button>
          ))}
        </div>
      </div>
      
      <!-- Text overlay positioned at the bottom of the image -->
      <div class="absolute bottom-0 left-0 right-0 p-6">
        <h1 class="mb-2 text-[var(--color-primary)]">{hero.title}</h1>
        <Markdown content={hero.slogan} class="mb-4 text-white text-opacity-90" />
        <Button href={hero.ctaLink} size="lg" class="custom-button">{hero.ctaText}</Button>
      </div>
    </div>
  </Container>
</section>

<script>
  // Carousel functionality
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.carousel-container');
    
    carousels.forEach(carousel => {
      const slides: NodeListOf<Element> = carousel.querySelectorAll('.carousel-slide');
      const dots: NodeListOf<Element> = carousel.querySelectorAll('.carousel-dot');
      const prevBtn: Element = carousel.querySelector('.carousel-prev');
      const nextBtn: Element = carousel.querySelector('.carousel-next');
      let currentIndex: number = 0;
      
      // Initialize the carousel
      function initCarousel() {
        slides.forEach((slide: Element, index: number) => {
          (slide as HTMLElement).style.display = index === currentIndex ? 'block' : 'none';
        });
        updateDots();
      }
      
      // Update the dots
      function updateDots() {
        dots.forEach((dot, index) => {
          dot.classList.toggle('bg-gray-300', index !== currentIndex);
          dot.classList.toggle('bg-gray-500', index === currentIndex);
          
          // For mobile dots with white background
          dot.classList.toggle('bg-white', index !== currentIndex && window.innerWidth < 768);
          dot.classList.toggle('bg-opacity-70', index !== currentIndex && window.innerWidth < 768);
          dot.classList.toggle('bg-opacity-100', index === currentIndex && window.innerWidth < 768);
        });
      }
      
      // Go to a specific slide
      function goToSlide(index:any) {
        // Check if slides exist and have the style property before manipulating
        if (slides.length > 0 && currentIndex >= 0 && currentIndex < slides.length) {
          const currentSlide = slides[currentIndex] as HTMLElement;
          if (currentSlide) {
            currentSlide.style.display = 'none';
          }
        }
        
        currentIndex = (index + slides.length) % slides.length;
        
        if (slides.length > 0 && currentIndex >= 0 && currentIndex < slides.length) {
          const newSlide = slides[currentIndex] as HTMLElement;
          if (newSlide) {
            newSlide.style.display = 'block';
          }
        }
        
        updateDots();
      }
      
      // Event listeners for dots
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => goToSlide(index));
      });
      
      // Event listeners for prev/next buttons
      if (prevBtn) {
        prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
      }
      
      if (nextBtn) {
        nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));
      }
      
      // Auto-advance the carousel
      let interval = setInterval(() => goToSlide(currentIndex + 1), 5000);
      
      // Pause auto-advance on hover
      carousel.addEventListener('mouseenter', () => clearInterval(interval));
      carousel.addEventListener('mouseleave', () => {
        clearInterval(interval);
        interval = setInterval(() => goToSlide(currentIndex + 1), 5000);
      });
      
      // Initialize
      initCarousel();
    });
  });
</script>

<style>
  /* Carousel styles */
  .carousel-container {
    overflow: hidden;
  }
  
  .carousel-slide {
    transition: opacity 0.5s ease;
  }
  
  .carousel-dot {
    transition: background-color 0.3s ease;
  }
  
  /* Additional styles for the mobile hero section */
  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
      line-height: 1.2;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    
    :global(.markdown-content p) {
      text-shadow: 0 1px 2px rgba(0,0,0,0.3);
      font-size: 1rem;
    }
  }
  
  /* Custom button styling */
  :global(.custom-button) {
    background-color: var(--color-primary-light) !important;
    color: var(--color-secondary) !important;
    font-weight: 600;
  }
  
  :global(.custom-button:hover) {
    background-color: var(--color-primary) !important;
  }
</style>
