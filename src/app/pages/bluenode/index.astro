---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';

const breadcrumbItems = [
  { label: 'BlueNode', href: '/bluenode', current: true }
];
---

<BaseLayout title="BlueNode - BluePrintNZ">
  <div class="container mx-auto px-4 py-8">
    <Breadcrumbs items={breadcrumbItems} />
    
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">BlueNode Platform</h1>
      
      <div class="bg-primary/10 p-6 rounded-lg mb-8">
        <h2 class="text-xl font-semibold mb-3 text-secondary">Powerful Health Data Management</h2>
        <p class="mb-4">
          BlueNode is our advanced platform for managing health data, providing insights, and connecting healthcare providers with patients.
          Built with security and privacy at its core, BlueNode helps streamline healthcare processes and improve outcomes.
        </p>
        <p>
          Discover how BlueNode can transform your healthcare experience with powerful tools and intuitive interfaces.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="border border-neutral-300 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-3 text-secondary">For Patients</h3>
          <ul class="space-y-2 list-disc pl-5">
            <li>Secure access to your health records</li>
            <li>Schedule appointments with healthcare providers</li>
            <li>Track health metrics and progress</li>
            <li>Receive personalized health insights</li>
            <li>Connect with support communities</li>
          </ul>
          <div class="mt-4">
            <Button href="#" variant="accent" size="md">Patient Portal</Button>
          </div>
        </div>
        
        <div class="border border-neutral-300 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-3 text-secondary">For Providers</h3>
          <ul class="space-y-2 list-disc pl-5">
            <li>Comprehensive patient management</li>
            <li>Secure data sharing and collaboration</li>
            <li>Advanced analytics and reporting</li>
            <li>Streamlined appointment scheduling</li>
            <li>Integration with existing systems</li>
          </ul>
          <div class="mt-4">
            <Button href="#" variant="accent" size="md">Provider Portal</Button>
          </div>
        </div>
      </div>
      
      <h2 class="text-2xl font-bold mb-4 text-secondary">Key Features</h2>
      
      <div class="space-y-6 mb-10">
        <div class="flex flex-col md:flex-row gap-4">
          <div class="md:w-1/3 bg-neutral-100 rounded-lg p-4 flex items-center justify-center">
            <span class="text-accent font-bold text-5xl">01</span>
          </div>
          <div class="md:w-2/3">
            <h3 class="text-lg font-semibold text-secondary mb-2">Secure Data Management</h3>
            <p>
              BlueNode employs state-of-the-art encryption and security protocols to ensure your health data remains private and secure.
              Our platform is compliant with all relevant healthcare data regulations and standards.
            </p>
          </div>
        </div>
        
        <div class="flex flex-col md:flex-row gap-4">
          <div class="md:w-1/3 bg-neutral-100 rounded-lg p-4 flex items-center justify-center">
            <span class="text-accent font-bold text-5xl">02</span>
          </div>
          <div class="md:w-2/3">
            <h3 class="text-lg font-semibold text-secondary mb-2">Seamless Integration</h3>
            <p>
              BlueNode integrates with existing healthcare systems and electronic health records, providing a unified platform for all your health data needs.
              Our API-first approach ensures compatibility with a wide range of healthcare technologies.
            </p>
          </div>
        </div>
        
        <div class="flex flex-col md:flex-row gap-4">
          <div class="md:w-1/3 bg-neutral-100 rounded-lg p-4 flex items-center justify-center">
            <span class="text-accent font-bold text-5xl">03</span>
          </div>
          <div class="md:w-2/3">
            <h3 class="text-lg font-semibold text-secondary mb-2">Advanced Analytics</h3>
            <p>
              Our platform provides powerful analytics tools that help identify trends, predict outcomes, and improve healthcare delivery.
              Customizable dashboards give you the insights you need to make informed decisions.
            </p>
          </div>
        </div>
      </div>
      
      <div class="bg-secondary text-neutral p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Ready to get started with BlueNode?</h3>
        <p class="mb-4">
          Join thousands of patients and healthcare providers who are already benefiting from our platform.
          Sign up today for a free demo or contact our team to learn more about how BlueNode can help you.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href="#" variant="primary" size="md">Request Demo</Button>
          <Button href="/contact" variant="outline" size="md">Contact Us</Button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
