---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { content } from '../../content/page-content.ts';

const {
  heading = content.stage0.heading1.title,
  title = `Stage ${content.stage0.heading1.stageNum} - ${heading} | BluePrintNZ`,
  description = content.stage0.heading1.description,
  // link = content.stage0.heading1.description,
  breadcrumb = content.stage0.heading1.breadcrumbs,
} = Astro.props

const breadcrumbItems = [
  { label: heading , link: breadcrumb.link, current: breadcrumb.current }
];
---
<Layout title=`${title}`>
  <div class="container mx-auto px-4 pt-10 pb-25">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">{heading}</h1>
      <br><hr><br>
    <p>{description}</p>
     <p style="font-style: italic;"></p>
  </div>
  </div>
  <script>
  </script>
</Layout>