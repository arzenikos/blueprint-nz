---
import { siteData } from '../data/site';
import { aboutData } from '../data/about';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ContextAlert from '../components/common/ContextAlert.astro';
import MainContent from '../components/about/MainContent.astro';
import ImageComparison from '../components/about/ImageComparison.astro';

// Get page-specific content
const { title, description, imageComparison } = aboutData;

// Get context warning
const devModeWarning = imageComparison.devModeWarning;
---

<BaseLayout title={title} description={description}>
  <Container>
    <div class="flex flex-col gap-12 sm:gap-16">
      <section>
        <ContextAlert
          addedChecksFunction={(ctx) => {
            return ctx === 'dev' ? devModeWarning : null;
          }}
          class="mb-8"
        />
        <h1>{title}</h1>
      </section>
      
      <MainContent />
      
      <ImageComparison />
    </div>
  </Container>
</BaseLayout>
