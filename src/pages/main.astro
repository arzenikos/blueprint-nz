---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { content } from '../content/page-content.ts';

// get the dynamic route param
const { slug } = Astro.params;

// resolve the content based on slug
const sectionData = content.stage0?.[slug];

if (!sectionData) {
  throw new Error(`No content found for slug "${slug}"`);
}

const {
  title: heading,
  stageNum,
  description,
  body,
  breadcrumbs: breadcrumb,
} = sectionData;

const pageTitle = `Stage ${stageNum} - ${heading} | BluePrintNZ`;

const breadcrumbItems = [
  { label: heading, link: breadcrumb.link, current: breadcrumb.current }
];
---

<Layout title={pageTitle}>
  <div class="container mx-auto px-4 pt-10 pb-25">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">{heading}</h1>

      <ul>
        {Array.isArray(description) && description.map((p, i) => (
          <li class="mb-4">{p}</li>
        ))}
      </ul>

      <hr class="my-4 border-t border-gray-300" />

      {body && <p class="italic">{body}</p>}
    </div>
  </div>
</Layout>
