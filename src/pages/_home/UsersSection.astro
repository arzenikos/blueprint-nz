---
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
// import { userContent } from '../../content/home-user-tab';

const {
  id,
  content,
  config
} = Astro.props

const {
  sectionTitle = content.title,
  description = content.description,
  patients = content.users,
  others = content.other,
} = content

const {
  margin=config.user.margin,
  padding=config.user.padding,
  scale=config.user.scale,
  other=config.user.other
} = config
---

<section 
class=`${margin} ${padding} ${other} ${scale} mb-25` style="background-color: var(--color-palette-three);">
  <div class="text-center px-6 md:px-4 md:py-10 lg:px-60 lg:py-5">
      <h2 class="font-bold mb-4" style="color: var(--color-palette-five);">{sectionTitle}</h2>
      <p class="text-center mb-6" style="color: var(--color-palette-five);">
      {description}
      </p>
  </div>
  <div class="container flex items-center justify-center w-full scale-70 md:scale-120">
    <!-- Number Buttons with Horizontal Line -->
  
    <div class="relative ">
      <!-- Connecting Line -->
      <!-- <div class="absolute top-1/2 left-0 w-full h-0.5-z-10 translate-y-1/2"></div> -->
  
      <!-- Fixed-size Button Containers -->
       <div class="flex relative" id={id}>
         {patients.map(({ label, icon, type }) => (
         <div class="relative group w-10 h-10 hover:scale-110 hover:mx-3 flex items-center justify-center">
          <Button >
            <button
              id={label}
              type="button"
              data-label={label}
              class="user-btn w-full h-full flex p-5 items-center justify-center rounded-full md: text-xl text-s transition-all duration-200 hover:scale-110 " style="background: var(--color-palette-four); color: var(--color-palette-one);"
            >
              {icon}
              </button>
          </Button>
            {/* <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm  rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
              {type}
            </div> */}
          </div>
          <div class="flex items-center justify-center">
            <div class="h-0.5 w-4 md:w-10"  style="background-color: var(--color-palette-five);"></div>
          </div>
          ))}
      </div>
    </div>
  
    <!-- Icon Buttons with Tooltip -->
    <div class="flex relative py-5">
      {others.map(({ label, icon }) => (
        <div class="flex items-center justify-center">
          <div class="h-0.5 w-4 md:w-10" style="background-color: var(--color-palette-five);"></div>
        </div>
        <div class="relative group w-10 h-10 flex items-center justify-center hover:scale-110 hover:mx-3">
          <button
            type="button"
            data-label={label}
            class="user-btn w-full h-full flex items-center justify-center rounded-full text-xl transition-all duration-200" style="background: var(--color-palette-four);"
          >
            <Icon name={icon} class="hover:text-white" color="var(--color-palette-one)"/>
          </button>
        </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { resourceContent } from '../../content/home'
  const { contentByCategory } = resourceContent;

  document.addEventListener('DOMContentLoaded', () => {
    const userButtonTabs = document.querySelectorAll('.user-btn[data-label]');
    const cardSection = document.getElementById('card-section');

    userButtonTabs.forEach(button => {
      button.addEventListener('click', () => {
        const labelText = button.getAttribute('data-label');
       // Responsive offset scroll
      if (cardSection) {
        let yOffset;
        if (window.innerWidth < 640) {
          // Small screens (e.g., mobile)
          yOffset = -140;
        } else if (window.innerWidth < 1024) {
          // Medium screens (e.g., tablets)
          yOffset = -270;
        } else {
          // Large screens (e.g., desktops)
          yOffset = -320;
        }
        const y = cardSection.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
        const cardMainTitle = document.getElementById('card-title');
        const cardElement = document.querySelectorAll('.card');
        const cardHeadingElement = document.querySelectorAll('.card-heading');
        const cardContentElement = document.querySelectorAll('.card-content');
        const cardLinkElement = document.querySelectorAll('.card-link');
        const cardIconElement = document.querySelectorAll('.card-icon');
        cardMainTitle.textContent = `${contentByCategory[labelText].title}`;
        cardHeadingElement.forEach((heading, i)=> {
          heading.textContent = `${contentByCategory[labelText].data[i].heading}`;
        });
        cardContentElement.forEach((content, i)=> {
          content.textContent = `${contentByCategory[labelText].data[i].content}`;
        });
        cardElement.forEach((link, i)=> {
          link.setAttribute('href', `stage-${labelText}/${contentByCategory[labelText].data[i].heading}`);
        });
      });
    });
  });
</script>