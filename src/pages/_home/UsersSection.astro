---
import Icon from '../../components/ui/Icon.astro';
import Button from '../../components/ui/Button.astro';
// import { userContent } from '../../content/home-user-tab';

const {
  id,
  content,
  config
} = Astro.props

const {
  sectionTitle = content.title,
  description = content.description,
  patients = content.users,
  others = content.other,
} = content

const {
  margin=config.user.margin,
  padding=config.user.padding,
  scale=config.user.scale,
  other=config.user.other
} = config
---

<section 
class=`${margin} ${padding} ${other} ${scale} mb-25` style="background-color: var(--color-palette-three);">
  <div class="text-center px-6 md:px-4 md:py-10 lg:px-60 lg:py-5">
      <h2 class="font-bold mb-4" style="color: var(--color-palette-five);">{sectionTitle}</h2>
      <p class="text-center mb-6" style="color: var(--color-palette-five);">
      {description}
      </p>
  </div>
  <div class="container flex items-center justify-center w-full scale-70 md:scale-120">
    <!-- Number Buttons with Horizontal Line -->
  
      <!-- Fixed-size Button Containers -->
       <div class="flex relative" id={id}>
         {patients.map(({ label, icon }) => (
         <div class="relative group w-15 h-15 hover:scale-110 hover:mx-3 flex items-center justify-center">
          <button
            id={label}
            type="button"
            data-active="false"
            data-label={label}
            class="user-btn w-full h-full flex p-5 items-center justify-center rounded-2xl md: text-xl text-s transition-all duration-200 hover:scale-110 "
            style="background: var(--color-palette-two); color: var(--color-palette-five);"
          >
            {icon}
            </button>
            <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm  rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
              Stage {icon.charAt(0).toUpperCase() + icon.slice(1)}
            </div>
          </div>
          <div class="flex items-center justify-center">
            <div class="h-0.5 w-4 md:w-10"  style="background-color: var(--color-palette-five);"></div>
          </div>
          ))}
      </div>
  
    <!-- Icon Buttons with Tooltip -->
    <div class="flex relative py-5">
      {others.map(({ label, icon }) => (
        <div class="flex items-center justify-center">
          <div class="h-0.5 w-4 md:w-10" style="background-color: var(--color-palette-four);"></div>
        </div>
        <div class="relative group w-15 h-15 flex items-center justify-center hover:scale-110 hover:mx-3">
          <button
            id={`btn-${label}`}
            type="button"
            data-active="false"
            data-label={label}
            style="background-color: var(--color-palette-two);"
            class="user-btn w-full h-full flex items-center justify-center rounded-xl text-xl transition-all duration-200" style="background: var(--color-palette-four);"
          >
            <Icon name={icon} class="hover:text-white" color="var(--color-palette-five)"/>
          </button>
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm  rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
          {icon.charAt(0).toUpperCase() + icon.slice(1)}
          </div>
        </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { resourceContent } from '../../content/home'
  const { contentByCategory } = resourceContent;

  document.addEventListener('DOMContentLoaded', () => {
    const userButtonTabs = document.querySelectorAll('.user-btn[data-label]');
    const cardSection = document.getElementById('card-section');

    /* SCROLLING  */
    userButtonTabs.forEach(button => {
      button.addEventListener('click', () => {
       // Responsive offset scroll
      if (cardSection) {
        cardSection.classList.remove("hidden");
        let yOffset;
        if (window.innerWidth < 640) {
          // Small screens (e.g., mobile)
          yOffset = -140;
        } else if (window.innerWidth < 1024) {
          // Medium screens (e.g., tablets)
          yOffset = -260;
        } else {
          // Large screens (e.g., desktops)
          yOffset = -470;
        }

        const y = cardSection.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }

      // Remove active from all buttons
      userButtonTabs.forEach(btn => btn.removeAttribute('data-active'));
      // Add active to clicked button
      button.setAttribute('data-active', 'true');

    /* CARD DYNAMIC  */
      // stage-0
      const labelText = button.getAttribute('data-label');
      localStorage.setItem('current', labelText)
      const currentSet = contentByCategory[labelText];
      // Stage X - Lorem Ipsum
      const cardMainTitle = document.getElementById('card-title');
      cardMainTitle.textContent = `${currentSet.title}`;

      // (Stage 0 Heading 1) What You Need to Know Early
      const linkSet = [];
      const cardHeadingElement = document.querySelectorAll('.card-heading');
      cardHeadingElement.forEach((heading, i)=> {
        heading.textContent = `${currentSet.data[i].heading}`;
        const cleanSlug = heading.textContent
            .toLowerCase()
            .trim()
            .replace(/\s+/g, '-')      // Replace spaces with -
            .replace(/[^\w-]/g, '');   // Remove punctuation

        linkSet.push(`${cleanSlug}`);
      });
      console.log(...linkSet);

      // Details
      const cardContentElement = document.querySelectorAll('.card-content');
      cardContentElement.forEach((content, i)=> {
        const x =  `${currentSet.data[i].content}`;
        content.textContent = x;
      });
      
      const cardLinkElement = document.querySelectorAll('.card-item');
      cardLinkElement.forEach((link, i)=> {
        
        const current = localStorage.getItem('current');
        link.setAttribute('href', `${current}/${linkSet[i-1]}`);
      });
      });
    });
  });
</script>