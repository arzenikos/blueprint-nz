---
import Icon from '../../components/ui/Icon.astro';
import { userContent } from '../../content/home-user-tab';

const {
  label,
  id,
  patients = userContent.patient,
  others = userContent.other
} = Astro.props
---

<div class="container flex items-center justify-center w-full">
  <!-- Left Label -->
   <p id="output">Selected: None</p>

  <!-- Number Buttons with Horizontal Line -->
  <div class="relative ">
    <!-- Connecting Line -->
    <div class="absolute top-1/2 left-0 w-full h-0.5-z-10 translate-y-1/2"></div>

    <!-- Fixed-size Button Containers -->
     <div class="flex relative" id="user-type-selector">
       {patients.map(({ label, icon, stage }) => (
       <div class="relative group w-10 h-10 hover:scale-110 hover:mx-3 flex items-center justify-center">
          <button
            type="button"
            data-user={stage}
            class="user-btn w-full h-full flex p-5 items-center justify-center rounded-full md: text-xl text-s transition-all duration-200 hover:scale-110 " style="background: var(--color-palette-four); color: var(--color-palette-one);"
          >{icon}</button>
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm  rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
            {label}
          </div>
        </div>
        <div class="flex items-center justify-center">
          <div class="h-0.5 w-4 md:w-10"  style="background-color: var(--color-palette-five);"></div>
        </div>
        ))}
    </div>
  </div>

  <!-- Icon Buttons with Tooltip -->
  <div class="flex relative py-5">
    {others.map(({ label, icon }) => (
      <div class="flex items-center justify-center">
        <div class="h-0.5 w-4 md:w-10" style="background-color: var(--color-palette-five);"></div>
      </div>
      <div class="relative group w-10 h-10 flex items-center justify-center hover:scale-110 hover:mx-3">
        <button
          type="button"
          data-user={label}
          class="user-btn w-full h-full flex items-center justify-center rounded-full text-xl transition-all duration-200" style="background: var(--color-palette-four);"
        >
          {/* {icon} */}
          <Icon name={icon} class="hover:text-white" color="var(--color-palette-one)"/>
        </button>
        <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
          {label}
        </div>
      </div>
      ))
    }
  </div>
</div>


<script define:vars={{ patients, others }}>
  // Add event listeners for dropdowns and button groups
  document.addEventListener('DOMContentLoaded', () => {
    const output = document.getElementById('output');
    const btnGroup = selector.querySelectorAll('#button-group button');
    // const selector = document.getElementById('user-type-selector');

    const storedUser = localStorage.getItem('currentUser') || 'patient0';

    btnGroup.forEach(button => {
      // const userType = button.data-user.value;
      // if(userType === storedUser) {
      //   button.classList.add('bg-accent', 'text-blue-100')
      // } else {
      //   button.classList.remove('bg-accent', 'text-blue-100')
      // }
      button.addEventListener('click', () => {
        const label = button.getAttribute('data-label');
        output.textContent = `Selected ${label}`;
        // const selectedType = btn.data-user.value;
        // localStorage.setItem('currentUser', selectedType);

        // btnGroup.forEach(b => b.classList.remove('ring', 'ring-offset-2', 'ring-accent'))
        // btn.classList.add('ring', 'ring-offset-2', 'ring-accent');
        // console.log(`Current user: ${selectedType}`)
        // location.reload();
      })
    })

  })
</script>
