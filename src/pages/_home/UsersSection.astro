---
const numbers = [0, 1, 2, 3, 4];
const icons = [
  { label: 'Caregiver', icon: '🧑‍⚕️' },
  { label: 'Researcher', icon: '🔬' },
];
---

<div class="flex items-center gap-4">
  <!-- Left Label -->
  <div class="text-lg font-semibold text-gray-800 min-w-[80px]">Patient</div>

  <!-- Number Buttons with Horizontal Line -->
  <div class="relative">
    <!-- Connecting Line -->
    <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gray-300 -z-10 translate-y-1/2"></div>

    <!-- Fixed-size Button Containers -->
    <div class="flex gap-2">
      {numbers.map((num) => (
        <div class="w-10 h-10 flex items-center justify-center">
          <button
            type="button"
            class="w-full h-full flex items-center justify-center rounded-full bg-gray-200 text-gray-700 transition-all duration-200 transform hover:scale-110 hover:bg-blue-500 hover:text-white"
          >
            {num}
          </button>
        </div>
      ))}
    </div>
  </div>

  <!-- Separator -->
  <div class="h-6 w-px bg-gray-300 mx-3"></div>

  <!-- Icon Buttons with Tooltip -->
  <div class="flex gap-4 relative">
    {icons.map(({ label, icon }) => (
      <div class="relative group w-10 h-10 flex items-center justify-center">
        <button
          type="button"
          class="w-full h-full flex items-center justify-center rounded-full bg-gray-200 text-xl transition-all duration-200 hover:scale-110 hover:bg-blue-500 hover:text-white"
        >
          {icon}
        </button>
        <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 text-sm text-white bg-gray-800 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
          {label}
        </div>
      </div>
    ))}
  </div>
</div>
