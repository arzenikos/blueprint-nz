---
import Card from '../../components/ui/Card.astro';
import { resourceCardConfig } from '../../lib/types/CardLibrary'

const {
  content,
  config
} = Astro.props;

// export const prerender = false;

const {
  sectionTitle,
  sectionSubtitle,
  contentByCategory
} = content;

let selectedCategory = 'stage-0';
let selectedCards = contentByCategory[selectedCategory].data;
  
const {
  margin=config.cards.margin,
  padding=config.cards.padding,
  scale=config.cards.scale,
  other=config.cards.other,
} = config;

const {
  icon = resourceCardConfig.icon,
  textClass = resourceCardConfig.textClass,
  color = resourceCardConfig.color,
  extraConfig=resourceCardConfig.extraConfig,
} = resourceCardConfig;
---
<section id="card-section" class=`${margin} ${padding} ${other} ${scale}`>
  <h2 id="card-title" class="text-3xl md:text-4xl font-bold text-center mb-1">{sectionTitle}</h2>
  <h4 class="text-center mb-12">{sectionSubtitle}</h4>
  
  <div id="card-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full h-160">
  {selectedCards.map(({heading, content}, index) => (
    <Card
      heading={heading}
      content={content}
      icon={icon}
      textClass={textClass}
      color={color}
      config={extraConfig}
      index={index}
      />
    ))}
  </div>
</section>