---
import { resourceContent } from '../../content/home-resource'
import Card from '../../components/ui/Card.astro';

const { sectionTitle, sectionSubtitle, contentByCategory, ctaButton } = resourceContent;
let selectedCategory = 'patient0';
let selectedCards = contentByCategory[selectedCategory].data;
---
<section id="card-section" class="container px-6 mt-10 md:mt-30" >
  <h2 id="card-title" class="text-3xl md:text-4xl font-bold text-center mb-1">{sectionTitle}</h2>
  <h4 class="text-center mb-12">{sectionSubtitle}</h4>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full h-160">
  {selectedCards.map(({ heading, content, cardLink }) => (
    <Card ctaButton={ctaButton} heading={heading} content={content} cardLink />
    ))}
  </div>
</section>

  <!-- <section>
    <Main label="Home" href="/stage0" icon="home" />
  </section> -->