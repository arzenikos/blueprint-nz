---
import Icon from '../../components/ui/Icon.astro';
const {
  sectionTitle = 'Prostate Cancer Resource Hub',
  sectionCards = [
    {
      heading: 'Heading 1',
      content: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
      cardLink: '/#'
    },
    {
      heading: 'Heading 2',
      content: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
      cardLink: '/#'
    },
        {
      heading: 'Heading3',
      content: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
      cardLink: '/#'
    },
  ],
} = Astro.props
---
<div class="container mx-auto px-6" >
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{sectionTitle}</h2>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full h-160">
  {sectionCards.map(({ heading, content, cardLink }) => (
    <div class="rounded-lg shadow-md p-6 transition-transform hover:scale-105" style="background: var(--color-palette-four);">
      <div class=" p-3 rounded-full w-15 h-15 flex items-center justify-center mb-4" style="background: var(--color-palette-one);">
        <Icon name="code" color="var(--color-palette-five)"/>
      </div>
      <h3 class="text-xl font-semibold mb-3" style="color: var(--color-palette-one);">{heading}</h3>
      <p style="color: var(--color-palette-two);">
        {content}
      </p>
    </div>
    ))}
  </div>
</div>