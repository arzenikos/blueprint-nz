---
import Card from '../../components/ui/Card.astro';

const {
  content,
  config
} = Astro.props;

const {
  sectionTitle,
  sectionSubtitle,
  contentByCategory,
  cardLink,
  ctaButton,
} = content;

  
const {
  margin=config.cards.margin,
  padding=config.cards.padding,
  scale=config.cards.scale,
  other=config.cards.other} = config;


let selectedCategory = 'stage-0';
let selectedCards = contentByCategory[selectedCategory].data;
---
<section id="card-section" class=`${margin} ${padding} ${other} ${scale}`>
  <h2 id="card-title" class="text-3xl md:text-4xl font-bold text-center mb-1">{sectionTitle}</h2>
  <h4 class="text-center mb-12">{sectionSubtitle}</h4>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full h-160">
  {selectedCards.map(({ heading, content }, i) => (
    <Card
      class="card"
      ctaButton={ctaButton}
      heading={heading}
      content={content}
      // cardLink={i}
      // href={`${i}/${heading.toLowerCase().replaceAll(' ','-').replaceAll('?', '').replaceAll(',', '')}`}
      // href={`s/${heading.toLowerCase().replaceAll(' ','-').replaceAll('?', '').replaceAll(',', '')}`}
      // href={`${i}/${heading.toLowerCase().replaceAll(' ','-').replaceAll('?', '').replaceAll(',', '')}`}
      // icon={contentByCategory[selectedCategory].data[i]?.icon}
    />
  ))}
  </div>
</section>