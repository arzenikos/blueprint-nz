---
import Button from '../../components/ui/Button.astro';
const {
    bodyPanWidth = 'px-15 ',
    sectionTitle = 'About BluePrintNZ',
    ctaLink = '/about',
    ctaText = 'Learn More About Us',
    sectionBody = {
        paragraph1: "BluePrintNZ is a platform designed to showcase modern web development techniques and best practices using Astro and Netlify.",
        paragraph2: "Our mission is to provide a blueprint for building fast, accessible, and modern websites that leverage the power of Astro's multi-page application architecture and Netlify's deployment platform."
    }
} = Astro.props
---
<section class=`container mt-30 mx-auto ${bodyPanWidth} text-center scroll-mt-28`>
    <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/2">
            <img 
            src="/src/assets/placeholder-image-1.jpg" 
            alt="About BluePrintNZ" 
            class="rounded-lg shadow-lg w-full h-auto"
            />
        </div>
        <div class="md:w-1/2">
            <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--color-palette-five);">{sectionTitle}</h2>
            <p class="text-lg  mb-6" style="color: var(--color-palette-five);">
            {sectionBody.paragraph1}
            </p>
            <p class="text-lg  mb-6" style="color: var(--color-palette-five);">
            {sectionBody.paragraph2}
            </p>
            <Button class="text-center md:text-start" variant="primary" href={ctaLink}>
            {ctaText}
            </Button>
        </div>
    </div>
</section>