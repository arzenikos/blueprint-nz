---
import Button from '../../components/ui/Button.astro';
import { overviewContent } from '../../content/home-overview'


const {
    sectionTitle = overviewContent.title,
    ctaLink = overviewContent.link,
    ctaText = overviewContent.mainButton,
    mediaSource1 = overviewContent.mediaSource,
    sectionBody = {
    paragraph1 : overviewContent.paragraph1,
    paragraph2 : overviewContent.paragraph2
    },
} = Astro.props
---
<section class=`container my-70 px-6 md:px-3 text-center scroll-mt-28`>
    <div class="flex flex-col lg:flex-row items-center gap-10">
        <div class="md:w-2/5 flex">
            <iframe class=justify-center" src={mediaSource1} width="500" height="281" allowfullscreen></iframe>
            <!-- <img 
            src="/src/assets/placeholder-image-1.jpg" 
            alt="About BluePrintNZ" 
            class="rounded-lg shadow-lg w-full h-auto"
            /> -->
        </div>
        <div class="md:w-3/5 justify-center md:justify-start">
            <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--color-palette-five);">{sectionTitle}</h2>
            <p class="text-center md:text-start text-lg  mb-6" style="color: var(--color-palette-five);">
            {sectionBody.paragraph1}
            </p>
            <p class="text-lg mb-6" style="color: var(--color-palette-five);">
            {sectionBody.paragraph2}
            </p>
            <Button variant="primary" href={ctaLink}>
            {ctaText}
            </Button>
        </div>
    </div>
</section>