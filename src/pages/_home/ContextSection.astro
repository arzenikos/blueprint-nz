---
import Button from '../../components/ui/Button.astro';

const { 
  content,
  config,
} = Astro.props;

const {
  margin=config.context.margin,
  padding=config.context.padding,
  scale=config.context.scale,
  other=config.context.other
} = config

const {
    sectionTitle = content.title,
    ctaLink = content.link,
    ctaText = content.mainButton,
    mediaSource1 = content.mediaSource,
    sectionBody = {
        paragraph1 : content.paragraph1,
        paragraph2 : content.paragraph2
    },
} = content

const {

} = Astro.props
---
<section class=`${margin} ${padding} ${other} ${scale} relative z-70`>
    <div class="flex flex-col lg:flex-row items-center gap-0 md:gap-10">
        <div class="md:w-2/5 flex">
            <!-- <iframe class=justify-center" src={mediaSource1} width="500" height="281" allowfullscreen></iframe> -->
            <img 
            src="/src/assets/placeholder-image-1.jpg" 
            alt="About BluePrintNZ" 
            class="rounded-lg shadow-lg w-full h-auto"
            />
        </div>
        <div class="md:w-3/5 justify-center md:justify-start">
            <h2 class="text-3xl md:text-4xl font-bold mb-6" >{sectionTitle}</h2>
            <p class="text-center md:text-start text-lg  mb-6">
            {sectionBody.paragraph1}
            </p>
            <p class="text-lg mb-6">
            {sectionBody.paragraph2}
            </p>
            <Button variant="secondary" href={ctaLink}>
                {ctaText}
            </Button>
        </div>
    </div>
</section>

<style>
    h2, p {
        color: var(--color-palette-five);
    }
</style>