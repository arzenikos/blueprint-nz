---

// import Button from '../../components/ui/Button.astro';
import HeroSection from './HeroSection.astro';
import UsersSection from './UsersSection.astro';
import ResourceSection from './ResourceSection.astro';
import ContextSection from './ContextSection.astro';
import GetStartedSection from './GetStartedSection.astro';

import { homeData } from '../../content/home.ts';
// const heroImages = [
//   { src: "/src/assets/images/placeholder-image-1.jpg", alt: "BluePrintNZ Hero Image 1" },
//   { src: "/src/assets/images/placeholder-image-2.jpg", alt: "BluePrintNZ Hero Image 2" },
//   { src: "/src/assets/images/placeholder-image-3.jpg", alt: "BluePrintNZ Hero Image 3" }
// ];

const {
  title = homeData.hero.title,
  description = homeData.hero.description,
  exploreButton = homeData.hero.exploreButton,
  exploreLink = homeData.hero.exploreLink,
} = Astro.props;
---
<div>
  <HeroSection
    title={title}
    description={description},
    exploreButton={exploreButton},
    exploreLink={exploreLink},
    useCarousel={true}
  />
  <section class=" w-full" style="background: none">
    <UsersSection/>
  </section>

  <section class="py-16" style="background: none">
    <ResourceSection/>
  </section>

  <section class="py-16" style="background: none">
    <ContextSection/>
  </section>

  <section class="py-16 " style="background: none">
    <GetStartedSection/>
  </section>
</div>