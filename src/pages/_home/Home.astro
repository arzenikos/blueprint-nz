---
<div>
  <HeroSection
    title="Modern Web Solutions for New Zealand"
    description="Building fast, accessible, and modern websites that leverage the power of Astro's multi-page application architecture."
    primaryButton={{
      text: "Explore Bluenode",
      href: "/bluenode"
    }}
    useCarousel={true}
  />
  <section class=" w-full" style="background: none">
    <UsersSection/>
  </section>

  <section class="py-16" style="background: none">
    <ResourceSection/>
  </section>

  <section class="py-16" style="background: none">
    <ContextSection/>
  </section>

  <section class="py-16 " style="background: none">
    <GetStartedSection/>
  </section>
</div>