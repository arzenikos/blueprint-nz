---

// import Button from '../../components/ui/Button.astro';
import HeroSection from './HeroSection.astro';
import UsersSection from './UsersSection.astro';
import ResourceSection from './ResourceSection.astro';
import ContextSection from './ContextSection.astro';
import GetStartedSection from './GetStartedSection.astro';


// const heroImages = [
//   { src: "/src/assets/images/placeholder-image-1.jpg", alt: "BluePrintNZ Hero Image 1" },
//   { src: "/src/assets/images/placeholder-image-2.jpg", alt: "BluePrintNZ Hero Image 2" },
