---
import Button from '../../components/ui/Button.astro';
const {} = Astro.props
---
<div class="container mx-auto px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-6" style="color: var(--color-palette-five);">Ready to Get Started?</h2>
    <p class="text-lgmb-8 max-w-2xl mx-auto" style="color: var(--color-palette-five);">
    Contact us today to discuss your project and how we can help you build a modern, fast, and accessible website.
    </p>
    <br>
    <Button variant="primary" size="lg" href="/contact">
    Contact Us
    </Button>
</div>