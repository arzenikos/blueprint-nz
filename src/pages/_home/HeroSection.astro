---
import Button from '../../components/ui/Button.astro';
import Carousel from '../../components/ui/Carousel.astro';

const { 
  content,
  config,
  reversed,
} = Astro.props;

const {
  carouselImages,
  title,
  description,
} = content

const {
  margin=config.hero.margin,
  padding=config.hero.padding,
  scale=config.hero.scale,
  other=config.hero.other
} = config
---

<section class=`${margin} ${padding} ${other} ${scale}` style="background: none">
  <div class={`flex flex-col ${reversed ? 'md:flex-row-reverse' : 'md:flex-row'} items-center justify-between gap-4 h-1/5`}>
    <!-- LEFT CAROUSEL -->
    <div class="flex flex-col w-full md:w-4/9">
      <Carousel images={carouselImages} />
    </div>

    <!-- RIGHT: HERO TITLE -->
    <div class="w-full md:w-5/9 text-center px-5 md:px-0 md:text-start scale-80 md:scale-75 lg:scale-75">
      <h1 class="text-3xl md:text-6xl lg:text-6xl font-bold mb-6">
        {title}
      </h1>
      <p class="text-lg md:text-xl mb-8" style="color: var(--color-palette-four);">
        {description}
      </p>
      <div class="flex flex-wrap gap-4 justify-center md:justify-start">
        <Button variant="primary" size="lg" href={content.exploreLink}>
          {content.exploreButton}
        </Button>
      </div>
    </div>
  </div>
</section>