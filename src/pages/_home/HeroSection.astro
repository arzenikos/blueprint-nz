---
import Button from '../../components/ui/Button.astro';
import Carousel from '../../components/ui/Carousel.astro';

import { heroContent } from '../../content/home-hero.ts';

const { 
  title = heroContent.title,
  description = heroContent.description,
  exploreButton = heroContent.exploreButton,
  exploreLink = heroContent.exploreLink,
  carouselImages = heroContent.carouselImages,
  reversed = false 
} = Astro.props;
---

<section class="my-15 md:my-10 theme-transition" style="background: none">
  <div class="container mx-auto px-6">
    <div class={`flex flex-col ${reversed ? 'md:flex-row-reverse' : 'md:flex-row'} items-center justify-between gap-12 h-1/5`}>
      <div class="w-6/7 md:w-2/3">
        <Carousel images={carouselImages} />
      </div>
      <div class="md:w-1/2 text-center md:text-start">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          {title}
        </h1>
        <p class="text-lg md:text-xl mb-8" style="color: var(--color-palette-four);">
          {description}
        </p>
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          <Button variant="primary" size="lg" href={exploreLink}>
            {exploreButton}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>