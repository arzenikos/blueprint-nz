---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/button/Button.astro';
import Icon from '../../components/ui/icon/Icon.astro';
import CTASection from '../../components/ui/CTASection.astro';
import { servicesContent } from '../../content/services';
import { siteData } from '../../content/site';

// Get the service ID from the URL
export async function getStaticPaths() {
  return servicesContent.servicesList.map(service => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const title = `${service.title} - ${siteData.site.title}`;
---

<Layout title={title}>
  <section class="bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-800 py-16 md:py-24 theme-transition">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="md:w-1/2">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            {service.title}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-8">
            {service.longDescription}
          </p>
          <Button variant="primary" size="lg" href="/contact">
            Get a Quote
          </Button>
        </div>
        <div class="md:w-1/2">
          <img 
            src={service.image} 
            alt={service.title} 
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-gray-900 theme-transition">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl font-bold mb-8">What We Offer</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {service.features.map(feature => (
          <div class="flex items-start">
            <div class="bg-blue-100 dark:bg-blue-900 p-2 rounded-full mr-4 theme-transition">
              <Icon name="check" class="w-5 h-5 text-blue-600 dark:text-blue-400" />
            </div>
            <p class="text-gray-700 dark:text-gray-300">{feature}</p>
          </div>
        ))}
      </div>
      
      <div class="mt-8">
        <Button variant="outline" href="/services">
          <Icon name="arrow-left" class="mr-2 w-4 h-4" /> Back to All Services
        </Button>
      </div>
    </div>
  </section>

  <CTASection 
    title={servicesContent.cta.title}
    description={servicesContent.cta.description}
    buttonText={servicesContent.cta.buttonText}
    buttonHref={servicesContent.cta.buttonHref}
    bgClass="bg-blue-50 dark:bg-gray-800"
  />
</Layout>
