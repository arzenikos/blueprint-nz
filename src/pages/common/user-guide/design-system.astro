---
import Layout from '../../../layouts/Layout.astro';
import MainPageHeading from '../../../components/layout/MainPageHeading.astro';
---

<Layout title="Design system | BluePrintNZ">
  <div class="container mx-auto px-4 pb-20 pt-10">
    <MainPageHeading
      heading="Design system"
      description="Colour tokens used across BluePrintNZ. Edit them in src/styles/themes.css."
      breadcrumbItems={[
        { label: 'Home', href: '/', current: false },
        { label: 'Design system', href: '/footer/user-guide/design-system', current: true },
      ]}
    />
    <section class="grid grid-cols-2 gap-4 md:grid-cols-5">
      {['zero', 'one', 'two', 'three', 'four', 'five'].map((step) => (
        <div class="overflow-hidden rounded-lg border border-[var(--color-palette-two)]">
          <div class="h-24" style={`background: var(--color-palette-${step})`}></div>
          <p class="p-3 text-sm">palette-{step}</p>
        </div>
      ))}
    </section>
  </div>
</Layout>
