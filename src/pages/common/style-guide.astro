---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Style Guide | Pamana" hub="patient">
  <section class="guide">
    <h1>Pamana style guide</h1>
    <p>Global tokens used across the Figma-aligned interface. Component styles live with their components.</p>
    <div class="swatches">
      <div style="background: var(--color-bg)"><span>Background</span></div>
      <div style="background: var(--color-navy); color: #fff"><span>Navy</span></div>
      <div style="background: var(--color-card)"><span>Card</span></div>
      <div style="background: var(--color-overlay); color: #fff"><span>Overlay</span></div>
    </div>
  </section>
</Layout>

<style>
  .guide {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  h1 {
    color: var(--color-navy);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .swatches div {
    min-height: 120px;
    display: grid;
    place-items: end start;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
  }
</style>
