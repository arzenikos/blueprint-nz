---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonaLayout from '../../layouts/PersonaLayout.astro';
const { title } = Astro.props;

import AccordionToggle from '../../components/react/AccordionToggle.tsx';
import Card from '../../components/astro/cards/Card.astro'

// import { sections } from '../../content/Sections.data';
---
<BaseLayout title={title}>
    
  <p>breadcrumbs</p>
  <h1>
    Family Page
  </h1>

  <PersonaLayout title={title}>
    <header class="head">     
      <h4>Stages</h4>
      <p>General plus stages 1–4, each expandable into a card grid.</p>
    </header>
   
    <AccordionToggle client:load>
      <div data-section="general">
        <Card title="Card A" greeting="xxx"/>
      </div>
      <div data-section="stage-1">
        <Card title="Card A" />
        <Card title="Card B" /></div>
      <div data-section="stage-2">
        <Card title="Card A" />
      </div>
      
    </AccordionToggle>


  </PersonaLayout>

</BaseLayout>


<style is:global>

  h4 {
    margin: 0 0 20px;
    font-size: clamp(30px, 7vw, 64px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  h4 mark {
    padding: 0 0.08em;
    background: var(--orange);
    color: #fff;
  }

  /**********************************************
   AccordionToggle 
  **********************************************/

  /* EXPAND ALL Button */
  .cta {                                            
    padding: 14px 24px;
    border: var(--border);
    border-radius: 0;
    background: var(--orange);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 5px 5px 0 var(--ink);
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--ink);
  }
  .cta:active {
    transform: translate(5px, 5px);
    box-shadow: 0 0 0 var(--ink);
  }
  .cta:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }


  /* Individual stage panels */
  .stage { 
    padding: 0.3rem 1rem;
  }

  /* Panel container */
  .box {
    border: var(--border);
    background: #fff;
  }

  .trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 16px;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }

  .trigger:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: -3px;
  }

  .sign {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 2px solid var(--ink);
    font-size: 15px;
    line-height: 1;
  }

  .trigger[aria-expanded="true"] .sign {
    background: var(--ink);
    color: #fff;
  }

/* Panel */
  .panel {
    height: 0;
    overflow: clip;
    transition: height var(--speed) ease;
  }

  .panel.is-open {
    height: auto;
  }

  /* Panel Content */
  .panel-content {
    padding: 16px;
    border-top: var(--border);
    color: var(--grey);
  }

  /* .panel-content p {
    margin: 0 0 12px;
  }
  .panel-content ul {
    margin: 0;
    padding-left: 20px;
  }
  .panel-content li {
    margin-bottom: 6px;
  }
  .panel-content li::marker {
    color: var(--orange);
  } */



  @media (prefers-reduced-motion: reduce) {
    * {
      transition-duration: 1ms !important;
    }
  }
</style>


