---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { headingsFromMarkdown } from '../../../lib/markdown';

export async function getStaticPaths() {
  const articles = await getCollection('patientArticles');
  return articles.map((article: CollectionEntry<'patientArticles'>) => {
    const [stage, slug] = article.id.split('/');
    return {
      params: { stage, slug },
      props: { article },
    };
  });
}

interface Props {
  article: CollectionEntry<'patientArticles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const heading = article.data.heading ?? article.data.title;
const toc = headingsFromMarkdown(article.body);
---

<ArticleLayout
  title={`Pamana | ${heading}`}
  heading={heading}
  hub="patient"
  illustration={article.data.illustration ?? 'Placeholder: article illustration'}
  toc={toc}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Navigating Your Diagnosis', href: '/patient' },
    { label: heading },
  ]}
>
  <div class="markdown">
    <Content />
  </div>
</ArticleLayout>
