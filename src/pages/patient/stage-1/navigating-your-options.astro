---
import SimpleArticle from '../../components/article/SimpleArticle.astro';
import PlaceholderMedia from '../../components/media/PlaceholderMedia.astro';
import { content } from '../../content/users/c-stage-1.ts';

const heading = content['stage-1'].heading3.title;
const main = content['stage-1'].heading3.main;
---

<SimpleArticle title={`Pamana | ${heading}`} heading={heading} illustration="Placeholder: treatment options illustration">
  <h2>{main.x.subheading}</h2>
  <p>{main.x.body[0]}</p>
  <p>{main.x.body[1]}</p>
  {main.x.body[2].items.map((item) => (
    <p>
      {item.detail}
      <PlaceholderMedia label={`Placeholder: ${item.detail.slice(0, 48)} image`} />
    </p>
  ))}
</SimpleArticle>
