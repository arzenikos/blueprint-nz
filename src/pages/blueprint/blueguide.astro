---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

// BlueNode components
import DetailPanel from '../../components/NodeGraph/DetailPanel.astro';
import GraphCanvas from '../../components/NodeGraph/GraphCanvas.astro';
import Callout from '../../components/ui/Callout.astro';

import { bluenodeData } from '../../content/blueindex/bluenode.ts';

const breadcrumbItems = [
  { label: 'Blueprint', link: '/blueprint', current: false },
  { label: 'The Blue Guide', link: '/blueprint/blueguide', current: true }
];

---
<Layout title="The Blue Guide | BluePrintNZ">
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Full-page Interactive Node Graph -->
  <!-- 
   <div class="max-w-4xl mx-auto">
    <Callout
        head="Take the First Step."
        content="Welcome to Blue Journey — your personalized walkthrough to understanding prostate health. From early screening to treatment options, we’ll guide you step-by-step through the essentials. Empower yourself with knowledge, ask the right questions, and discover supportive resources — all in one clear, accessible path."
      />
    </div> -->
  <div class="flex flex-col md:flex-row mb-5 w-full px-10 h-[calc(100vh-var(--header-height)-var(--footer-height))]" id="node-container">
    <!-- Main Graph Area (2/3 width) -->
     
    <div class="w-full md:w-3/5 relative">

      <!-- Dynamic Nodes Container with Pan and Zoom -->
      <GraphCanvas data={bluenodeData} />

    </div>
    <div class="w-full md:w-2/5 relative">
    <!-- DetailPanel (1/3 width) -->
      <DetailPanel />
    </div>
    
  </div>
</Layout>

