---
import Layout from '../../layouts/Layout.astro';

// BlueNode components
import BlueGuideDetails from '../../components/NodeGraph/BlueGuideDetails.astro';
import GraphCanvas from '../../components/NodeGraph/GraphCanvas.astro';
import Callout from '../../components/ui/Callout.astro';
import HubHero from '../../components/layout/HubHero.astro';
import { blueguideData } from '../../content/blueindex/blueguide.ts';

---
<Layout title="The Blue Guide | Pamana" hub="research">
  <HubHero
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blueprint', href: '/blueprint' }, { label: 'The Blue Guide' }]}
    heading="The Blue Guide"
    intro={Array.isArray(blueguideData.description) ? blueguideData.description.join(' ') : String(blueguideData.description ?? 'Take the first step toward prostate health.')}
    illustration="Placeholder: site guide illustration"
  />
  <div class="container mx-auto px-4 pt-4 pb-25">
     <div class="mx-10">
      <Callout
        head="Need a direct link?"
        content=`
          <a class="text-[var(--color-palette-one)]" href="https://www.youtube.com/watch?v=p2OKDvwO6EY">Watch the full video here.</a>
        </div>
        `
        />
        <div class="flex justify-center mt-3 w-full">
          <div class="w-full md:w-1/2 max-w-3xl">
            <video 
              src=""
              controls 
              class="w-full rounded-2xl shadow-lg border border-[var(--color-palette-gray)]"
            >
              Your browser does not support the video tag. Follow this <a href="https://drive.google.com/file/d/1jSr_uGVQBgooHZoz15GgDihySMrC-wYA/view?usp=sharing">link</a> to watch the demo.
            </video>
          </div>

        </div>
      <br>
      <hr class="my-4 border-t border-[var(--color-palette-gray)]" />
      <p class="text-center mt-6 text-lg font-semibold text-[var(--color-palette-five)]">
        👇 Explore the Blue Guide page map below to see how everything connects.
      </p>
      <hr class="my-4 border-t border-[var(--color-palette-gray)]" />
    <div class="flex flex-col md:flex-row mb-5 mt-10 w-full px-10 h-[calc(100vh-var(--header-height)-var(--footer-height))]" id="node-container">
      <!-- Main Graph Area (2/3 width) -->
       
      <div class="w-full md:w-3/5 relative">
        <!-- Dynamic Nodes Container with Pan and Zoom -->
        <GraphCanvas data={blueguideData} />
      </div>
      <div class="w-full md:w-2/5 relative">
      <!-- BlueGuideDetails (1/3 width) -->
        <BlueGuideDetails />
      </div>
  </div>
</div>
</Layout>

