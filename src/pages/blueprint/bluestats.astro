---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Blueprint', link: '/blueprint', current: false },
  { label: 'TrueBlueStats', link: '/blueprint/bluestats', current: true }
];
---
<Layout title="TrueBlueStats - BluePrintNZ">
  <div class="container mx-auto px-4 pt-10 pb-25">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">TrueBlueStats</h1>
      <h3>➤ View key statistics and insights about prostate cancer.</h3>
      <br><hr><br>
      <p style="font-style: italic;">...</p>
    </div>
  </div>
</Layout>