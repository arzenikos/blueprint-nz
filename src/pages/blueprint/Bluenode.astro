---
// BlueNode components
import DetailPanel from '../../components/NodeGraph/DetailPanel.astro';
import GraphCanvas from '../../components/NodeGraph/GraphCanvas.astro';

---
  <!-- Full-page Interactive Node Graph -->
  <div class="flex flex-col md:flex-row mb-5 w-full px-10 h-[calc(100vh-var(--header-height)-var(--footer-height))]" id="node-container">
    <!-- Main Graph Area (2/3 width) -->
    <div class="w-full md:w-3/5 relative">

      <!-- Dynamic Nodes Container with Pan and Zoom -->
      <GraphCanvas />

    </div>
    <div class="w-full md:w-2/5 relative">
    <!-- DetailPanel (1/3 width) -->
      <DetailPanel />
    </div>
    
  </div>