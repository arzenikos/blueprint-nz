---
import Layout from '../../layouts/Layout.astro';
import HubHero from '../../components/layout/HubHero.astro';
import PlaceholderMedia from '../../components/media/PlaceholderMedia.astro';
import { blueBeaconClinics, blueBeaconGroups } from '../../content/blueindex/bluebeacon.ts';

const heading = 'BlueBeacon';
---

<Layout title="BlueBeacon | Pamana" hub="research">
  <HubHero
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blueprint', href: '/blueprint' }, { label: heading }]}
    heading={heading}
    intro="Locate clinics, support groups, and resources near you for care and community."
    illustration="Placeholder: clinic map illustration"
  />
  <section class="beacon">
    <h2>Clinics</h2>
    <div class="grid">
      {blueBeaconClinics.map(({ name, description, address, phone, link }) => (
        <a class="place" href={link} target="_blank" rel="noopener noreferrer">
          <PlaceholderMedia label={`Placeholder: map thumbnail for ${name}`} />
          <h3>{name}</h3>
          <p>{description}</p>
          <p>{address.join(', ')}</p>
          {phone && <p>{phone}</p>}
        </a>
      ))}
    </div>
    <h2>Support groups</h2>
    <div class="grid">
      {blueBeaconGroups.map((group) => (
        <article class="place">
          <p class="region">{group.region}</p>
          <h3>{group.name}</h3>
          <p>{group.description}</p>
          {group.link && <a href={group.link}>Learn more</a>}
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .beacon {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  h2 {
    margin: 1.5rem 0 0.8rem;
    color: var(--color-navy);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .place {
    display: block;
    padding: 0.9rem;
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-navy);
    background: var(--color-surface);
  }

  .region {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: var(--color-blue);
  }
</style>
