---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import { blueCardConfig } from '../../lib/types/CardLibrary'
import { blueCards } from '../../content/blueindex/blueindex';

const breadcrumbItems = [
  { label: 'BluePrint', href: '/bluprint', current: true }
];

const {
  icon = blueCardConfig.icon,
  textClass = blueCardConfig.textClass,
  color = blueCardConfig.color,
  extraConfig = blueCardConfig.extraConfig,
  // cardLink='',//`blueindex/${extraConfig.link}`
} = blueCardConfig;

const blueCardsContent = [
  "BlueBeacon",
  "BlueNode",
  "TrueBlueStats",
];
---
<Layout title="BluePrint - BluePrintNZ">
  <Breadcrumbs items={breadcrumbItems} />
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full md:px-20 py-10 place-items-center">
   {blueCards.map(({heading, content },index) => (
    <Card
      heading={heading}
      content={content}
      icon={icon}
      textClass={textClass}
      color={color}
      config={extraConfig}
      index={index}
      link={`blueprint/${icon.name[index]}`}
      />
    ))}
  </div>
</Layout>