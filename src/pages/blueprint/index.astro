---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/ui/Card.astro';
import { blueCardConfig } from '../../lib/types/CardLibrary';
import { blueCards } from '../../content/blueindex/blueindex';
import MainPageHeading from '../../components/layout/MainPageHeading.astro';

const breadcrumbItems = [
  { label: 'Blueprint', href: '/blueprint', current: true }
];

const {
  icon = blueCardConfig.icon,
  textClass = blueCardConfig.textClass,
  color = blueCardConfig.color,
  extraConfig = blueCardConfig.extraConfig,
} = blueCardConfig;

const {
  heading = 'Your first step forward',
  title = 'Getting started | BluePrintNZ',
  description = 'Choose a card to start learning about prostate cancer',
} = Astro.props;
---

<Layout title={title}>
  <div class="container mx-auto px-4 pb-25 pt-10">
    <MainPageHeading heading={heading} description={description} breadcrumbItems={breadcrumbItems} />
    <div class="grid w-full grid-cols-1 place-items-center gap-6 py-10 md:grid-cols-2 md:px-20 lg:grid-cols-4">
      {blueCards.map(({ heading, content, image }, index) => (
        <Card
          heading={heading}
          content={content}
          icon={icon}
          textClass={textClass}
          color={color}
          config={extraConfig}
          index={index}
          link={`blueprint/${icon.name[index]}`}
          image={image}
        />
      ))}
    </div>
  </div>
</Layout>
