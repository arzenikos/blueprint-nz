---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import { blueCardConfig } from '../../lib/types/CardLibrary'
import { blueCards } from '../../content/blueindex';

const breadcrumbItems = [
  { label: 'BluePrint', href: '/bluprint', current: true }
];

const {
  icon = blueCardConfig.icon,
  textClass = blueCardConfig.textClass,
  color = blueCardConfig.color
} = blueCardConfig;
// const {
//   cardHeading=blueCards.heading,
//   content=blueCards.content
// } = blueCards;
---
<Layout title="BluePrint - BluePrintNZ">
  <Breadcrumbs items={breadcrumbItems} />
   {blueCards.map(({heading, content }) => (
    <Card
      heading={heading}
      content={content}
      icon={icon}
      textClass={textClass}
      color={color}
      />
    ))}
</Layout>