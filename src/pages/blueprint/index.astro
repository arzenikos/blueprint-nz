---
import Layout from '../../layouts/Layout.astro';
import HubHero from '../../components/layout/HubHero.astro';
import CategoryCard from '../../components/cards/CategoryCard.astro';

const tools = [
  { label: 'The Blue Guide', href: '/blueprint/blueguide', iconLabel: 'Placeholder: blue guide icon' },
  { label: 'BlueNode', href: '/blueprint/Bluenode', iconLabel: 'Placeholder: node graph icon' },
  { label: 'TrueBlueStats', href: '/blueprint/bluestats', iconLabel: 'Placeholder: statistics icon' },
  { label: 'BlueBeacon', href: '/blueprint/BlueBeacon', iconLabel: 'Placeholder: clinic map icon' },
];
---

<Layout title="Blueprint | Pamana" hub="research">
  <HubHero
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blueprint' }]}
    heading="Your first step forward"
    intro="Choose a tool to explore prostate cancer knowledge, clinics, or statistics."
    illustration="Placeholder: research tools illustration"
  />
  <section class="tools">
    <div class="grid">
      {tools.map((tool) => (
        <CategoryCard href={tool.href} label={tool.label} iconLabel={tool.iconLabel} />
      ))}
    </div>
  </section>
</Layout>

<style>
  .tools {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
</style>
