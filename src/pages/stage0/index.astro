---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

import { content } from '../../content/rsc01-what-you-need-to-know.ts';

const breadcrumbItems = [
  { label: content.stageNum , href: content.breadcrumbs.href, current: content.breadcrumbs.current }
];

const {
  heading = content.title,
  title = `Stage ${content.stageNum} - ${heading} | BluePrintNZ`,
  description = content.description,
} = Astro.props
---
<Layout title=`${title}`>
  <div class="container mx-auto px-4 pt-10 pb-25">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">{heading}</h1>
      <br><hr><br>
    <p>{description}</p>
     <p style="font-style: italic;"></p>
  </div>
  </div>

  <script>
  </script>
</Layout>