---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/ui/HeroSection.astro';
import ServicesGrid from '../components/ui/ServicesGrid.astro';
import ContentSection from '../components/ui/ContentSection.astro';
import CTASection from '../components/ui/CTASection.astro';
import { servicesContent } from '../content/services';
import { siteData } from '../content/site';

const title = "Services - " + siteData.site.title;

// Map the services to the format expected by ServicesGrid
const services = servicesContent.servicesList.map(service => ({
  id: service.id,
  icon: service.icon,
  title: service.title,
  description: service.shortDescription
}));
---

<Layout title={title}>
  <!-- Hero Section -->
  <HeroSection 
    title={servicesContent.hero.title}
    description={servicesContent.hero.description}
    image={servicesContent.hero.image}
    imageAlt={servicesContent.hero.imageAlt}
  />

  <!-- Services Grid -->
  <ServicesGrid 
    title="What We Offer"
    services={services}
    linkToDetail={true}
  />

  <!-- Process Section -->
  <section class="py-16 bg-blue-50 dark:bg-gray-800 theme-transition">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">{servicesContent.process.title}</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {servicesContent.process.steps.map(step => (
          <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md p-6 theme-transition">
            <div class="bg-blue-600 dark:bg-blue-700 text-white w-10 h-10 rounded-full flex items-center justify-center mb-4 font-bold">
              {step.number}
            </div>
            <h3 class="text-xl font-semibold mb-3">{step.title}</h3>
            <p class="text-gray-600 dark:text-gray-300">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection 
    title={servicesContent.cta.title}
    description={servicesContent.cta.description}
    buttonText={servicesContent.cta.buttonText}
    buttonHref={servicesContent.cta.buttonHref}
  />
</Layout>
