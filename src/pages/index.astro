---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/ui/CardGrid.astro';
import Carousel from '../components/ui/Carousel.astro';
import Button from '../components/ui/Button.astro';

const mainCards = [
  {
    title: "Information and Support",
    description: "Access comprehensive information and support resources to help you navigate your health journey.",
    link: "/information-and-support",
    buttonText: "Find Support"
  },
  {
    title: "Get Involved",
    description: "Discover ways to contribute through volunteering, fundraising, and community events.",
    link: "/get-involved",
    buttonText: "Join Us"
  },
  {
    title: "Research",
    description: "Learn about our research initiatives and how they're advancing knowledge and improving outcomes.",
    link: "/research",
    buttonText: "Explore Research"
  }
];

const carouselImages = [
  {
    src: "/src/assets/images/placeholder-image.jpg",
    alt: "Hero image 1"
  },
  {
    src: "/src/assets/images/placeholder-image.jpg",
    alt: "Hero image 2"
  },
  {
    src: "/src/assets/images/placeholder-image.jpg",
    alt: "Hero image 3"
  }
];
---

<BaseLayout title="BluePrintNZ - Your Health, Your Future">
  <!-- Hero Section with Carousel -->
  <section class="mt-12 mb-10 md:mt-10 md:mb-12">
    <!-- Mobile Layout (stacked with text at bottom) -->
    <div class="md:hidden relative px-5">
      <div class="w-full">
        <Carousel images={carouselImages} />
      </div>
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-secondary/80 to-transparent px-5 py-6">
        <h1 class="text-2xl font-bold mb-3 text-neutral leading-tight">Your Health, Your Future</h1>
        <p class="text-sm mb-4 text-neutral leading-snug">
          BluePrintNZ provides information and support for your health journey.
        </p>
        <div>
          <Button href="/bluenode" variant="primary" size="sm">Explore BlueNode</Button>
        </div>
      </div>
    </div>
    
    <!-- Desktop Layout (side by side) -->
    <div class="hidden md:block container mx-auto px-6 py-8 lg:py-12">
      <div class="flex flex-row items-center">
        <!-- Left column: Text content -->
        <div class="w-5/12 pr-10 py-6">
          <h1 class="text-4xl lg:text-5xl font-bold mb-8 text-secondary">Your Health, Your Future</h1>
          <p class="text-lg mb-10 leading-relaxed">
            BluePrintNZ provides information, support, and resources to help you make informed decisions about your health.
          </p>
          <div>
            <Button href="/bluenode" variant="primary" size="lg">Explore BlueNode</Button>
          </div>
        </div>
        
        <!-- Right column: Carousel -->
        <div class="w-7/12">
          <Carousel images={carouselImages} />
        </div>
      </div>
    </div>
  </section>
  
  <div class="container mx-auto px-5 md:px-6 py-8 md:py-10">
    <!-- Main Cards Section -->
    <section class="py-10 md:py-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 md:mb-10 text-secondary text-center">How We Can Help</h2>
      <div class="max-w-5xl mx-auto">
        <CardGrid cards={mainCards} columns={3} />
      </div>
    </section>
    
    <!-- Mission Statement -->
    <section class="py-10 md:py-12 bg-primary/10 rounded-lg my-10 md:my-12 px-5 md:px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 md:mb-6 text-secondary text-center">Our Mission</h2>
        <p class="text-base md:text-lg mb-6 md:mb-6 text-center">
          At BluePrintNZ, we're committed to improving health outcomes through education, support, and research.
          We believe that everyone deserves access to accurate information and compassionate support.
        </p>
        <div class="flex justify-center">
          <a href="/about" class="text-accent hover:underline font-medium">Learn more about us →</a>
        </div>
      </div>
    </section>
    
    <!-- Call to Action -->
    <section class="py-10 md:py-12 bg-secondary text-neutral rounded-lg my-10 md:my-12 px-5 md:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-6 md:mb-6">Ready to Take the Next Step?</h2>
        <p class="text-base md:text-lg mb-8 md:mb-8 ">
          Whether you're looking for information, support, or ways to get involved,
          we're here to help you on your journey.
        </p>
        <div class="flex flex-col sm:flex-row gap-5 justify-center">
          <Button href="/information-and-support" variant="accent">Find Support</Button>
          <Button href="/get-involved" variant="accent">Get Involved</Button>
          <Button href="/contact" variant="accent">Contact Us</Button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
