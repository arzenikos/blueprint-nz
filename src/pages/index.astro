<!-- HOMEPAGE -->
---
import Layout from '../layouts/Layout.astro';
import Markdown from '../components/Markdown.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { Image } from 'astro:assets';
import placeholderImage from '../assets/images/placeholder-image.jpg';

const slogan = `
Your Health, Your Future: Get the Facts on Prostate Cancer.
`;
---

<Layout title="Welcome to BluePrintNZ.">
    <div class="flex flex-col md:flex-row items-center gap-8 mb-10 w-full">
        <div class="w-full md:w-1/2">
            <h1 class="mb-10">BluePrintNZ</h1>
            <Markdown content={slogan} class="mb-10 text-lg" />
            <p>
                <a href="/bluenode" class="btn btn-lg sm:min-w-64">Explore BluePrint</a>
            </p>
        </div>
        <div class="w-full md:w-1/2">
            <Image
                src={placeholderImage}
                alt="placeholder-image"
                class="w-full max-w-full mx-auto rounded-lg shadow-lg"
                width={400}
                height={300}
                loading="lazy"
                format="webp"
                quality={80}
            />
        </div>
    </div>
    
    <!-- BlurPrintNZ -->
    <div class="flex flex-col md:flex-row items-center gap-8 card card-border bg-base-100 w-full my-8 p-6">
        <div class="w-full md:w-1/3">
            <Image
                src={placeholderImage}
                alt="placeholder-image"
                class="w-full rounded-lg shadow-lg"
                width={600}
                height={450}
                loading="lazy"
                format="webp"
                quality={80}
            />
        </div>
        <div class="card-body w-full md:w-2/3">
            <h3 class="card-title">Information & Support</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
            <div class="card-actions justify-end">
                <a href="#">Read more</a>
            </div>
        </div>
    </div>
    
    <!-- Get Involved -->
    <div class="w-full my-12">
        <h2 class="text-center mb-8">Our Services</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Card 1 -->
            <div class="card bg-base-100 shadow-sm">
                <figure class="px-6 pt-6">
                    <Image
                        src={placeholderImage}
                        alt="Get Involved"
                        class="w-full rounded-xl"
                        width={400}
                        height={300}
                        loading="lazy"
                        format="webp"
                        quality={80}
                    />
                </figure>
                <div class="card-body items-center text-center">
                    <h2 class="card-title">Get Involved</h2>
                </div>    
            </div>
            
            <!-- Card 2 -->
            <div class="card bg-base-100 shadow-sm">
                <figure class="px-6 pt-6">
                    <Image
                        src={placeholderImage}
                        alt="Research"
                        class="w-full rounded-xl"
                        width={400}
                        height={300}
                        loading="lazy"
                        format="webp"
                        quality={80}
                    />
                </figure>
                <div class="card-body items-center text-center">
                    <h2 class="card-title">Research</h2>
                </div>    
            </div>
            
            <!-- Card 3 -->
            <div class="card bg-base-100 shadow-sm">
                <figure class="px-6 pt-6">
                    <Image
                        src={placeholderImage}
                        alt="Shop"
                        class="w-full rounded-xl"
                        width={400}
                        height={300}
                        loading="lazy"
                        format="webp"
                        quality={80}
                    />
                </figure>
                <div class="card-body items-center text-center">
                    <h2 class="card-title">Shop</h2>
                </div>    
            </div>
        </div>
    </div>
</Layout>
