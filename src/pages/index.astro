---
import Layout from '../layouts/Layout.astro';
import landing from '../content/data/landing.json';
---

<Layout title={landing.meta.title} description={landing.meta.description}>
  <section class="relative overflow-hidden">
    
    <div class="pointer-events-none absolute inset-0 bg-linear-to-b from-[var(--color-palette-one)] via-transparent to-transparent"></div>

    <div class="container relative mx-auto max-w-6xl px-4 py-16 md:py-24">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-palette-three)]">
        s<!-- {landing.hero.eyebrow} -->
      </p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight text-[var(--color-palette-five)] md:text-5xl">
        {landing.hero.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-[var(--color-palette-four)]">
        {landing.hero.subtitle}
      </p>
      <!-- <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
        {landing.cards.map((card) => (
          <AudienceCard href={card.href} title={card.title} description={card.description} icon={card.icon} />
        ))} -->
      </div>
    </div>
  </section>
</Layout>
