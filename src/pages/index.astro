---
import Layout from '../layouts/Layout.astro';
// import Home from './_home/Home.astro';
const title = "BluePrintNZ | Prostate Cancer Foundation of New Zealand";
import HeroSection from './_home/HeroSection.astro';
import UsersSection from './_home/UsersSection.astro';
import ResourceSection from './_home/ResourceSection.astro';
import ContextSection from './_home/ContextSection.astro';
// import GetStartedSection from './_home/GetStartedSection.astro';

import { heroContent, userContent, resourceContent, overviewContent } from '../content/home.ts';
import { componentConfiguration } from '../lib/themes-and-layout/section-config';

---

<Layout title={title}>
    <HeroSection
      content={heroContent}
      reversed = {false}
      config={componentConfiguration}
    />
    <UsersSection
      content={userContent}
      config={componentConfiguration}
    />
    <ResourceSection
        content={resourceContent}
        config={componentConfiguration}
    />
    <!-- <ContextSection
      content={overviewContent}
      config={componentConfiguration}
      media={overviewContent.mediaSource}
    /> -->
  <!-- <section class="homeSection">
    <GetStartedSection/>
  </section> -->
</Layout>

<style>
  .homeSection {
    /* background: none; */
    width: auto;
    /* margin: 7em 0; */
  }
</style>
