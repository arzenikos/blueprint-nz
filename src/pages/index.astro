---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/chrome/SplashScreen.astro';
import BrandMark from '../components/brand/BrandMark.astro';
import PathCard from '../components/cards/PathCard.astro';
import LineIcon from '../components/ui/LineIcon.astro';
import { brand, landing } from '../content/ui/site';
---

<Layout title="Pamana | Prostate Cancer Support Website" variant="landing" showChat={true}>
  <SplashScreen />
  <section class="landing">
    <div class="landing__brand">
      <BrandMark size="lg" />
      <p class="te-reo">{brand.teReo}</p>
      <h1>{landing.heading}</h1>
      <p class="lead">{landing.instruction}</p>
    </div>
    <div class="landing__paths">
      {landing.paths.map((path) => (
        <PathCard href={path.href} title={path.title} body={path.body} iconLabel={path.iconLabel} />
      ))}
    </div>
    <button class="ai-prompt" type="button" data-open-chat>
      <LineIcon name="robot" />
      <span>{landing.aiPrompt}</span>
    </button>
  </section>
</Layout>

<script>
  document.querySelector('[data-open-chat]')?.addEventListener('click', () => {
    document.querySelector('.chat-trigger')?.dispatchEvent(new Event('click'));
  });
</script>

<style>
  .landing {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0.5rem 1.5rem 4rem;
    text-align: center;
  }

  .landing__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 2rem;
  }

  .te-reo {
    margin: 0;
    color: var(--color-text-subtle);
    font-size: 0.95rem;
  }

  h1 {
    margin: 0.3rem 0 0;
    max-width: 18ch;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.15;
    color: var(--color-navy);
  }

  .lead {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 36rem;
  }

  .landing__paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    text-align: left;
  }

  .ai-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    font-style: italic;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .landing__paths {
      grid-template-columns: 1fr;
    }
  }
</style>
