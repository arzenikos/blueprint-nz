---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/button/Button.astro';
import Icon from '../components/ui/icon/Icon.astro';

const title = "BluePrintNZ - Modern Web Solutions";
---

<Layout title={title}>
  <section class="bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-800 py-16 md:py-24">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="md:w-1/2">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
            Modern Web Solutions for New Zealand
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-8">
            Building fast, accessible, and modern websites that leverage the power of Astro's multi-page application architecture.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary" size="lg" href="/bluenode">
              Explore Bluenode
            </Button>
          </div>
        </div>
        <div class="md:w-1/2">
          <img 
            src="/src/assets/images/placeholder-image.jpg" 
            alt="BluePrintNZ Hero Image" 
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">Our Services</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service Card 1 -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 transition-transform hover:scale-105">
          <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <Icon name="code" class="text-blue-600 dark:text-blue-300" />
          </div>
          <h3 class="text-xl font-semibold mb-3">Web Development</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Custom web development using modern frameworks and technologies.
          </p>
        </div>
        
        <!-- Service Card 2 -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 transition-transform hover:scale-105">
          <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <Icon name="layout" class="text-blue-600 dark:text-blue-300" />
          </div>
          <h3 class="text-xl font-semibold mb-3">UI/UX Design</h3>
          <p class="text-gray-600 dark:text-gray-300">
            User-centered design that creates intuitive and engaging experiences.
          </p>
        </div>
        
        <!-- Service Card 3 -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 transition-transform hover:scale-105">
          <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <Icon name="search" class="text-blue-600 dark:text-blue-300" />
          </div>
          <h3 class="text-xl font-semibold mb-3">SEO Optimization</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Improve your site's visibility and ranking in search engine results.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-blue-50 dark:bg-gray-800">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/2">
          <img 
            src="/src/assets/images/placeholder-image.jpg" 
            alt="About BluePrintNZ" 
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </div>
        <div class="md:w-1/2">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">About BluePrintNZ</h2>
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
            BluePrintNZ is a platform designed to showcase modern web development techniques and best practices using Astro and Netlify.
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
            Our mission is to provide a blueprint for building fast, accessible, and modern websites that leverage the power of Astro's multi-page application architecture and Netlify's deployment platform.
          </p>
          <Button variant="primary" href="/about">
            Learn More About Us
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Get Started?</h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
        Contact us today to discuss your project and how we can help you build a modern, fast, and accessible website.
      </p>
      <Button variant="primary" size="lg" href="/contact">
        Contact Us
      </Button>
    </div>
  </section>
</Layout>
