---
import { siteData } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelRibbon from '../components/PixelRibbon.astro';
import HeroSection from '../components/home/HeroSection.astro';
import InfoSection from '../components/home/InfoSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import FoundationSection from '../components/home/FoundationSection.astro';

// Get site metadata
