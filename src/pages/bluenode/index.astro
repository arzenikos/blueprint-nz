---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';

const breadcrumbItems = [
  { label: 'BlueNode', href: '/bluenode', current: true }
];
---

<BaseLayout title="BlueNode - BluePrintNZ">
  <div class="container mx-auto px-4 py-8">
    <Breadcrumbs items={breadcrumbItems} />
    
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">BlueNode Platform</h1>
      
      <!-- Interactive Node Graph -->
      <div class="bg-neutral-50 p-6 rounded-lg mb-8 min-h-[400px] flex flex-col items-center justify-center relative" id="node-container">
        <!-- Starting Node -->
        <div id="start-node" class="cursor-pointer transition-all duration-300 hover:scale-110">
          <div class="w-16 h-16 rounded-full bg-accent flex items-center justify-center shadow-lg">
            <span class="text-neutral font-semibold">Start here</span>
          </div>
        </div>
        
        <!-- Option Nodes (initially hidden) -->
        <div id="option-nodes" class="hidden">
          <!-- Option 1 -->
          <div id="option-1" class="absolute transition-all duration-500 opacity-0">
            <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center shadow-md">
              <span class="text-secondary text-sm font-medium">Option 1</span>
            </div>
          </div>
          
          <!-- Option 2 -->
          <div id="option-2" class="absolute transition-all duration-500 opacity-0">
            <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center shadow-md">
              <span class="text-secondary text-sm font-medium">Option 2</span>
            </div>
          </div>
          
          <!-- Option 3 -->
          <div id="option-3" class="absolute transition-all duration-500 opacity-0">
            <div class="w-14 h-14 rounded-full bg-primary flex items-center justify-center shadow-md">
              <span class="text-secondary text-sm font-medium">Option 3</span>
            </div>
          </div>
        </div>
        
        <!-- Pre-rendered SVG for connection lines -->
        <svg class="absolute top-0 left-0 w-full h-full pointer-events-none hidden" id="connection-lines">
          <line id="line-1" x1="50%" y1="50%" x2="40%" y2="30%" stroke="#3b82f6" stroke-width="2" class="opacity-0 transition-opacity duration-500" />
          <line id="line-2" x1="50%" y1="50%" x2="60%" y2="30%" stroke="#3b82f6" stroke-width="2" class="opacity-0 transition-opacity duration-500" />
          <line id="line-3" x1="50%" y1="50%" x2="70%" y2="40%" stroke="#3b82f6" stroke-width="2" class="opacity-0 transition-opacity duration-500" />
        </svg>
      </div>
      
      <div class="bg-primary/10 p-6 rounded-lg mb-8">
        <h2 class="text-xl font-semibold mb-3 text-secondary">Powerful Health Data Management</h2>
        <p class="mb-4">
          BlueNode is our advanced platform for managing health data, providing insights, and connecting healthcare providers with patients.
          Built with security and privacy at its core, BlueNode helps streamline healthcare processes and improve outcomes.
        </p>
        <p>
          Discover how BlueNode can transform your healthcare experience with powerful tools and intuitive interfaces.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="border border-neutral-300 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-3 text-secondary">For Patients</h3>
          <ul class="space-y-2 list-disc pl-5">
            <li>Secure access to your health records</li>
            <li>Schedule appointments with healthcare providers</li>
            <li>Track health metrics and progress</li>
            <li>Receive personalized health insights</li>
            <li>Connect with support communities</li>
          </ul>
          <div class="mt-4">
            <Button href="#" variant="accent" size="md">Patient Portal</Button>
          </div>
        </div>
        
        <div class="border border-neutral-300 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-3 text-secondary">For Providers</h3>
          <ul class="space-y-2 list-disc pl-5">
            <li>Comprehensive patient management</li>
            <li>Secure data sharing and collaboration</li>
            <li>Advanced analytics and reporting</li>
            <li>Streamlined appointment scheduling</li>
            <li>Integration with existing systems</li>
          </ul>
          <div class="mt-4">
            <Button href="#" variant="accent" size="md">Provider Portal</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Get elements once and cache them
    const startNode = document.getElementById('start-node');
    const optionNodes = document.getElementById('option-nodes');
    const connectionLines = document.getElementById('connection-lines');
    
    if (startNode && optionNodes && connectionLines) {
      // Pre-calculate positions
      const positions = {
        option1: { top: '-100px', left: '-50px' },
        option2: { top: '-100px', left: '50px' },
        option3: { top: '-50px', left: '100px' }
      };
      
      // Handle start node click with optimized code
      startNode.addEventListener('click', () => {
        // Show options container and SVG lines
        optionNodes.classList.remove('hidden');
        connectionLines.classList.remove('hidden');
        
        // Get all option nodes at once
        const option1 = document.getElementById('option-1');
        const option2 = document.getElementById('option-2');
        const option3 = document.getElementById('option-3');
        const line1 = document.getElementById('line-1');
        const line2 = document.getElementById('line-2');
        const line3 = document.getElementById('line-3');
        
        // Use requestAnimationFrame for smoother animations
        requestAnimationFrame(() => {
          // Position and animate option nodes
          if (option1) {
            option1.style.top = positions.option1.top;
            option1.style.left = positions.option1.left;
            option1.classList.add('opacity-100');
          }
          
          if (option2) {
            option2.style.top = positions.option2.top;
            option2.style.left = positions.option2.left;
            option2.classList.add('opacity-100');
          }
          
          if (option3) {
            option3.style.top = positions.option3.top;
            option3.style.left = positions.option3.left;
            option3.classList.add('opacity-100');
          }
          
          // Animate lines
          if (line1) line1.classList.add('opacity-100');
          if (line2) line2.classList.add('opacity-100');
          if (line3) line3.classList.add('opacity-100');
        });
      });
    }
  });
</script>

<style>
  #node-container {
    overflow: hidden;
  }
  
  #option-1, #option-2, #option-3 {
    transform: translate(-50%, -50%);
  }
  
  .opacity-100 {
    opacity: 1 !important;
  }
</style>
