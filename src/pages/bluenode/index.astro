        description: "Various programs offer financial support for cancer treatment, medications, and related expenses.",
        children: []
      },
      {
        id: "education",
        label: "Educational Resources",
        description: "Knowledge is power. Learn more about prostate cancer through reliable resources and educational materials.",
        children: []
      }
    ]
  };
</script>

<style>
  /* Set CSS variables for header and footer heights */
  :root {
    --header-height: 64px;
    --footer-height: 300px;
  }
  
  /* Make the node container fill the available space between header and footer */
  #node-container {
    overflow: hidden;
    position: relative;
  }
  
  /* Position nodes properly */
  .node-element {
    transform: translate(-50%, -50%);
  }
  
  /* Make sure opacity transition works */
  .opacity-100 {
    opacity: 1 !important;
  }
  
  /* Ensure smooth transitions for panning and zooming */
  #nodes-container {
    transition: transform 0.1s ease-out;
  }
  
  /* When actively panning, disable transitions for responsive movement */
  #nodes-container.panning {
    transition: none;
  }
</style>
