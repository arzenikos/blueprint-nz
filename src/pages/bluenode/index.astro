---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
// import Button from '../../components/ui/Button.astro';

// BlueNode components
import ZoomControls from '../../components/NodeGraph/ZoomControls.astro';
import ResetButton from '../../components/NodeGraph/ResetButton.astro';
import NodePanel from '../../components/NodeGraph/NodePanel.astro';
import GraphCanvas from '../../components/NodeGraph/GraphCanvas.astro';

//Style
import '../../styles/bluenode-style.css';

const breadcrumbItems = [
  { label: 'Blue Node', href: '/bluenode', current: true }
];

---
<Layout title="BlueNode - BluePrintNZ">
  <Breadcrumbs items={breadcrumbItems} />
  <!-- Full-page Interactive Node Graph -->
  <div class="flex flex-col md:flex-row w-full px-10 h-[calc(100vh-var(--header-height)-var(--footer-height))]" id="node-container">
    <!-- Main Graph Area (2/3 width) -->
    <div class="w-full md:w-3/5 h-full relative">
      <!-- Zoom Controls -->
      <!-- <ZoomControls/> -->
      <!-- Reset View Button -->
      <!-- <ResetButton/> -->
      
      <!-- Dynamic Nodes Container with Pan and Zoom -->
      <GraphCanvas />

    </div>

      <!-- SVG for connection lines -->
      <!-- <svg class="absolute top-0 left-0 w-full h-full pointer-events-none" id="connection-lines"></svg> -->
    <div class="w-full md:w-2/5 h-full relative">
    <!-- Detail Panel (1/3 width) -->
      <NodePanel />
    </div>
    
  </div>
</Layout>

