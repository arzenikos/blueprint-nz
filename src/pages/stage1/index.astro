---
// <!-- Not referenced by any file -->
// import BaseLayout from '../../layouts/BaseLayout.astro';
// import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Information and Support', href: '/information-and-support', current: true }
];
---

<!-- <BaseLayout title="Information and Support - BluePrintNZ"> -->
  <div class="container mx-auto px-4 py-8">
    <!-- <Breadcrumbs items={breadcrumbItems} /> -->
    
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">Information and Support</h1>
      
      <div class="bg-primary/10 p-6 rounded-lg mb-8">
        <h2 class="text-xl font-semibold mb-3 text-secondary">Resources for You</h2>
        <p class="mb-4">
          We provide comprehensive information and support services to help you navigate your health journey.
          Our resources are designed to be accessible, accurate, and supportive.
        </p>
        <p>
          Whether you're looking for basic information, detailed guides, or personal support,
          we're here to help you every step of the way.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6 mb-10">
        <div class="border border-neutral-300 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-3 text-secondary">Information Resources</h3>
          <ul class="space-y-2 list-disc pl-5">
            <li>Comprehensive guides and factsheets</li>
            <li>Educational videos and webinars</li>
            <li>Frequently asked questions</li>
            <li>Latest research summaries</li>
            <li>Treatment options explained</li>
          </ul>
        </div>
        
        <div class="border border-neutral-300 rounded-lg p-6">
          <h3 class="text-lg font-semibold mb-3 text-secondary">Support Services</h3>
          <ul class="space-y-2 list-disc pl-5">
            <li>One-on-one support sessions</li>
            <li>Support groups and community forums</li>
            <li>Helpline services</li>
            <li>Counseling referrals</li>
            <li>Family and caregiver resources</li>
          </ul>
        </div>
      </div>
      
      <h2 class="text-2xl font-bold mb-4 text-secondary">How We Can Help</h2>
      <p class="mb-6">
        Our team of dedicated professionals is committed to providing you with the information and support you need.
        We understand that everyone's journey is unique, and we tailor our approach to meet your specific needs.
      </p>
      
      <div class="bg-accent/10 p-6 rounded-lg mb-8">
        <h3 class="text-xl font-semibold mb-3 text-secondary">Contact Our Support Team</h3>
        <p class="mb-4">
          Our support team is available Monday through Friday, 9am to 5pm.
          You can reach us by phone, email, or through our online chat service.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#" class="bg-accent text-neutral py-2 px-4 rounded-lg text-center hover:bg-accent/80 transition-colors">
            Call Us
          </a>
          <a href="#" class="bg-accent text-neutral py-2 px-4 rounded-lg text-center hover:bg-accent/80 transition-colors">
            Email Us
          </a>
          <a href="#" class="bg-accent text-neutral py-2 px-4 rounded-lg text-center hover:bg-accent/80 transition-colors">
            Chat Now
          </a>
        </div>
      </div>
    </div>
  </div>
<!-- </BaseLayout> -->
