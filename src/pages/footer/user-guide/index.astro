---
import Layout from '../../../layouts/Layout.astro';
import MainPageHeading from '../../../components/layout/MainPageHeading.astro';
---

<Layout title="How to use this site | BluePrintNZ">
  <div class="container mx-auto px-4 pb-20 pt-10">
    <MainPageHeading
      heading="How to use this site"
      description="Start on the welcome page, choose the card that matches your situation, then open the guides in that hub."
      breadcrumbItems={[
        { label: 'Home', href: '/', current: false },
        { label: 'User guide', href: '/footer/user-guide', current: true },
      ]}
    />
    <ol class="max-w-2xl list-decimal space-y-3 pl-6 text-[var(--color-palette-four)]">
      <li>On the home page, pick diagnosis, support, or research.</li>
      <li>Open a resource card for a short overview.</li>
      <li>Use the header to switch theme and text size at any time.</li>
    </ol>
  </div>
</Layout>
