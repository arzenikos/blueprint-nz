---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { content } from '../../content/page-content.ts';

const {
  heading = content.stage0.heading3.title,
  title = `Stage ${content.stage0.heading3.stageNum} - ${heading} | BluePrintNZ`,
  description = content.stage0.heading3.description,
  body = content.stage0.heading3.body,
  // link = content.stage0.heading3.description,
  breadcrumb = content.stage0.heading3.breadcrumbs,
} = Astro.props

const breadcrumbItems = [
  { label: heading , link: breadcrumb.link, current: breadcrumb.current }
];
---
<Layout title=`${title}`>
  <div class="container mx-auto px-4 pt-10 pb-25">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">{heading}</h1>
      <ul>
      {Array.isArray(description) && description.map((p, i) => (
          <li class="mb-4">{p}</li>
        ))}
      </ul>
      <hr class="my-4 border-t border-gray-300" />
      {body}
     <p style="font-style: italic;"></p>
  </div>
  </div>
  <script>
  </script>
</Layout>