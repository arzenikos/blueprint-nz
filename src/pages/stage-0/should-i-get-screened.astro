---
// <!-- Not imported by any file -->
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { content } from '../../content/page-content.ts';
import Icon from '../../components/ui/Icon.astro';

const {
  heading = content["stage-0"].heading3.title,
  title = `Stage ${content["stage-0"].heading3.stageNum} - ${heading} | BluePrintNZ`,
  description = content["stage-0"].heading3.description,
  main = content["stage-0"].heading3.main,
  // link = content["stage-0"].heading3.description,
  breadcrumb = content["stage-0"].heading3.breadcrumbs,
} = Astro.props

const breadcrumbItems = [
  { label: heading , link: breadcrumb.link, current: breadcrumb.current }
];
---
<Layout title=`${title}`>
  <div class="container mx-auto px-4 pt-10 pb-25">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold mb-6 text-secondary">{heading}</h1>
      <details class="group">
      <summary class="cursor-pointer font-semibold">Summary</summary>
          <ul style="padding-left:2rem" class="ml-4 mt-2 text-gray-700 group-open:animate-fade-in">
          {Array.isArray(description) && description.map((p, i) => (
              <li class="mb-4">{p}</li>
            ))}
          </ul>
        Sources: <a href={main.PSATest.link} class="pt-2">{main.PSATest.link}</a>
      </details>
      <hr class="my-4 border-t border-gray-300" />
      
      <span class="subheadings mt-5 flex gap-3">
        {main.PSATest.subheading}
        <a href=`${main.PSATest.link}`>
            <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)"/>
        </a>
      </span>
      <p class="pt-2">{main.PSATest.body[0]}</p>
      <p class="pt-2">{main.PSATest.body[1]}</p>
<!--  -->
      <span class="subheadings mt-5 flex gap-3">
        {main.PSARecom.subheading}
        <a href=`${main.PSARecom.link}`>
            <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)"/>
        </a>
      </span>
      <p class="pt-2">{main.PSARecom.body[0]}</p>
      <p class="pt-2">{main.PSARecom.body[1]}</p>
  <!--  -->
      <span class="subheadings mt-5 flex gap-3">
        {main.PSAResult.subheading}
        <a href=`${main.PSAResult.link}`>
            <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)"/>
        </a>
      </span>
      <p class="pt-2">{main.PSAResult.body[0]}</p>
  <!--  -->
      <span class="subheadings mt-5 flex gap-3">
        {main.PSALimitations.subheading}
        <a href=`${main.PSALimitations.link}`>
            <Icon class="page-link-icon" name="external-link" color="var(--color-palette-five)"/>
        </a>
      </span>
      <!-- <p class="pt-2">{main.PSALimitations.body[0]}</p>
        -->
      {main.PSALimitations.body.map((item, index) => {
        if (typeof item === 'string') {
          return <p class="pt-2">{item}</p>;
        } else if (Array.isArray(item.items)) {
          return (
            <ul class="list-disc list-inside pt-2">
              {item.items.map((subItem, subIndex) => (
                <li>{subItem}</li>
              ))}
            </ul>
          );
        }
      })}

                        

  </div>
  </div>
  <script>
  </script>
</Layout>