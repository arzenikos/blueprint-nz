---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/main/banner/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Empty page', href: '/empty', current: true }
];
---

<Layout title="Empty - BluePrintNZ">
  <div class="container mx-auto px-4 pb-25 pt-10">
    <Breadcrumbs items={breadcrumbItems} />
    <div class="mx-auto max-w-4xl">
      <h1 class="mb-6 text-3xl font-bold md:text-4xl">This page is still under development</h1>
      <p>We’re working on it — check back soon.</p>
      <p class="mt-6 italic">Redirecting you home in a moment…</p>
    </div>
  </div>
  <script>
    setTimeout(() => {
      window.location.replace('/');
    }, 3000);
  </script>
</Layout>
