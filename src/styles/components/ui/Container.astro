---
// <!-- Imported by: components/home/FoundationSection.astro, components/home/HeroSection.astro, components/home/InfoSection.astro, components/home/ServicesSection.astro, pages/about.astro -->
interface Props {
  fluid?: boolean;
  class?: string;
}

const { fluid = false, class: className = '' } = Astro.props;

const containerClass = fluid 
  ? `container-fluid ${className}` 
  : `container mx-auto px-5 sm:px-6 lg:px-8 py-6 md:py-8 ${className}`;
---

<div class={containerClass}>
  <slot />
</div>
