---
const navItems = [
  { linkText: 'Admin', href: '/admin' } //blobs
];
---

<footer class="w-full border-t border-astro-dark-100/20 bg-black py-8">
    <div class="w-full max-w-[2000px] mx-auto">
        <nav aria-label="Secondary" class="flex flex-col lg:flex-row justify-between gap-8 lg:gap-16">
            <div class="flex flex-col md:max-lg:w-1/2 lg:max-w-sm">
                <p class="font-semibold md:text-xl">Let's keep in touch</p>
                <p class="mb-4 pt-2 text-astro-gray-200">
                    Enter your email to stay up to date with the latest updates.
                </p>
                <form
                    action="#"
                    method="post"
                    class="flex flex-col sm:flex-row gap-2">
                    <input 
                        class="h-10 rounded-lg border border-astro-gray-600 bg-astro-dark-900 px-3 py-1 text-astro-gray-100 focus:outline-none focus:ring-[1px] focus:ring-astro-gray-400 flex-grow" 
                        type="email"
                        placeholder="your@email.com"
                        name="email"
                        id="email"
                        required>
                    <button
                        type="submit"
                        class="h-10 px-4 border border-astro-dark-100/10 font-sm font-light bg-astro-gray-600/80 hover:bg-astro-gray-600/50 hover:cursor-pointer rounded-lg">
                        Subscribe
                    </button>
                </form>
            </div>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
                <section class="flex flex-col">
                    <h2 id="footerHeading0" class="mb-4 text-white font-semibold">Resources</h2>
                    <ul aria-labelledby="footerHeading0" class="flex flex-col gap-2">
                        <li><a href="#" class="link">Support</a></li>
                        <li><a href="#" class="link">Research</a></li>
                        <li><a href="#" class="link">Education</a></li>
                        <li><a href="#" class="link">Community</a></li>
                    </ul>
                </section>
                
                <section class="flex flex-col">
                    <h2 id="footerHeading1" class="mb-4 text-white font-semibold">About</h2>
                    <ul aria-labelledby="footerHeading1" class="flex flex-col gap-2">
                        <li><a href="#" class="link">Our Story</a></li>
                        <li><a href="#" class="link">Team</a></li>
                        <li><a href="#" class="link">Partners</a></li>
                        <li><a href="#" class="link">News</a></li>
                    </ul>
                </section>
                
                <section class="flex flex-col">
                    <h2 id="footerHeading2" class="mb-4 text-white font-semibold">Get Involved</h2>
                    <ul aria-labelledby="footerHeading2" class="flex flex-col gap-2">
                        <li><a href="#" class="link">Donate</a></li>
                        <li><a href="#" class="link">Volunteer</a></li>
                        <li><a href="#" class="link">Events</a></li>
                        <li><a href="#" class="link">Fundraise</a></li>
                    </ul>
                </section>
                
                <section class="flex flex-col">
                    <h2 id="footerHeading3" class="mb-4 text-white font-semibold">Legal</h2>
                    <ul aria-labelledby="footerHeading3" class="flex flex-col gap-2">
                        <li><a href="#" class="link">Privacy Policy</a></li>
                        <li><a href="#" class="link">Terms of Service</a></li>
                        <li><a href="#" class="link">Cookie Policy</a></li>
                    </ul>
                </section>
            </div>
        </nav>
        
        <hr class="border-astro-gray-500 my-6">
        
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-sm text-center md:text-left">
                © 2025 BluePrintNZ. All rights reserved.
            </div>
            <div class="flex items-center gap-4">
                <a href="#" class="text-white hover:text-primary" aria-label="Facebook">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                </a>
                <a href="#" class="text-white hover:text-primary" aria-label="Twitter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
                </a>
                <a href="#" class="text-white hover:text-primary" aria-label="Instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                </a>
                <a href="#" class="text-white hover:text-primary" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                </a>
            </div>
        </div>
    </div>
</footer>