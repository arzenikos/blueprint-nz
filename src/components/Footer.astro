---
const navItems = [
  { linkText: 'Admin', href: '/admin' } //blobs
];
---

<footer class="pt-16 pb-12 sm:pt-24 sm:pb-16">
    <!-- <p class="text-sm">
        <a href="https://docs.netlify.com/frameworks/astro/" class="decoration-dashed text-primary underline-offset-8"> Astro on Netlify </a>
    </p> -->
    <div class="flex flex-wrap items-center gap-8 pt-6 pb-16 sm:pt-12 sm:pb-24">
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </nav>
</footer>
