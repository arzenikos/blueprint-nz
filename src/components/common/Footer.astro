---
import { siteData } from '../../data/site';
import Container from '../ui/Container.astro';
import SocialIcon from './SocialIcon.astro';
import PixelRibbon from '../ui/PixelRibbon.astro';

const { footer } = siteData;
---

<footer class="w-full border-t border-astro-dark-100/20 bg-black py-8 mt-16">
  <PixelRibbon pixelSize={2} />
  <Container fluid>
    <nav aria-label="Secondary" class="flex flex-col lg:flex-row justify-between gap-8 lg:gap-16 pt-4">
      <div class="flex flex-col md:max-lg:w-1/2 lg:max-w-sm">
        <p class="font-semibold text-base md:text-lg text-white">{footer.newsletterSection.title}</p>
        <p class="mb-4 pt-2 text-astro-gray-200 text-sm">
          {footer.newsletterSection.description}
        </p>
        <form
          action="#"
          method="post"
          class="flex flex-col sm:flex-row gap-2">
          <input 
            class="h-9 rounded-lg border border-astro-gray-600 bg-astro-dark-900 px-3 py-1 text-astro-gray-100 text-sm focus:outline-none focus:ring-[1px] focus:ring-astro-gray-400 flex-grow" 
            type="email"
            placeholder={footer.newsletterSection.placeholder}
            name="email"
            id="email"
            required>
          <button
            type="submit"
            class="h-9 px-4 border border-astro-dark-100/10 text-sm font-light bg-astro-gray-600/80 hover:bg-astro-gray-600/50 hover:cursor-pointer rounded-lg">
            {footer.newsletterSection.buttonText}
          </button>
        </form>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8">
        {footer.sections.map((section, index) => (
          <section class="flex flex-col">
            <h2 id={`footerHeading${index}`} class="mb-3 text-white font-semibold text-sm">{section.title}</h2>
            <ul aria-labelledby={`footerHeading${index}`} class="flex flex-col gap-1.5">
              {section.links.map(link => (
                <li><a href={link.url} class="footer-link text-xs">{link.text}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </nav>
    
    <hr class="border-astro-gray-500 my-5">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="text-xs text-center md:text-left text-white/60">
        {footer.copyright}
      </div>
      <div class="flex items-center gap-3">
        {footer.socialLinks.map(social => (
          <a href={social.url} class="text-white hover:text-primary" aria-label={social.ariaLabel}>
            <SocialIcon platform={social.platform} class="w-4 h-4" />
          </a>
        ))}
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer-link {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease;
  }
  
  .footer-link:hover {
    color: rgba(255, 255, 255, 1);
  }
</style>
