---
import { chatboxContent } from '../../../content/chatbox';

const { title, initialMessage, placeholder, buttonText } = chatboxContent;
---

<div id="chat-box" class="fixed bottom-4 right-4 z-50 hidden">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-80 md:w-96 overflow-hidden theme-transition">
    <div class="bg-blue-600 dark:bg-blue-800 text-white p-3 flex justify-between items-center theme-transition">
      <h3 class="font-medium">{title}</h3>
      <button id="close-chat" class="text-white hover:text-gray-200">
        <span class="sr-only">Close</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
    
    <div id="chat-messages" class="p-3 h-64 overflow-y-auto">
      <div class="mb-3">
        <div class="bg-gray-100 dark:bg-gray-700 rounded-lg p-2 max-w-[80%] theme-transition">
          <p class="text-sm dark:text-gray-200">{initialMessage}</p>
        </div>
      </div>
    </div>
    
    <div class="border-t border-gray-200 dark:border-gray-700 p-3 theme-transition">
      <form id="chat-form" class="flex">
        <input 
          type="text" 
          id="chat-input" 
          class="flex-1 border border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white rounded-l-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 theme-transition"
          placeholder={placeholder}
        />
        <button 
          type="submit"
          class="bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-800 text-white px-4 py-2 rounded-r-lg theme-transition"
        >
          {buttonText}
        </button>
      </form>
    </div>
  </div>
  
  <button 
    id="chat-toggle" 
    class="bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-800 text-white rounded-full p-3 shadow-lg absolute bottom-0 right-0 transform translate-y-16 theme-transition"
    aria-label="Chat Support"
  >
    <span class="sr-only">Open chat</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
  </button>
</div>

<script>
  // Extend the Window interface to include chatboxContent
  /**
   * @typedef {Object} ChatboxResponses
   * @property {string} greeting
   * @property {string} help
   * @property {string} services
   * @property {string} contact
   * @property {string} pricing
   * @property {string} thanks
   * @property {string} goodbye
   * @property {string} default
   */
  /**
   * @typedef {Object} ChatboxContent
   * @property {ChatboxResponses} responses
   */

  // @ts-ignore
  window.chatboxContent = {
    responses: {
      greeting: "Hello! How can I help you today?",
      help: "I'm here to help! You can ask me about our services, website features, or how to get started.",
      services: "We offer web development, UI/UX design, and SEO optimization services. Would you like to know more about any of these?",
      contact: "You can reach our team at contact@blueprintnz.com or call us at (555) 123-4567 during business hours.",
      pricing: "Our pricing varies based on project requirements. Would you like to request a custom quote?",
      thanks: "You're welcome! Is there anything else I can help you with?",
      goodbye: "Thank you for chatting with us! Have a great day!",
      default: "Thank you for your message. Our team will get back to you soon. In the meantime, feel free to explore our website or ask me another question."
    }
  };
</script>

<style>
  #chat-toggle {
    transition: transform 0.3s ease;
  }
  
  #chat-messages::-webkit-scrollbar {
    width: 6px;
  }
  
  #chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }
  
  #chat-messages::-webkit-scrollbar-thumb {
    background-color: rgba(156, 163, 175, 0.5);
    border-radius: 20px;
  }
</style>
