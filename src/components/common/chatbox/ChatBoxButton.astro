---
// Standalone ChatBox button component
---

<!-- Chat toggle button - always visible at bottom right -->
<button 
  id="chat-toggle-standalone" 
  class="bg-blue-600 hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-800 text-white rounded-full p-3 shadow-lg fixed bottom-4 right-4 z-50 !block !opacity-100"
  aria-label="Chat Support"
>
  <span class="sr-only">Open chat</span>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
  </svg>
</button>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    console.log('Standalone chat button loaded');
    const chatToggleStandalone = document.getElementById('chat-toggle-standalone');
    const chatToggle = document.getElementById('chat-toggle');
    
    // If the standalone button exists, add click handler to trigger the main button
    if (chatToggleStandalone && chatToggle) {
      chatToggleStandalone.addEventListener('click', () => {
        console.log('Standalone button clicked, triggering main button');
        chatToggle.click();
        // Hide the standalone button after clicking
        chatToggleStandalone.style.display = 'none';
      });
    }
    
    // Add pulse animation
    setTimeout(() => {
      if (chatToggleStandalone) {
        chatToggleStandalone.classList.add('animate-pulse');
      }
    }, 2000);
  });
</script>

<style>
  #chat-toggle-standalone {
    transition: transform 0.3s ease, background-color 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }
  
  #chat-toggle-standalone:hover {
    transform: scale(1.05);
  }
</style>
