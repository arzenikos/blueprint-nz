---
import { siteData } from '../../data/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Container from '../ui/Container.astro';
import PixelRibbon from '../ui/PixelRibbon.astro';
import NavIcons from '../NavIcons.astro';

const { navigation } = siteData;
---

<header class="py-6">
  <PixelRibbon pixelSize={2} />
  <Container>
    <nav class="flex flex-wrap items-center justify-between w-full gap-6 pt-4">
      <a href="/" class="flex items-center logo-container" aria-label="Home">
        <Logo className="logo-wrapper" />
      </a>
      
      <div class="flex items-center gap-4">
        {navigation.items.length > 0 && (
          <ul class="flex items-center gap-4">
            {navigation.items.map((item) => (
              <li>
                <a 
                  href={item.href} 
                  class="nav-item inline-flex items-center justify-center px-3 py-2 rounded-md transition-colors"
                  aria-label={item.text}
                >
                  <span class="sm:hidden">
                    <NavIcons name={item.text} />
                  </span>
                  <span class="hidden sm:inline">{item.text}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        
        <div class="theme-toggle-container">
          <ThemeToggle />
        </div>
      </div>
    </nav>
  </Container>
</header>

<style>
  /* Logo container styles to ensure proper spacing */
  .logo-container {
    flex-shrink: 0;
    margin-right: 1rem;
    overflow: visible;
  }
  
  /* Ensure logo wrapper doesn't get compressed */
  :global(.logo-wrapper) {
    flex-shrink: 0;
    min-width: fit-content;
  }
  
  /* Navigation item styles - inverted to light color */
  .nav-item {
    color: var(--color-complementary-content); /* Light color */
    background-color: var(--color-complementary); /* Dark background */
    font-weight: 500;
  }
  
  .nav-item:hover {
    color: var(--color-complementary); /* Dark color on hover */
    background-color: var(--color-primary-light); /* Light background on hover */
  }
  
  /* Theme toggle container with outline */
  .theme-toggle-container {
    border: 2px solid var(--color-complementary-content);
    border-radius: 9999px;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-complementary);
  }
  
  /* Responsive styles */
  @media (max-width: 640px) {
    .nav-item {
      width: 2.5rem;
      height: 2.5rem;
      padding: 0.5rem;
      border-radius: 9999px;
    }
  }
</style>
