---
import { siteData } from '../../data/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Container from '../ui/Container.astro';

const { navigation } = siteData;
---

<header class="py-6">
  <Container>
    <nav class="flex flex-wrap items-center justify-between w-full gap-6">
      <a href="/" class="flex items-center" aria-label="Home">
        <Logo />
      </a>
      
      {navigation.items.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {navigation.items.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="inline-block px-2 py-1 sm:px-3 sm:py-2 hover:text-primary transition-colors"
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      )}
      
      <div class="flex items-center gap-4">
        <ThemeToggle />
      </div>
    </nav>
  </Container>
</header>
