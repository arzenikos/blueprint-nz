---
import Icon from './Icon.astro';

const {
  heading,
  content,
  icon,
  textClass,
  color,
  config,
  index,
  link,
  image,
  variant = 'default',
  cardStatus,
} = Astro.props;

const hoverClass = config?.hoverFx || config?.hoverFx ? 'hover:scale-110' : 'hover:scale-100';
---

{variant === 'simple' ? (
  <div class="h-110 rounded-md bg-[var(--color-palette-four)] px-5 py-10 shadow-md transition-transform">
    {image && (
      <img src={image} alt={heading} class="rounded-lg" loading="lazy" />
    )}
    <p class="mt-4 mb-2 text-xl font-semibold text-[var(--color-palette-one)]">{heading}</p>
    <p class="text-[var(--color-palette-one)]">{content}</p>
    <a href={link} class="mt-5 block underline underline-offset-5">
      <span class="flex gap-2" style="color: var(--color-palette-three)">
        Learn more
        <Icon class="card-icon scale-70" name="external-link" color="var(--color-palette-three)" />
      </span>
    </a>
  </div>
) : (
  <div class={`card-item justify-center rounded-lg shadow-md transition-transform ${hoverClass} ${config.layout} ${color.cardBg}`}>
    {image && (
      <img src={image} alt={heading} class={config.image} loading="lazy" />
    )}
    <a href={link} class={`${textClass.setVariant} block no-underline`}>
      <div class="mb-4 flex h-15 w-15 items-center justify-center rounded-full" style={`${icon.bgColor};`}>
        <Icon class={icon.class} name={icon.name[index]} color={icon.textColor} />
      </div>
      <p class={`${textClass.heading} mb-3 text-xl font-semibold`} style={`color: ${color.heading};`}>
        {heading}
      </p>
      {Array.isArray(content) ? (
        <ul class={textClass.content}>
          {content.map((item) => (
            <li class="card-content" style={`color: ${color.heading};`}>{item}</li>
          ))}
        </ul>
      ) : (
        <p class="card-content">{content}</p>
      )}
    </a>
  </div>
)}
