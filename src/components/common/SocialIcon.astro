---
interface Props {
  platform: string;
  size?: number;
}

const { platform, size = 24 } = Astro.props;

// SVG paths for common social media icons
const icons = {
  facebook: {
    viewBox: "0 0 24 24",
    path: "M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
  },
  twitter: {
    viewBox: "0 0 24 24",
    path: "M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
  },
  instagram: {
    viewBox: "0 0 24 24",
    path: "M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z M17.5 6.5h.01",
    rect: { x: 2, y: 2, width: 20, height: 20, rx: 5, ry: 5 }
  },
  linkedin: {
    viewBox: "0 0 24 24",
    path: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z",
    circle: { cx: 4, cy: 4, r: 2 }
  }
};

const icon = icons[platform.toLowerCase()] || icons.facebook;
---

<svg 
  xmlns="http://www.w3.org/2000/svg" 
  width={size} 
  height={size} 
  viewBox={icon.viewBox} 
  fill="none" 
  stroke="currentColor" 
  stroke-width="2" 
  stroke-linecap="round" 
  stroke-linejoin="round"
>
  {icon.rect && <rect x={icon.rect.x} y={icon.rect.y} width={icon.rect.width} height={icon.rect.height} rx={icon.rect.rx} ry={icon.rect.ry}></rect>}
  {icon.circle && <circle cx={icon.circle.cx} cy={icon.circle.cy} r={icon.circle.r}></circle>}
  {icon.path.split(' M').map((path, i) => (
    <path d={i === 0 ? path : `M${path}`}></path>
  ))}
</svg>
