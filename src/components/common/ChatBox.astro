---
// <!-- Imported by: layouts/BaseLayout.astro -->
// ChatBox.astro - A simple chat interface component
import { componentSpacing } from '../../styles/spacing';

// Get spacing values from centralized file
const chatMarginBottom = componentSpacing.chat.margin.bottom;
const chatPadding = componentSpacing.chat.padding.container;
const chatMessagePadding = componentSpacing.chat.padding.message;
const chatGap = componentSpacing.chat.gap;
---

<div id="chat-container" class="fixed bottom-4 right-4 z-50 flex flex-col">
  <!-- Chat toggle button with hardcoded hexadecimal color background -->
  <button 
    id="chat-toggle" 
    class="ml-auto p-3 rounded-full shadow-lg transition-all duration-300"
    style={`margin-bottom: ${chatMarginBottom}; background-color: #b9d6f2; color: #000f2e;`}
    aria-label="Toggle chat"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
  </button>
  
  <!-- Chat box (hidden by default) with hardcoded background -->
  <div 
    id="chat-box" 
    class="hidden rounded-lg shadow-xl w-80 md:w-96 overflow-hidden flex-col transition-all duration-300 max-h-[500px]"
  >
    <!-- Chat header with hardcoded colors -->
    <div style={`padding: ${chatPadding}; color: #000f2e;`} class="flex justify-between items-center">
      <h3 class="font-medium team-dark-default" id="chatbox-name">Prometheus AI</h3>
      <button id="close-chat" style="color: #000f2e;" class="hover:opacity-80 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <!-- Chat messages with hardcoded background -->
    <div id="chat-messages" class="flex-grow overflow-y-auto flex flex-col min-h-[250px]" style={`padding: ${chatPadding}; gap: ${chatGap}; `}>
      <div class="chat-message self-start max-w-[80%] rounded-lg shadow-sm" style={`padding: ${chatMessagePadding}; background-color: #f1f5f9;`}>
        <p class="text-sm" style="color: #1e293b;">Hi, I’m Prometheus AI 😊<br>Here to share trusted info about prostate cancer—ask me anything!</p>
        <span class="text-xs mt-1 block" style="color: #64748b; opacity: 0.7;">Support team, just now</span>
      </div>
    </div>
    
    <!-- Chat input with hardcoded colors -->
    <div style={`padding: ${chatPadding}; border-top: 1px solid #e2e8f0;`}>
      <form id="chat-form" class="flex gap-2">
        <input 
          type="text" 
          id="chat-input" 
          class="team-dark-default flex-grow rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2"
          style="border: 1px solid #e2e8f0;"
          placeholder="Type your message..."
          required
        />
        <button 
          type="submit" 
          class="team-dark-default px-4 py-2 rounded-lg text-sm transition-colors"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    const chatToggle = document.getElementById('chat-toggle');
    const chatBox = document.getElementById('chat-box');
    const closeChat = document.getElementById('close-chat');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');
    const chatContainer = document.getElementById('chat-container');
    
    // Toggle chat visibility
    chatToggle?.addEventListener('click', () => {
      chatBox?.classList.toggle('hidden');
      // If chat is now visible, focus the input
      if (!chatBox?.classList.contains('hidden')) {
        chatInput?.focus();
      }
    });
    
    // Close chat
    closeChat?.addEventListener('click', () => {
      chatBox?.classList.add('hidden');
    });
    
    // Close chat when clicking outside
    document.addEventListener('click', (e) => {
      const themeToggle = document.getElementById('theme-toggle');
      // Check if chat is visible
      if (chatBox && !chatBox.classList.contains('hidden')) {
        // Check if the click is outside the chat container
        if (
          !chatContainer?.contains(e.target as Node) &&
          !themeToggle?.contains(e.target as Node)
      ) {
          chatBox.classList.add('hidden');
        }
      }
    });
    
    // Prevent clicks inside the chat from closing it
    chatContainer?.addEventListener('click', (e) => {
      e.stopPropagation();
    });
    
    // Handle form submission
    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const message = (chatInput as HTMLInputElement)?.value.trim();
      if (!message) return;
      
      // Add user message to chat
      addMessage(message, 'user');
      
      // Clear input
      if (chatInput) (chatInput as HTMLInputElement).value = '';
      
      // Simulate response (replace with actual API call in production)
      setTimeout(() => {
        addMessage('🚧 This feature is still under development. Please check back later! Thank you!', 'support');
      }, 1000);
    });
    
    // Function to add a message to the chat
    function addMessage(text: string, sender: 'user' | 'support') {
      if (!chatMessages) return;
      
      const messageDiv = document.createElement('div');
      
      // Use hardcoded hex colors for styling
      if (sender === 'user') {
        messageDiv.className = 'chat-message rounded-lg max-w-[80%] shadow-sm self-end';
        messageDiv.style.backgroundColor = '#dbeafe'; // Light blue for user messages
      } else {
        messageDiv.className = 'chat-message rounded-lg max-w-[80%] shadow-sm self-start';
        messageDiv.style.backgroundColor = '#f1f5f9'; // Light gray for support messages
      }
      
      messageDiv.style.padding = '0.75rem';
      
      const messageText = document.createElement('p');
      messageText.className = 'text-sm';
      messageText.style.color = '#1e293b'; // Dark slate for text
      messageText.textContent = text;
      
      const messageTime = document.createElement('span');
      messageTime.className = 'text-xs mt-1 block';
      messageTime.style.color = '#64748b'; // Slate for timestamp
      messageTime.style.opacity = '0.7';
      messageTime.textContent = sender === 'user' ? 'You, just now' : 'Support team, just now';
      
      messageDiv.appendChild(messageText);
      messageDiv.appendChild(messageTime);
      
      chatMessages.appendChild(messageDiv);
      
      // Scroll to bottom
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  });
</script>
