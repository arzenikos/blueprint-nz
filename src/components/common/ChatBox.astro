---
// ChatBox.astro - A simple chat interface component
import { componentSpacing } from '../../styles/spacing';

// Get spacing values from centralized file
const chatMarginBottom = componentSpacing.chat.margin.bottom;
const chatPadding = componentSpacing.chat.padding.container;
const chatMessagePadding = componentSpacing.chat.padding.message;
const chatGap = componentSpacing.chat.gap;
---

<div id="chat-container" class="fixed bottom-4 right-4 z-50 flex flex-col">
  <!-- Chat toggle button with primary color background -->
  <button 
    id="chat-toggle" 
    class="ml-auto p-3 rounded-full shadow-lg transition-all duration-300 bg-primary dark:bg-accent text-secondary dark:text-neutral"
    style={`margin-bottom: ${chatMarginBottom};`}
    aria-label="Toggle chat"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>
  </button>
  
  <!-- Chat box (hidden by default) with background from theme -->
  <div 
    id="chat-box" 
    class="hidden rounded-lg shadow-xl w-80 md:w-96 overflow-hidden flex-col transition-all duration-300 max-h-[500px] bg-card border-card-border"
  >
    <!-- Chat header -->
    <div class="bg-primary dark:bg-accent text-secondary dark:text-neutral flex justify-between items-center" style={`padding: ${chatPadding};`}>
      <h3 class="font-medium">Chat with us</h3>
      <button id="close-chat" class="text-secondary dark:text-neutral hover:opacity-80 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <!-- Chat messages -->
    <div id="chat-messages" class="flex-grow overflow-y-auto flex flex-col min-h-[250px] bg-background" style={`padding: ${chatPadding}; gap: ${chatGap};`}>
      <div class="chat-message bg-muted self-start max-w-[80%] rounded-lg shadow-sm" style={`padding: ${chatMessagePadding};`}>
        <p class="text-sm text-foreground">Hello! How can we help you today?</p>
        <span class="text-xs opacity-70 mt-1 block text-foreground">Support team, just now</span>
      </div>
    </div>
    
    <!-- Chat input -->
    <div class="border-t border-border bg-card" style={`padding: ${chatPadding};`}>
      <form id="chat-form" class="flex gap-2">
        <input 
          type="text" 
          id="chat-input" 
          class="flex-grow border border-border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary bg-background text-foreground"
          placeholder="Type your message..."
          required
        />
        <button 
          type="submit" 
          class="bg-accent hover:bg-accent-dark text-accent-content px-4 py-2 rounded-lg text-sm transition-colors"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    const chatToggle = document.getElementById('chat-toggle');
    const chatBox = document.getElementById('chat-box');
    const closeChat = document.getElementById('close-chat');
    const chatForm = document.getElementById('chat-form');
    const chatInput = document.getElementById('chat-input');
    const chatMessages = document.getElementById('chat-messages');
    const chatContainer = document.getElementById('chat-container');
    
    // Toggle chat visibility
    chatToggle?.addEventListener('click', () => {
      chatBox?.classList.toggle('hidden');
      // If chat is now visible, focus the input
      if (!chatBox?.classList.contains('hidden')) {
        chatInput?.focus();
      }
    });
    
    // Close chat
    closeChat?.addEventListener('click', () => {
      chatBox?.classList.add('hidden');
    });
    
    // Close chat when clicking outside
    document.addEventListener('click', (e) => {
      // Check if chat is visible
      if (chatBox && !chatBox.classList.contains('hidden')) {
        // Check if the click is outside the chat container
        if (!chatContainer?.contains(e.target as Node)) {
          chatBox.classList.add('hidden');
        }
      }
    });
    
    // Prevent clicks inside the chat from closing it
    chatContainer?.addEventListener('click', (e) => {
      e.stopPropagation();
    });
    
    // Handle form submission
    chatForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const message = (chatInput as HTMLInputElement)?.value.trim();
      if (!message) return;
      
      // Add user message to chat
      addMessage(message, 'user');
      
      // Clear input
      if (chatInput) (chatInput as HTMLInputElement).value = '';
      
      // Simulate response (replace with actual API call in production)
      setTimeout(() => {
        addMessage('Thank you for your message. Our team will get back to you soon!', 'support');
      }, 1000);
    });
    
    // Function to add a message to the chat
    function addMessage(text: string, sender: 'user' | 'support') {
      if (!chatMessages) return;
      
      const messageDiv = document.createElement('div');
      
      // Use CSS variables for styling to match theme
      if (sender === 'user') {
        messageDiv.className = 'chat-message rounded-lg max-w-[80%] shadow-sm self-end';
        messageDiv.style.backgroundColor = 'var(--color-primary-light)';
      } else {
        messageDiv.className = 'chat-message rounded-lg max-w-[80%] shadow-sm self-start';
        messageDiv.style.backgroundColor = 'var(--color-muted)';
      }
      
      messageDiv.style.padding = '0.75rem';
      
      const messageText = document.createElement('p');
      messageText.className = 'text-sm';
      messageText.style.color = 'var(--color-foreground)';
      messageText.textContent = text;
      
      const messageTime = document.createElement('span');
      messageTime.className = 'text-xs mt-1 block';
      messageTime.style.color = 'var(--color-foreground)';
      messageTime.style.opacity = '0.7';
      messageTime.textContent = sender === 'user' ? 'You, just now' : 'Support team, just now';
      
      messageDiv.appendChild(messageText);
      messageDiv.appendChild(messageTime);
      
      chatMessages.appendChild(messageDiv);
      
      // Scroll to bottom
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
  });
</script>
