---
import { getNetlifyContext } from '../../lib/utils/netlify';

interface Props {
  class?: string;
  addedChecksFunction?: (ctx: string) => string | null;
}

const { class: className = '', addedChecksFunction } = Astro.props;

const ctx = getNetlifyContext();
let message = '';

if (ctx === 'dev') {
  message = 'You are viewing this site in local development mode.';
} else if (ctx === 'preview') {
  message = 'You are viewing a preview deployment of this site.';
} else if (ctx === 'prod') {
  message = 'You are viewing the production version of this site.';
}

// Add any additional context-specific messages
if (addedChecksFunction && typeof addedChecksFunction === 'function') {
  const additionalMessage = addedChecksFunction(ctx);
  if (additionalMessage) {
    message += ' ' + additionalMessage;
  }
}
---

{message && (
  <div class={`bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4 ${className}`} role="alert">
    <p class="font-medium">Context: {ctx}</p>
    <p>{message}</p>
  </div>
)}
