---
import Layout from '../../layouts/Layout.astro';
import MainPageHeading from '../layout/MainPageHeading.astro';
import ResourceGrid from './ResourceGrid.astro';
import hubs from '../../data/hubs.json';
import resources from '../../data/resources.json';

interface Props {
  audience: keyof typeof hubs;
}

const { audience } = Astro.props;
const hub = hubs[audience];
const categories = hub.categories.map((key) => ({
  key,
  ...resources.contentByCategory[key as keyof typeof resources.contentByCategory],
}));
---

<Layout title={hub.pageTitle} description={hub.description}>
  <div class="container mx-auto px-4 pb-20 pt-10">
    <MainPageHeading
      heading={hub.title}
      description={hub.intro}
      breadcrumbItems={[
        { label: 'Home', href: '/', current: false },
        { label: hub.title, href: `/${audience}`, current: true },
      ]}
    />
    {categories.map((category) => (
      <ResourceGrid title={category.title} parentLink={category.parentLink} items={category.data} />
    ))}
  </div>
</Layout>
