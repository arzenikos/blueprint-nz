---
import Card from '../ui/Card.astro';
import { resourceCardConfig } from '../../lib/types/CardLibrary';
import { slugify } from '../../lib/utils/slug';

interface ResourceItem {
  heading: string;
  content: string[];
  cardStatus: string;
}

interface Props {
  title: string;
  parentLink: string;
  items: ResourceItem[];
}

const { title, parentLink, items } = Astro.props;
const { icon, textClass, color, extraConfig } = resourceCardConfig;
---

<section class="mb-16">
  <h2 class="mb-6 text-2xl font-semibold text-[var(--color-palette-five)]">{title}</h2>
  <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
    {items.map((item, index) => (
      <Card
        heading={item.heading}
        content={item.content}
        icon={icon}
        textClass={textClass}
        color={color}
        config={extraConfig}
        index={index}
        cardStatus={item.cardStatus}
        link={`/${parentLink}/${slugify(item.heading)}`}
      />
    ))}
  </div>
</section>
