---
import Icon from '../icons/Icon.astro';
import type { NavItem as NavItemType } from '../../data/navigation';
import ThemeToggle from '../shared/ThemeToggle.astro';

interface Props extends NavItemType {
  iconSize?: number;
}

const { 
  label, 
  href, 
  icon, 
  mobileOnly = false, 
  desktopOnly = false,
  isDropdown = false,
  dropdownItems = [],
  iconSize = 16
} = Astro.props;

const visibilityClass = mobileOnly 
  ? 'md:hidden' 
  : desktopOnly 
    ? 'hidden md:flex' 
    : '';

const id = `nav-item-${label.toLowerCase().replace(/\s+/g, '-')}`;
---

{icon === 'theme' ? (
  <div class={`flex items-center text-secondary ${visibilityClass} py-2`}>
    <ThemeToggle />
  </div>
) : isDropdown ? (
  <div class={`relative group ${visibilityClass}`}>
    <button id={id} class="flex items-center text-secondary py-2 focus:outline-none">
      <span class="hidden sm:inline-block text-sm font-medium mr-2">{label}</span>
      <Icon name={icon} size={iconSize} class="sm:w-3 sm:h-3" />
      <Icon name="chevron-down" size={12} class="ml-1 mt-0.5" />
    </button>
    
    <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg overflow-hidden z-20 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300">
      <div class="py-1">
        {dropdownItems.map(item => (
          <button 
            class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors" 
            data-value={item.value}
          >
            {item.label}
          </button>
        ))}
      </div>
    </div>
  </div>
) : (
  <a href={href} class={`flex items-center text-secondary ${visibilityClass} py-2`}>
    <span class="hidden sm:inline-block text-sm font-medium mr-2">{label}</span>
    <Icon name={icon} size={iconSize} class="sm:w-3 sm:h-3" />
  </a>
)}

<script define:vars={{ id, label }}>
  // Add event listeners for dropdowns
  document.addEventListener('DOMContentLoaded', () => {
    const dropdown = document.getElementById(id);
    if (dropdown) {
      const buttons = dropdown.parentElement?.querySelectorAll('button[data-value]');
      
      buttons?.forEach(button => {
        button.addEventListener('click', (e) => {
          const value = button.getAttribute('data-value');
          
          // Handle different dropdown types
          if (label === 'Language') {
            console.log(`Language changed to: ${value}`);
            // Implement language change logic here
          } 
          else if (label === 'Font Size') {
            console.log(`Font size changed to: ${value}`);
            
            // Remove existing font size classes
            document.documentElement.classList.remove('text-sm', 'text-base', 'text-lg');
            
            // Add new font size class
            switch(value) {
              case 'small':
                document.documentElement.classList.add('text-sm');
                break;
              case 'medium':
                document.documentElement.classList.add('text-base');
                break;
              case 'large':
                document.documentElement.classList.add('text-lg');
                break;
            }
            
            // Store preference
            localStorage.setItem('fontSizePreference', value);
          }
        });
      });
    }
  });
  
  // Initialize font size from stored preference
  const storedFontSize = localStorage.getItem('fontSizePreference');
  if (storedFontSize) {
    switch(storedFontSize) {
      case 'small':
        document.documentElement.classList.add('text-sm');
        break;
      case 'medium':
        document.documentElement.classList.add('text-base');
        break;
      case 'large':
        document.documentElement.classList.add('text-lg');
        break;
    }
  }
</script>
