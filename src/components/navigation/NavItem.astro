---
import Icon from '../icons/Icon.astro';
import type { NavItem as NavItemType } from '../../data/navigation';

interface Props extends NavItemType {
  iconSize?: number;
}

const { 
  label, 
  href, 
  icon, 
  mobileOnly = false, 
  desktopOnly = false,
  iconSize = 16
} = Astro.props;

const visibilityClass = mobileOnly 
  ? 'md:hidden' 
  : desktopOnly 
    ? 'hidden md:flex' 
    : '';
---

<a href={href} class={`flex items-center text-secondary ${visibilityClass} py-2`}>
  <span class="hidden sm:inline-block text-sm font-medium mr-2">{label}</span>
  <Icon name={icon} size={iconSize} class="sm:w-3 sm:h-3" />
</a>
