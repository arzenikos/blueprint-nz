---
// <!-- Imported by: components/navigation/MainNav.astro -->
import Icon from '../icons/Icon.astro';
import type { NavItem as NavItemType } from '../../data/navigation';
import ThemeToggle from '../shared/ThemeToggle.astro';

interface Props extends NavItemType {
  iconSize?: number;
}

const { 
  label, 
  href, 
  icon, 
  mobileOnly = false, 
  desktopOnly = false,
  isButtonGroup = false,
  // dropdownItems = [],
  buttonItems = [],
  iconSize = 16
} = Astro.props;

const visibilityClass = mobileOnly 
  ? 'md:hidden' 
  : desktopOnly 
    ? 'hidden md:flex' 
    : '';

const id = `nav-item-${label.toLowerCase().replace(/\s+/g, '-')}`;
---

{icon === 'theme' ? (
  <div class={`flex items-center text-secondary ${visibilityClass} py-2`}>
    <ThemeToggle />
  </div>
) : isButtonGroup ? (
  <div class={`flex items-center ${visibilityClass}`}>
    <span class="hidden sm:inline-block text-sm font-medium">{label}</span>
    <div class="flex border border-gray-200 rounded-md overflow-hidden" id={id}>
      {buttonItems.map((item, index) => {
        // Adjust font sizes for the buttons themselves to make the difference more visible
        const fontSize =
        item.value === 'small' ? 'text-xs' :
        item.value === 'medium' ? 'text-sm' :
        'text-base font-bold';
        return (
          <button 
            class={`px-4 py-1 ${fontSize} transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-opacity-50`}
            data-value={item.value}
            aria-label={item.ariaLabel}
          >
            {item.label}
          </button>
        );
      })}
    </div>
  </div>
)  : (
  <a href={href} class={`flex items-center text-secondary ${visibilityClass} py-2`}>
    <span class="hidden sm:inline-block text-sm font-medium mr-2">{label}</span>
    <Icon name={icon} size={iconSize} class="sm:w-3 sm:h-3" />
  </a>
)}

<script define:vars={{ id, label }}>
  // Add event listeners for dropdowns and button groups
  document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById(id);
    
    if (element) {
      const buttons = element.querySelectorAll('button[data-value]');
      
      // Set active state based on stored preference
      if (label === 'Font Size') {
        const storedFontSize = localStorage.getItem('fontSizePreference') || 'medium';
        buttons.forEach(button => {
          if (button.getAttribute('data-value') === storedFontSize) {
            button.classList.add('bg-gray-100');
          }
        });
      }
      
      buttons.forEach(button => {
        button.addEventListener('click', (e) => {
          const value = button.getAttribute('data-value');
          
          if (label === 'Font Size') {
            console.log(`Font size changed to: ${value}`);
            
            // Remove existing font size classes
            document.documentElement.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');
            
            // Add new font size class
            switch(value) {
              case 'small':
                document.documentElement.classList.add('text-sm');
                break;
              case 'medium':
                document.documentElement.classList.add('text-base');
                break;
              case 'large':
                document.documentElement.classList.add('text-xl'); // Changed from text-lg to text-xl for larger size
                break;
            }
            
            // Update active state
            buttons.forEach(btn =>{
            btn.classList.remove('bg-gray-100')
            btn.classList.remove('text-gray-900')
          });
            button.classList.add('bg-gray-100');
            button.classList.add('text-gray-900');
            
            // Store preference
            localStorage.setItem('fontSizePreference', value);
          }
        });
      });
    }
  });
  
  // Initialize font size from stored preference
  const storedFontSize = localStorage.getItem('fontSizePreference');
  if (storedFontSize) {
    switch(storedFontSize) {
      case 'small':
        document.documentElement.classList.add('text-sm');
        break;
      case 'medium':
        document.documentElement.classList.add('text-base');
        break;
      case 'large':
        document.documentElement.classList.add('text-xl'); // Changed from text-lg to text-xl for larger size
        break;
    }
  }
</script>
