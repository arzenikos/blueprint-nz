---
import { mainNavItems } from '../../data/navigation';
import NavItem from './NavItem.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`flex items-center space-x-1 sm:space-x-5 ${className}`}>
  {mainNavItems.map(item => (
    <NavItem {...item} />
  ))}
</div>
