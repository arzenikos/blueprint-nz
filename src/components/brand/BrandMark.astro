---
import pamanaLogo from '../../assets/images/logo/pamana-logo.png';

interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
}

const { href = '/', size = 'md', alt = 'Pamana logo' } = Astro.props;
---

<a href={href} class:list={['brand-mark', `brand-mark--${size}`]} aria-label="Pamana home">
  <img src={pamanaLogo.src} alt={alt} width="88" height="88" />
</a>

<style>
  .brand-mark {
    display: inline-flex;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand-mark img {
    display: block;
    height: auto;
    border-radius: 12px;
  }

  .brand-mark--sm img { width: 40px; }
  .brand-mark--md img { width: 56px; }
  .brand-mark--lg img { width: 88px; }
</style>
