---
interface Props {
  pixelSize?: number;
}

const { pixelSize = 3 } = Astro.props;

const pattern: number[][] = [
  // 7 columns wide, 12 rows tall
  [0, 0, 3, 3, 3, 0, 0],  // 0 top highlight
  [0, 2, 2, 2, 2, 2, 0],  // 1 main upper body
  [1, 1, 0, 0, 0, 1, 1],  // 2 side shadows
  [1, 2, 2, 2, 2, 2, 1],  // 3 main body
  [0, 0, 3, 3, 3, 0, 0],  // 4 highlight center
  [0, 2, 0, 0, 0, 2, 0],  // 5 tail start
  [1, 0, 0, 0, 0, 0, 1],  // 6 tail diagonal out
  [0, 2, 0, 0, 0, 2, 0],  // 7 tail center
  [1, 0, 0, 0, 0, 0, 1],  // 8 tail diagonal out
  [0, 2, 0, 0, 0, 2, 0],  // 9 tail center
  [1, 0, 0, 0, 0, 0, 1],  // 10 tail diagonal out
//   [0, 0, 1, 0, 1, 0, 0],  // 11 tail bottom tips
];

function getColorClass(val: number): string {
  switch (val) {
    case 1:
      return 'bg-blue-800';
    case 2:
      return 'bg-blue-600';
    case 3:
      return 'bg-blue-400';
    default:
      return 'bg-transparent';
  }
}
---

<div
  class="inline-grid"
  style={`grid-template-columns: repeat(${pattern[0].length}, ${pixelSize}px);`}
>
  {
    pattern.flat().map((val, i) => (
      <div
        class={`${getColorClass(val)}`}
        style={`width: ${pixelSize}px; height: ${pixelSize}px;`}
      />
    ))
  }
</div>
