---
// <!-- Referenced by: components/layout/footer/Footer.astro -->
interface Props {
  title: string;
  links: {
    label: string;
    href: string;
  }[];
  index: number;
}

const { title, links, index } = Astro.props;
---

<div>
  <h3 class="text-sm font-semibold text-white mb-3">{title}</h3>
  <ul class="space-y-2">
    {links.map(link => (
      <li>
        <a href={link.href} class="text-xs text-neutral/80 dark:text-gray-300 hover:text-white transition-colors">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>
