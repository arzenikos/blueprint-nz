<!-- Imported by: components/layout/Footer.astro -->
---
interface Link {
  text: string;
  url: string;
}

interface Props {
  title: string;
  links: Link[];
  index: number;
}

const { title, links, index } = Astro.props;
---

<section class="flex flex-col">
  <h2 id={`footerHeading${index}`} class="mb-4 text-neutral font-semibold text-sm dark:text-gray-300">
    {title}
  </h2>
  <ul aria-labelledby={`footerHeading${index}`} class="flex flex-col gap-2.5">
    {links.map(link => (
      <li>
        <a href={link.url} class="footer-link text-xs dark:text-gray-300">
          {link.text}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  h2 {
    color: white;
  }
</style>
