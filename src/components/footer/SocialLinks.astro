---
// <!-- Imported by: components/layout/Footer.astro -->
import Icon from '../icons/Icon.astro';

interface SocialLink {
  platform: string;
  url: string;
  ariaLabel: string;
}

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---
<div class="flex items-start gap-3">
  {links.map(social => (
    <a href={social.url} aria-label={social.ariaLabel}>
      <span class="sr-only">{social.ariaLabel}</span>
      <Icon name={social.platform} size={16} />
    </a>
  ))}
</div>
