---
import Icon from '../icons/Icon.astro';

interface SocialLink {
  platform: string;
  url: string;
  ariaLabel: string;
}

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---

<div class="flex items-center gap-3">
  {links.map(social => (
    <a href={social.url} class="text-neutral hover:text-secondary" aria-label={social.ariaLabel}>
      <span class="sr-only">{social.ariaLabel}</span>
      <Icon name={social.platform} size={16} />
    </a>
  ))}
</div>
