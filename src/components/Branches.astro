---
const { buttonLabel = "Show", branches = [], initiallyVisible = false } = Astro.props;
---

<style>
  .hidden {
    display: none;
  }

  .branch {
    padding: 0.5rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    background-color: #f3f4f6;
    margin-bottom: 0.5rem;
  }

  .child {
    margin-left: 1rem;
    background-color: #e5e7eb;
  }

  .icon {
    margin-right: 0.5rem;
  }
</style>

<div>
  <!-- Level 2 -->
  <button class="toggle-button" data-target="#level-2-a">Toggle A</button>
  <button id="level-2-a" class="hidden toggle-button" data-target=".level-3a">Content A</button>
  <button id="level-3a-a" class="hidden level-3a">Content A1</button>
  <button id="level-3a-b" class="hidden level-3a">Content A2</button>

  <button class="toggle-button" data-target="#level-2-b">Toggle B</button>
  <button id="level-2-b" class="hidden toggle-button" data-target=".level-3b">Content B</button>
  <button id="level-3b-a" class="hidden level-3b">Content B1</button>
  <button id="level-3b-b" class="hidden level-3b">Content B2</button>
  <button id="level-3b-c" class="hidden level-3b">Content B3</button>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    function setupToggleButtons() {
      const buttons = document.querySelectorAll('.toggle-button');

      buttons.forEach((btn) => {
        const selector = btn.getAttribute('data-target');
        if (!selector) return;

        const targets = document.querySelectorAll(selector);

        btn.addEventListener('click', () => {
          targets.forEach((el) => {
            el.classList.toggle('hidden');
          });
        });
      });
    }

    setupToggleButtons();
  });
</script>


