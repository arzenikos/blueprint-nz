---
import type { ComponentProps } from 'astro/types';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icons.astro';

const navItems = [
  // { linkText: 'Support Groups', href: '/support-group' }, // 
  // { linkText: 'Whanau Support', href: '/family-support' }, // 
  // { linkText: 'Newsletter', href: '/newsletter' }, // evalidation
  // { linkText: 'Shop', href: '/shop' },
  // { linkText: 'Settings', href: '/settings' }, //image-cdn
  // { linkText: 'About', href: '/about' }, //edge
];
---

<nav class="flex flex-wrap items-center justify-between w-full gap-6 pt-6 pb-12 sm:pt-8 sm:pb-16">
    <a href="/" class="flex items-center">
        <Logo />
    </a>
    {
      !!navItems?.length && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {navItems.map((item) => (
                <li>
                    <a href={item.href} class="inline-block px-2 py-1 sm:px-3 sm:py-2">
                        {item.linkText}
                    </a>
                </li>
            ))}
        </ul>
      )
    }
    <div class="flex items-center gap-4">
      <Icon icon="switch-light-theme" />
    </div>
</nav>
