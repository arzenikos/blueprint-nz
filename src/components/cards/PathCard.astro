---
import PlaceholderMedia from '../media/PlaceholderMedia.astro';

interface Props {
  href: string;
  title: string;
  body: string;
  iconLabel: string;
}

const { href, title, body, iconLabel } = Astro.props;
---

<a class="path-card" href={href}>
  <PlaceholderMedia label={iconLabel} />
  <h2>{title}</h2>
  <p>{body}</p>
</a>

<style>
  .path-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 340px;
    padding: 1.6rem 1.4rem 1.8rem;
    background: var(--color-card);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--color-navy);
    box-sizing: border-box;
  }

  .path-card :global(.placeholder-media) {
    min-height: 110px;
    background: transparent;
    border: 0;
  }

  h2 {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.35;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .path-card:hover {
    transform: translateY(-2px);
  }
</style>
