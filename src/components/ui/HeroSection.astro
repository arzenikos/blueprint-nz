---
import Button from './button/Button.astro';

interface Props {
  title: string;
  description: string;
  primaryButton?: {
    text: string;
    href: string;
  };
  secondaryButton?: {
    text: string;
    href: string;
  };
  image: string;
  imageAlt: string;
  reversed?: boolean;
}

const { 
  title, 
  description, 
  primaryButton, 
  secondaryButton, 
  image, 
  imageAlt,
  reversed = false 
} = Astro.props;
---

<section class="bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-800 py-16 md:py-24 theme-transition">
  <div class="container mx-auto px-6">
    <div class={`flex flex-col ${reversed ? 'md:flex-row-reverse' : 'md:flex-row'} items-center justify-between gap-12`}>
      <div class="md:w-1/2">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
          {title}
        </h1>
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-8">
          {description}
        </p>
        {(primaryButton || secondaryButton) && (
          <div class="flex flex-wrap gap-4">
            {primaryButton && (
              <Button variant="primary" size="lg" href={primaryButton.href}>
                {primaryButton.text}
              </Button>
            )}
            {secondaryButton && (
              <Button variant="outline" size="lg" href={secondaryButton.href}>
                {secondaryButton.text}
              </Button>
            )}
          </div>
        )}
      </div>
      <div class="md:w-1/2">
        <img 
          src={image} 
          alt={imageAlt} 
          class="rounded-lg shadow-lg w-full h-auto"
        />
      </div>
    </div>
  </div>
</section>
