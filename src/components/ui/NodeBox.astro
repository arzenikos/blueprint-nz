---
// <!-- Code from: https://gojs.net/latest/samples/incrementalTree.html -->
const { label, childCount } = Astro.props;
---
<script src="https://cdn.jsdelivr.net/npm/gojs@3.0.24/release/go.js"></script>

<div id="sample" data-child-count={childCount}>
  <div id="blueNodeDiagram" style="background-color: var(--color-palette-one); width: 100%; height: 700px"></div>
</div>

<script id="code">
  function init() {

    bluenode = new go.Diagram('blueNodeDiagram', {
      initialContentAlignment: go.Spot.TopCenter,
      layout: new go.TreeLayout({
        angle: 90,              // expands downward (0 = right, 90 = down, 180 = left, 270 = up)
        arrangement: go.TreeLayout.ArrangementVertical,
        layerSpacing: 40,
        nodeSpacing: 40
      }),
      // 'commandHandler.copiesTree': true,
      // 'commandHandler.deletesTree': true,
      // 'draggingTool.dragsTree': false,
      // 'undoManager.isEnabled': true
    });
    // Define the Node template.
    // bluenode.nodeTemplate = new go.Node('Spot', {
    //   selectionObjectName: 'PANEL',
    //   isTreeExpanded: false,
    //   isTreeLeaf: false,
    //   click: (e, node) => {
    //   e.handled = true;
    //   expandNode(node);
    // }
    // })
    bluenode.nodeTemplate = new go.Node('Spot', {
      selectionObjectName: 'PANEL',
      isTreeExpanded: false,
      isTreeLeaf: false,
      click: (e, node) => {
        e.handled = true;
        expandNode(node); // handles all levels
      }
    }).add(
      new go.Panel('Auto', { name: 'PANEL' }).add(
        new go.Shape('RoundedRectangle', {
          height: 40,
          fill: 'whitesmoke',
          stroke: 'white'
        }).bind('rootdistance', dist => dist === 0 ? 160 : 80),
        new go.TextBlock({
          font: '10pt sans-serif',
          margin: 4,
          overflow: go.TextBlock.OverflowEllipsis,
          wrap: go.TextBlock.WrapFit,
          textAlign: 'center'
        }).bind('text', '', data => data.text || data.key)
      )
    )
    // the node's outer shape, which will surround the text
    // .add(
    // new go.Panel('Auto')
    //   .add(
    //     new go.Shape('RoundedRectangle', { height: 30, fill: 'whitesmoke', stroke: 'white' }),
    //     new go.TextBlock({ font: '10pt sans-serif', margin: 1, overflow: go.TextBlock.OverflowEllipsis, wrap: go.TextBlock.WrapFit, textAlign: 'center'})
    //       // .bind('text', 'key')
    //       .bind('text', '', (data) => data.text || data.key)

    //   ),
    //   // go.GraphObject.make("TreeExpanderButton")
    // );

    bluenode.model = new go.TreeModel(
      [
        {
          key: "Prostate Cancer",
          text: "What is Prostate Cancer?",
          color: '#FFFF',
          everExpanded: false
        }
      ]
    );
  }

  function expandNode(node) {
    const diagram = node.diagram;
    diagram.startTransaction('CollapseExpandTree');

    const data = node.data;
    const parent = node.findTreeParentNode();

    // 1. Collapse all siblings (including self for safety, will re-expand if needed)
    if (parent) {
      parent.findTreeChildrenNodes().each((sibling) => {
        if (sibling !== node && sibling.isTreeExpanded) {
          diagram.commandHandler.collapseTree(sibling);
        }
      });
    }

    // 2. Only expand if not already expanded
    if (!data.everExpanded) {
      diagram.model.setDataProperty(data, 'everExpanded', true);
      const numchildren = createSubTree(data);
      if (numchildren === 0) {
        const treeButton = node.findObject('TREEBUTTON');
        if (treeButton) treeButton.visible = false;
      }
    }

    // 3. Expand or collapse the clicked node depending on its state
    if (node.isTreeExpanded) {
      diagram.commandHandler.collapseTree(node);
    } else {
      diagram.commandHandler.expandTree(node);
    }
    diagram.commitTransaction('CollapseExpandTree');
  }

  // function getChildCount() {
  //   // const countAttr = customTexts[parentdata.key].length;
  //   const countAttr = document.getElementById('sample').dataset.childCount;
  //   const parsed = parseInt(countAttr, 6);
  //   return isNaN(parsed) ? 2 : parsed;
  // }

  function createSubTree(parentdata) {
    var numchildren = customTexts[parentdata.key].length -1;//getChildCount(); 
    if (bluenode.nodes.count <= 1) {
      numchildren += 1; 
    }
    // create several node data objects and add them to the model
    var model = bluenode.model;
    var parent = bluenode.findNodeForData(parentdata);

    var degrees = 1;
    var grandparent = parent.findTreeParentNode();
    while (grandparent) {
      degrees++;
      grandparent = grandparent.findTreeParentNode();
    }
    
    
    var titles = customTexts[parentdata.key] || [];
    
    for (var i = 0; i < numchildren; i++) {
      var label = titles[i] || `Unnamed child ${i + 1}`;

      var childdata = {
        key: `${parentdata.key}-${i + 1}`,
        text: label,
        parent: parentdata.key,
        rootdistance: degrees,
        everExpanded: false // important!
      };
      model.addNodeData(childdata);
      var child = bluenode.findNodeForData(childdata);
      child.location = parent.location;
    }
    return numchildren;
  }
  window.addEventListener('DOMContentLoaded', init);

  const customTexts = {
    "Prostate Cancer": ["Early Detection", "Treatment Options"],
    "Prostate Cancer-1": ["PSA", "Digital Rectal Exam"],
    "Prostate Cancer-2": ["Radiation", "Surgery"]
  };

</script>