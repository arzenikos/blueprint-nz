---
const { label } = Astro.props;
import Branches from '../../components/Branches.astro';
import { bluenodeBranchData } from '../../content/bluenode';

---
<Branches branches={bluenodeBranchData} />

<div class="rounded-lg bg-accent flex items-center justify-center shadow-lg px-4 py-2 min-w-[140px]" style="background: var(--color-palette-four);">
  <span class="font-semibold text-center" style="color: var(--color-palette-two);">{label}</span>
</div>
