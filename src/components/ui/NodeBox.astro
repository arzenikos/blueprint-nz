---
const { label } = Astro.props;
import { bluenodeBranchData } from '../../content/bluenode';
---

<div class="rounded-lg bg-accent flex items-center justify-center shadow-lg px-4 py-2 min-w-[140px]" style="background: var(--color-palette-four);">
  <!-- <Branches branches={label} /> -->
  <button class="toggle-button font-semibold text-center" data-target="#level-2-a" style="color: var(--color-palette-two);">{label}</button>
</div>
<div>
  <button id="level-2-a" class="hidden toggle-button bg-white" data-target=".level-3a">Content A</button>
</div>
<div>
  <button id="level-3a-a" class="hidden level-3a">Content A1</button>
  <button id="level-3a-b" class="hidden level-3a">Content A2</button>
</div>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    function setupToggleButtons() {
      const buttons = document.querySelectorAll('.toggle-button');

      buttons.forEach((btn) => {
        const selector = btn.getAttribute('data-target');
        if (!selector) return;

        const targets = document.querySelectorAll(selector);

        btn.addEventListener('click', () => {
          targets.forEach((el) => {
            el.classList.toggle('hidden');
          });
        });
      });
    }

    setupToggleButtons();
  });
</script>