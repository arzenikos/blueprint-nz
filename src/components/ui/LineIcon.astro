---
interface Props {
  name: 'mail' | 'pin' | 'help' | 'accessibility' | 'close' | 'github' | 'figma' | 'robot' | 'share' | 'bookmark' | 'external' | 'send' | 'chevron';
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'mail' && (
    <g>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3 7 9 6 9-6" />
    </g>
  )}
  {name === 'pin' && (
    <g>
      <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
      <circle cx="12" cy="10" r="2.2" />
    </g>
  )}
  {name === 'help' && (
    <g>
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <path d="M9.5 9a2.5 2.5 0 1 1 3.4 2.3c-.8.4-1.4 1-1.4 1.9" />
      <circle cx="12" cy="16.2" r="0.6" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'accessibility' && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="7.5" r="1.1" fill="currentColor" stroke="none" />
      <path d="M8 11h8M12 11v7M9.5 18l2.5-3 2.5 3" />
    </g>
  )}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'github' && (
    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3.1-.4 6.4-1.5 6.4-7A5.4 5.4 0 0 0 20 4.8 5 5 0 0 0 19.9 1S18.7.6 16 2.5a13.4 13.4 0 0 0-7 0C6.3.6 5.1 1 5.1 1A5 5 0 0 0 5 4.8 5.4 5.4 0 0 0 3.5 8.6c0 5.4 3.3 6.6 6.4 7A3.4 3.4 0 0 0 9 18.2V22" />
  )}
  {name === 'figma' && (
    <g>
      <rect x="4" y="4" width="7" height="7" rx="1" />
      <rect x="13" y="4" width="7" height="7" rx="1" />
      <rect x="4" y="13" width="7" height="7" rx="1" />
      <rect x="13" y="13" width="7" height="7" rx="1" />
    </g>
  )}
  {name === 'robot' && (
    <g>
      <rect x="6" y="8" width="12" height="10" rx="2" />
      <circle cx="12" cy="5" r="1.4" />
      <path d="M12 6.4V8" />
      <circle cx="9.5" cy="12.5" r="1" fill="currentColor" stroke="none" />
      <circle cx="14.5" cy="12.5" r="1" fill="currentColor" stroke="none" />
    </g>
  )}
  {name === 'share' && (
    <g>
      <circle cx="6" cy="12" r="2" />
      <circle cx="18" cy="6" r="2" />
      <circle cx="18" cy="18" r="2" />
      <path d="m8 11 8-4M8 13l8 4" />
    </g>
  )}
  {name === 'bookmark' && <path d="M7 4h10v16l-5-3-5 3V4z" />}
  {name === 'external' && (
    <g>
      <path d="M14 5h5v5" />
      <path d="M19 5 10 14" />
      <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
    </g>
  )}
  {name === 'send' && (
    <g>
      <rect x="4" y="6" width="16" height="12" rx="1" />
      <path d="m4 8 8 6 8-6" />
    </g>
  )}
  {name === 'chevron' && <path d="M9 6l6 6-6 6" />}
</svg>
