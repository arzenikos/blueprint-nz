---
// configs from lib/types/CardLibrary.ts
// data from content/blueindex/blueindex.ts
import Icon from '../../components/ui/Icon.astro';
const {
    heading,
    content,
    icon,
    textClass,
    color,
    config,
    index,
    link,
    image,
} = Astro.props;

const hoveredCardSize = config.hoverFx ? 'hover:scale-110' : 'hover:scale-100'
---

<div
    class={`card-container justify-center rounded-lg shadow-md transition-transform ${hoveredCardSize} ${config.layout} ${color.cardBg}`}
>
    <div>
        {image && (
            <img
                src={image}
                alt={heading}
                class={config.image}
                loading="lazy"
            />
        )}

    </div>
    <a href={link} class=`${textClass.setVariant} no-underline block`>
        <div class="rounded-full w-15 h-15 flex items-center justify-center mb-4" style=`${icon.bgColor};`>
            <!-- card icon -->
            <Icon class={icon.class} name={icon.name[index]} color={icon.textColor}/>
        </div>
        <!-- card heading -->
        <p class=`${textClass.heading} text-xl font-semibold mb-3` style=`color: ${color.heading};`>{heading}</p>
        <!-- card content -->
        {Array.isArray(content) ? (
            <ul class={`${textClass.content}`}>
                {content.map((item) => (
                <li style={`color: ${color.heading};`}>{item}</li>
                ))}
            </ul>
        ) : (
        <p>{content}</p>
        )}
    </a>
</div>