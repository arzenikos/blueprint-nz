---
interface Props {
  title?: string;
  class?: string;
  bodyClass?: string;
  titleClass?: string;
}

const { 
  title, 
  class: className = '', 
  bodyClass = '',
  titleClass = ''
} = Astro.props;
---

<div class={`card bg-base-100 shadow-sm dark:bg-gray-800 dark:border-gray-700 ${className}`}>
  <slot name="image" />
  
  <div class={`card-body ${bodyClass}`}>
    {title && <h3 class={`card-title ${titleClass}`}>{title}</h3>}
    <slot />
    
    <slot name="footer" />
  </div>
</div>
