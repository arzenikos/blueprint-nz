---
import Icon from '../../components/ui/Icon.astro';

const {
    heading,
    content,
} = Astro.props;
---

<div class="rounded-lg card-link shadow-md p-6 transition-transform hover:scale-105" style="background: var(--color-palette-four);">
    <a id="card-link" class="card-item no-underline block" style={{ textDecoration: 'none' }}>
        <div class="p-3 rounded-full w-15 h-15 flex items-center justify-center mb-4" style="background: var(--color-palette-one);">
            <Icon class="card-icon" name="chevron-right" color="var(--color-palette-five)"/>
        </div>
        <p class="card-heading text-xl font-semibold mb-3 no-underline" style="color: var(--color-palette-one);">{heading}</p>
        <ul class="card-content" style="color: var(--color-palette-two); list-style-type: disc; padding-left: 1rem;">
            {content.map((item) => (
                <li>{item}</li>
            ))}
        </ul>
    </a>
</div>
