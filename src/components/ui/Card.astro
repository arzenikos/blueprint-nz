---
import Icon from '../../components/ui/Icon.astro';
const {
    heading,
    content,
    icon,
    textClass,
    color,
    config,
    index,
    link
} = Astro.props;

const href = "#";

const hoveredCardSize = config.hoverFx ? 'hover:scale-110' : 'hover:scale-100'
---

<div
    class={`rounded-lg shadow-md transition-transform ${hoveredCardSize} ${config.layout}`}
    style="background: var(--color-palette-four);"
>
    <a href={link} class=`${textClass.setVariant} no-underline block`>
        <div class="p-3 rounded-full w-15 h-15 flex items-center justify-center mb-4" style=`background: ${icon.bgColor};`>
            <Icon class={icon.class} name={icon.name[index]} color={icon.textColor}/>
        </div>
        <p class=`${textClass.heading} text-xl font-semibold mb-3 no-underline` style=`color: ${color.heading};`>{heading}</p>
        
        {Array.isArray(content) ? (
            <ul class={`${textClass.content}`}>
                {content.map((item) => (
                <li>{item}</li>
                ))}
            </ul>
        ) : (
        <p>{content}</p>
        )}
    </a>
</div>

<style>
    li {
        color: var(--color-palette-one);
    }
</style>
