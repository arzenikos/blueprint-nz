---
import { palette } from '../../lib/themes-and-layout/color';
---

<div class="max-w-4xl mx-auto my-8 p-6 bg-neutral-100 rounded-lg">
  <h2 class="text-2xl font-bold mb-6">BluePrintNZ Color Palette</h2>
  <p class="mb-6">Our design system uses a limited palette of 5 core colors to maintain visual consistency across the entire website.</p>
  
  <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
    <!-- Primary Color -->
    <div class="flex flex-col">
      <div class="h-24 rounded-t-lg" style={`background-color: ${palette.primary};`}></div>
      <div class="bg-neutral-200 p-3 rounded-b-lg">
        <h3 class="font-medium">Primary</h3>
        <p class="text-xs font-mono mt-1">{palette.primary}</p>
        <p class="text-xs mt-1">Main brand color (light blue)</p>
      </div>
    </div>
    
    <!-- Secondary Color -->
    <div class="flex flex-col">
      <div class="h-24 rounded-t-lg" style={`background-color: ${palette.secondary};`}></div>
      <div class="bg-neutral-200 p-3 rounded-b-lg">
        <h3 class="font-medium">Secondary</h3>
        <p class="text-xs font-mono mt-1">{palette.secondary}</p>
        <p class="text-xs mt-1">Secondary brand color (dark blue)</p>
      </div>
    </div>
    
    <!-- Accent Color -->
    <div class="flex flex-col">
      <div class="h-24 rounded-t-lg" style={`background-color: ${palette.accent};`}></div>
      <div class="bg-neutral-200 p-3 rounded-b-lg">
        <h3 class="font-medium">Accent</h3>
        <p class="text-xs font-mono mt-1">{palette.accent}</p>
        <p class="text-xs mt-1">Highlights and CTAs</p>
      </div>
    </div>
    
    <!-- Neutral Color -->
    <div class="flex flex-col">
      <div class="h-24 rounded-t-lg border" style={`background-color: ${palette.neutral};`}></div>
      <div class="bg-neutral-200 p-3 rounded-b-lg">
        <h3 class="font-medium">Neutral</h3>
        <p class="text-xs font-mono mt-1">{palette.neutral}</p>
        <p class="text-xs mt-1">Backgrounds, text, borders</p>
      </div>
    </div>
    
    <!-- Semantic Color -->
    <div class="flex flex-col">
      <div class="h-24 rounded-t-lg" style={`background-color: ${palette.semantic};`}></div>
      <div class="bg-neutral-200 p-3 rounded-b-lg">
        <h3 class="font-medium">Semantic</h3>
        <p class="text-xs font-mono mt-1">{palette.semantic}</p>
        <p class="text-xs mt-1">Feedback states</p>
      </div>
    </div>
  </div>
  
  <div class="mt-8">
    <h3 class="text-xl font-semibold mb-4">Color Usage Guidelines</h3>
    <ul class="list-disc pl-5 space-y-2">
      <li><strong>Primary:</strong> Used for main brand elements, key UI components, and primary buttons.</li>
      <li><strong>Secondary:</strong> Used for headers, footers, and secondary UI elements.</li>
      <li><strong>Accent:</strong> Used sparingly for calls to action, highlights, and interactive elements.</li>
      <li><strong>Neutral:</strong> Used for backgrounds, text, borders, and to create visual hierarchy.</li>
      <li><strong>Semantic:</strong> Base color for feedback states (success, warning, error, info).</li>
    </ul>
  </div>
</div>
