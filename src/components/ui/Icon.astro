---
// <!-- Referenced by: components/common/navigation/NavItem.astro, components/common/navigation/ThemeToggle.astro, components/layout/footer/SocialLinks.astro, components/ui/ServiceCard.astro, pages/index.astro -->
import { icons } from '../../lib/types/IconLibrary';

interface Props {
  id?: string
  name: string;
  color?: string;
  size?: number;
  class?: string;
  stroke?: number;
  fill?: string;
}

const {
  name, 
  color = '#FFFF',
  size = 24, 
  class: className = '', 
  stroke = 1.5,
  fill = 'none',
} = Astro.props;

// Get the SVG path from the icon library
const icon = icons[name];

// If the icon doesn't exist, show a placeholder
const svgPath = icon || icons['placeholder'];
const isTheme = name==='sun-moon';
---

{!isTheme ? (
    <svg
      xmlns="http://www.w3.org/2000/svg" 
      width={size} 
      height={size} 
      viewBox="0 0 24 24" 
      fill={fill}
      stroke={color} 
      stroke-width={stroke} 
      stroke-linecap="round" 
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      {typeof svgPath === 'string' ? (
        <path d={svgPath} />
      ) : (
        <>
          {svgPath.map((path) => (
            <path d={path} />
          ))}
        </>
      )}
    </svg>
  ) : (
    // <span class={`inline-block rounded ${className}`} style={`width: ${size}px; height: ${size}px;`}></span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24" height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentcolor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="5" />

      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12" y2="23" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3" y2="12" />
      <line x1="21" y1="12" x2="23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />

      <path
        d="M16 12a4 4 0 1 1-5-3.87 3 3 0 1 0 5 3.87z"
        fill="var(--color-orange-200)"
        stroke="var(--color-brown-200)"
      />
    </svg>

  )
}
