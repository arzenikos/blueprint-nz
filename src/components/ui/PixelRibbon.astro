---
import { colors } from '../../styles/colors';

interface Props {
  pixelSize?: number;
  className?: string;
  colors?: string[];
}

const { 
  pixelSize = 2, 
  className = "",
  colors: customColors
} = Astro.props;

// Use custom colors if provided, otherwise use the default ribbon colors from the central palette
const ribbonColors = customColors || colors.ribbon;
const pixelSizeInPx = `${pixelSize}px`;
const totalHeight = pixelSize * ribbonColors.length;
---

<div class={`pixel-ribbon ${className}`} aria-hidden="true">
  {ribbonColors.map((color) => (
    <div class="pixel-line" style={`background-color: ${color}; height: ${pixelSizeInPx};`}></div>
  ))}
</div>

<style define:vars={{ totalHeight: `${totalHeight}px` }}>
  .pixel-ribbon {
    display: flex;
    flex-direction: column;
    height: var(--totalHeight);
    width: 100%;
    overflow: hidden;
  }
  
  .pixel-line {
    width: 100%;
  }
</style>
