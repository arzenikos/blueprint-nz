---
interface Card {
  title: string;
  description: string;
  link: string;
  image?: string;
  buttonText?: string;
}

interface Props {
  cards: Card[];
  columns?: number;
  centered?: boolean;
}

const { cards, columns = 2, centered = false } = Astro.props;

const getColumnClass = () => {
  switch (columns) {
    case 1: return 'grid-cols-1';
    case 2: return 'grid-cols-1 md:grid-cols-2';
    case 3: return 'grid-cols-1 md:grid-cols-3';
    case 4: return 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4';
    default: return 'grid-cols-1 md:grid-cols-2';
  }
};

// For 3 cards with 3 columns, we need to center them when there are fewer cards than columns
const centerClass = centered || (cards.length === 3 && columns === 3) ? 'place-items-center' : '';
---

<div class={`grid ${getColumnClass()} gap-6 md:gap-8 ${centerClass}`}>
  {cards.map(card => (
    <a href={card.link} class="group w-full max-w-md">
      <div class="border border-neutral-300 rounded-lg overflow-hidden hover:border-primary transition-colors h-full flex flex-col">
        {card.image && (
          <div class="h-48 bg-neutral-200 flex items-center justify-center overflow-hidden">
            <img 
              src={card.image} 
              alt={card.title} 
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
        )}
        {!card.image && (
          <div class="h-32 bg-primary/20 flex items-center justify-center">
            <span class="text-secondary font-medium">{card.title}</span>
          </div>
        )}
        <div class="p-5 md:p-6 flex flex-col flex-grow">
          <h3 class="font-semibold text-lg text-secondary mb-3 md:mb-2">{card.title}</h3>
          <p class="text-sm mb-5 md:mb-4 flex-grow">{card.description}</p>
          <div class="mt-auto">
            <span class="text-accent font-medium group-hover:underline">
              {card.buttonText || 'Learn more'} →
            </span>
          </div>
        </div>
      </div>
    </a>
  ))}
</div>
