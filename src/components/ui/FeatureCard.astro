---
// <!-- Referenced by: pages/features.astro -->
import Button from './button/Button.astro';

interface Props {
  title: string;
  description: string;
  image: string;
  link?: string;
  linkText: string;
  id?: string;
}

const { title, description, image, link, linkText, id } = Astro.props;
---

<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden theme-transition">
  <img 
    src={image} 
    alt={title} 
    class="w-full h-48 object-cover"
  />
  <div class="p-6">
    <h3 class="text-xl font-semibold mb-2">{title}</h3>
    <p class="text-gray-600 dark:text-gray-300 mb-4">
      {description}
    </p>
    {link ? (
      <Button variant="primary" href={link}>
        {linkText}
      </Button>
    ) : (
      <div id={id}>
        <Button variant="primary">
          {linkText}
        </Button>
      </div>
    )}
  </div>
</div>

{!link && id === 'open-chat' && (
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const openChatButton = document.getElementById('open-chat');
      const chatToggle = document.getElementById('chat-toggle');
      
      if (openChatButton && chatToggle) {
        openChatButton.addEventListener('click', () => {
          // Trigger the chat toggle button
          chatToggle.click();
        });
      }
    });
  </script>
)}
