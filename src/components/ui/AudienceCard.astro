---
interface Props {
  href: string;
  title: string;
  description: string;
  icon: string;
}

const { href, title, description, icon } = Astro.props;
---

<a href={href} class="audience-card group">
  <span class="audience-card__icon" aria-hidden="true">
    {icon === 'diagnosis' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-8 w-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-3.31 0-6 1.79-6 4v1h12v-1c0-2.21-2.69-4-6-4z" />
      </svg>
    )}
    {icon === 'support' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-8 w-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
      </svg>
    )}
    {icon === 'research' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-8 w-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-6h6v6M4 21h16M8 3h8l1 4H7l1-4zM4 7h16v14H4V7z" />
      </svg>
    )}
  </span>
  <h2 class="mt-5 text-xl font-semibold text-[var(--color-palette-five)] md:text-2xl">{title}</h2>
  <p class="mt-3 grow text-[var(--color-palette-four)]">{description}</p>
  <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-palette-three)]">
    Continue
    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>

<style>
  .audience-card {
    display: flex;
    flex-direction: column;
    min-height: 18rem;
    padding: 1.75rem 1.5rem;
    border-radius: 1rem;
    background: var(--color-palette-zero);
    border: 1px solid color-mix(in srgb, var(--color-palette-three) 35%, transparent);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-palette-five) 12%, transparent);
    text-decoration: none;
    transform: translateY(0);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .audience-card:hover,
  .audience-card:focus-visible {
    transform: translateY(-12px);
    box-shadow: 0 22px 40px color-mix(in srgb, var(--color-palette-five) 22%, transparent);
    border-color: var(--color-palette-three);
  }

  .audience-card__icon {
    display: inline-flex;
    height: 3.5rem;
    width: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-palette-one);
    color: var(--color-palette-four);
  }

  :global(.dark) .audience-card {
    background: var(--color-palette-two);
  }
</style>
