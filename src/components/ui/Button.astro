---
import { colors } from '../../lib/theme/colors';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [x: string]: any;
}

const { 
  href, 
  variant = 'primary', 
  size = 'md', 
  class: className = '',
  ...rest
} = Astro.props;

const variants = {
  primary: `bg-primary text-primary-content hover:bg-primary-dark`,
  secondary: `bg-secondary text-secondary-content hover:bg-secondary-light`,
  accent: `bg-accent text-accent-content hover:bg-accent-dark`,
  outline: `border border-primary text-primary hover:bg-primary/10`
};

const sizes = {
  sm: 'text-sm px-3 py-1.5',
  md: 'text-base px-4 py-2',
  lg: 'text-lg px-6 py-3 sm:min-w-64'
};

const baseClasses = 'inline-flex items-center justify-center gap-2 font-semibold rounded-md transition-colors cursor-pointer no-underline';
const classes = `${baseClasses} ${variants[variant]} ${sizes[size]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={classes} {...rest}>
  <slot />
</Tag>
