---
// <!-- Referenced by: components/ui/ServicesGrid.astro -->
import Icon from './icon/Icon.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  href?: string;
}

const { icon, title, description, href } = Astro.props;

const CardWrapper = href ? 'a' : 'div';
---

<CardWrapper 
  href={href} 
  class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 transition-all hover:scale-105 theme-transition"
>
  <div class="bg-blue-100 dark:bg-blue-900 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4 theme-transition">
    <Icon name={icon} class="icon-accent" />
  </div>
  <h3 class="text-xl font-semibold mb-3">{title}</h3>
  <p class="text-gray-600 dark:text-gray-300">
    {description}
  </p>
</CardWrapper>
