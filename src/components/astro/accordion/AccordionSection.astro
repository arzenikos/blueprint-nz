---
interface Props {
  title: string;
  open?: boolean; // whether it starts expanded
}
const { title, open = false } = Astro.props;
---
<details class="group border-b border-neutral-200" {open}>
  <summary
    class="flex cursor-pointer list-none items-center justify-between
           py-4 px-2 font-medium text-neutral-900
           marker:content-none
           hover:text-brand-primary"
  >
    <span>{title}</span>
    <svg
      class="h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-180"
      viewBox="0 0 20 20" fill="currentColor"
    >
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 
        11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 
        0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </summary>

  <div class="pb-6 px-2 pt-2">
    <slot />
  </div>
</details>