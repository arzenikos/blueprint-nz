---
import { SITE_TITLE, SITE_LOGO_LIGHT } from '../../consts';
const { showLeft = true } = Astro.props;

---

<header class="site-header">
	{showLeft && (
		<div class="header-left">
			<a href="/">
				<img src={SITE_LOGO_LIGHT} alt="Site logo" id="website-logo"/>
			</a>
			<div class="page-header-title website-title">
				<h2 class="site-name">{SITE_TITLE}</h2><br>
				Prostate Cancer Support Website
			</div>
		</div>
	)}
		
	<div class="header-left">
		
	</div> 
	<div class="pop-overs header-right">
		<nav>
			<!-- Newsletter Button -->
			<a href="https://m.webtoo.ls/@astro" target="_blank">
				<span class="sr-only">Newsletter</span>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 32 32"><path fill="none" stroke="#212121" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.00" d="M5 16v8c0 1.5 1.5 3 3 3h16c1.5 0 3-1.5 3-3v-8M5 16h5.5s1 3.5 5.5 3.5s5.5-3.5 5.5-3.5H27M5 16v3.5M5 16l1-5m21 5l-1-5M13.5 9h5m-5 4h5m-9 0V5h13v8"/></svg>
			</a>

			<!-- Beacon Button -->
			<a href="https://m.webtoo.ls/@astro" target="_blank">
				<span class="sr-only">See Clinics Near Me</span>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="black" d="M12 11.5A2.5 2.5 0 0 1 9.5 9A2.5 2.5 0 0 1 12 6.5A2.5 2.5 0 0 1 14.5 9a2.5 2.5 0 0 1-2.5 2.5M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7"/></svg>
			</a>

			<!-- Support Button -->
			<a href="https://twitter.com/astrodotbuild" target="_blank">
				<span class="sr-only">See Support Page</span>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="black" d="M11 18h2v-2h-2zm1-12c-2.2 0-4 1.8-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.8-3 5h2c0-2.2 3-2.5 3-5c0-2.2-1.8-4-4-4m7-1v14H5V5zm0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2"/></svg>
			</a>

			<!-- ACCESSIBILITY -->
			<a href="https://github.com/withastro/astro" target="_blank">
				<span class="sr-only">Accessibility button</span>
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 512 512"><circle cx="256" cy="56" r="40" fill="none" stroke="#212121" stroke-miterlimit="10" stroke-width="32.00"/
					><path 
						fill="none" 
						stroke="#212121" 
						stroke-miterlimit="10"
						stroke-width="32.00" 
						d="m199.3 295.62l-30.4 172.2a24 24 0 0 0 19.5 27.8a23.76 23.76 0 0 0 27.6-19.5l21-119.9v.2s5.2-32.5 17.5-32.5h3.1c12.5 0 17.5 32.5 17.5 32.5v-.1l21 119.9a23.92 23.92 0 1 0 47.1-8.4l-30.4-172.2l-4.9-29.7c-2.9-18.1-4.2-47.6.5-59.7c4-10.4 14.13-14.2 23.2-14.2H424a24 24 0 0 0 0-48H88a24 24 0 0 0 0 48h92.5c9.23 0 19.2 3.8 23.2 14.2c4.7 12.1 3.4 41.6.5 59.7Z"/></svg>
			</a>
		</nav>
	</div>
	
</header>
<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin: 0;
		padding: 0rem 1.5rem;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		gap: 5em;
	}
	.header-left {
		justify-self: start;
		align-items: center;
		display: flex;
		line-height: 0;
	}
	.header-right {
		justify-self: end;
	}
	#website-logo {
		height: 7vh;
	}
	.page-header-title {
		/* justify-content: center; */
		/* align-items: left; */
		padding: 2rem 0rem;
		scale: 75%;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		/* align-items: center; */
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.pop-overs,
	.pop-overs a {
		display: flex;
	}
	@media (max-width: 720px) {
		.pop-overs {
			display: none;
		}
	}
</style>
