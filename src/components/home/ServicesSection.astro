---
import { Image } from 'astro:assets';
import { homeData } from '../../data/home';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import placeholderImage from '../../assets/images/placeholder-image.jpg';

const { servicesSection } = homeData;
---

<Section title={servicesSection.title}>
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {servicesSection.services.map(service => (
        <Card height="h-full">
          <Image
            slot="image"
            src={placeholderImage}
            alt={service.alt}
            class="w-full rounded-t-lg"
            width={400}
            height={300}
            loading="lazy"
            format="webp"
            quality={80}
          />
          <div class="items-center text-center">
            <h3 class="text-xl font-semibold mb-3">{service.title}</h3>
            <p class="mb-4">{service.description || "Service description goes here."}</p>
            {service.link && (
              <a href={service.link} class="mt-4 inline-block text-primary hover:underline">
                Learn more
              </a>
            )}
          </div>
        </Card>
      ))}
    </div>
  </Container>
</Section>

<style>
  /* Ensure all cards in a row have the same height */
  .grid {
    display: grid;
    grid-auto-rows: 1fr;
  }
</style>
