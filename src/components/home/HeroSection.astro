---
import { Image } from 'astro:assets';
import { homeData } from '../../data/home';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Markdown from '../common/Markdown.astro';
import placeholderImage from '../../assets/images/placeholder-image.jpg';

const { hero } = homeData;
---

<section class="py-12">
  <Container>
    <div class="flex flex-col md:flex-row items-center gap-8 mb-10 w-full">
      <div class="w-full md:w-1/2">
        <h1 class="mb-6">{hero.title}</h1>
        <Markdown content={hero.slogan} class="mb-8 text-lg" />
        <Button href={hero.ctaLink} size="lg">{hero.ctaText}</Button>
      </div>
      <div class="w-full md:w-1/2">
        <Image
          src={placeholderImage}
          alt="Hero image"
          class="w-full max-w-full mx-auto rounded-lg shadow-lg"
          width={800}
          height={600}
          loading="eager"
          format="webp"
          quality={80}
        />
      </div>
    </div>
  </Container>
</section>
