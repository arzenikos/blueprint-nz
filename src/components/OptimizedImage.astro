<!-- Not imported by any file -->
---
interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
}

const { 
  src, 
  alt, 
  class: className = '', 
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  widths = [320, 640, 960, 1280],
  loading = 'lazy'
} = Astro.props;

// Determine if this is a local or remote image
const isRemoteImage = src.startsWith('http');

// For local images, use Netlify Image CDN
const generateSrcSet = () => {
  if (isRemoteImage) {
    // For remote images, use standard srcset with width descriptors
    return widths.map(width => `${src}?w=${width} ${width}w`).join(', ');
  } else {
    // For local images, use Netlify Image CDN
    return widths.map(width => `/.netlify/images?url=${src}&w=${width}&fm=webp ${width}w`).join(', ');
  }
};

const srcset = generateSrcSet();
---

<img 
  src={isRemoteImage ? src : `/.netlify/images?url=${src}&w=${widths[1]}&fm=webp`}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={loading}
  width={widths[1]}
  height="auto"
/>
