---
import { bluenodeData } from '../../content/bluenode.ts';
---
<div class="w-full md:h-full relative">
  <div id="nodes-viewport" class="w-full md:h-full overflow-hidden">
    <div id="nodes-container" class="w-full md:h-full relative transform-gpu origin-center">
         <div id="bluenode-data" class="hidden">
            {JSON.stringify(bluenodeData)}
          </div>

          <div id="blueNodeDiagram" class="h-70 md:h-full w-full" style="background-color: var(--color-palette-one);"></div>
    </div>
  </div>
  <svg class="absolute top-0 left-0 w-full md:h-full pointer-events-none" id="connection-lines"></svg>
</div>

<script src="https://cdn.jsdelivr.net/npm/gojs@3.0.24/release/go.js"></script>
<script id="code">
  const rootDict = JSON.parse(document.getElementById('bluenode-data').textContent);

  let bluenode;
  function init() {
    bluenode = new go.Diagram('blueNodeDiagram', {
      initialContentAlignment: go.Spot.TopCenter,
      layout: new go.TreeLayout({
        angle: 90,
        arrangement: go.TreeLayout.ArrangementVertical,
        layerSpacing: 40,
        nodeSpacing: 40
      }),
    });

    bluenode.nodeTemplate = new go.Node('Spot', {
      selectionObjectName: 'PANEL',
      isTreeExpanded: false,
      isTreeLeaf: false,
      click: (e, node) => {
        e.handled = true;
        expandNode(node);
        updateOutput(node.data);
      }
    }).add(
      new go.Panel('Auto', { name: 'PANEL' }).add(
        new go.Shape('RoundedRectangle', {
          height: 40,
          fill: 'whitesmoke',
          stroke: 'white'
        }).bind('rootdistance', dist => dist === 0 ? 160 : 80),
        new go.TextBlock({
          font: '10pt sans-serif',
          margin: 4,
          overflow: go.TextBlock.OverflowEllipsis,
          wrap: go.TextBlock.WrapFit,
          textAlign: 'center'
        }).bind('text', '', data => data.text || data.key)
      )
    );
    
    bluenode.model = new go.TreeModel([
      {
        key: rootDict.key,
        text: rootDict.text,
        info: rootDict.info,
        everExpanded: false,
        rootdistance: 0
      }
    ]);
  }

  function updateOutput(data) {
    const nodeTitle = document.getElementById('detail-title');
    const nodeContent = document.getElementById('detail-content');
    if (nodeTitle && nodeContent) {
      nodeTitle.innerHTML = `${data.text}`;
      nodeContent.innerHTML = `${data.info}`;
    }
  }
  
  function expandNode(node) {
    const diagram = node.diagram;
    diagram.startTransaction('CollapseExpandTree');

    const data = node.data;
    const parent = node.findTreeParentNode();

    // Collapse other siblings at same level
    if (parent) {
      parent.findTreeChildrenNodes().each((sibling) => {
        if (sibling !== node && sibling.isTreeExpanded) {
          diagram.commandHandler.collapseTree(sibling);
        }
      });
    }

    // Only create children if not already expanded
    if (!data.everExpanded) {
      diagram.model.setDataProperty(data, 'everExpanded', true);
      createSubTree(data);
    }

    // Expand or collapse the clicked node depending on state
    if (node.isTreeExpanded) {
      diagram.commandHandler.collapseTree(node);
    } else {
      diagram.commandHandler.expandTree(node);
    }

    // Center the expanded node after layout is complete
    diagram.commitTransaction('CollapseExpandTree');
    diagram.zoomToFit(); // Optional: include if you want to scale view
    diagram.scrollToRect(node.actualBounds);
  }

  // Recursive function to find any node in the dict tree
  function findNodeInDict(treeNode, key) {
    if (!treeNode) return null;
    if (treeNode.key === key) return treeNode;
    if (!treeNode.children) return null;
    for (const child of treeNode.children) {
      const found = findNodeInDict(child, key);
      if (found) return found;
    }
    return null;
  }

  function createSubTree(parentdata) {
    const model = bluenode.model;
    const parent = bluenode.findNodeForData(parentdata);
    const parentDict = findNodeInDict(rootDict, parentdata.key);
    const children = parentDict?.children || [];

    let degrees = 1;
    let grandparent = parent.findTreeParentNode();
    while (grandparent) {
      degrees++;
      grandparent = grandparent.findTreeParentNode();
    }

    for (let child of children) {
      const childdata = {
        key: child.key,
        text: child.text,
        info: child.info,
        parent: parentdata.key,
        rootdistance: degrees,
        everExpanded: false
      };
      model.addNodeData(childdata);
      const node = bluenode.findNodeForData(childdata);
      node.location = parent.location;
    }

    return children.length;
  }

window.addEventListener('DOMContentLoaded', init);

</script>