---
// imports
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import GraphCanvas from './GraphCanvas.astro';
import NodePanel from './NodePanel.astro';
import ZoomControls from './ZoomControls.astro';
import { bluenodeBranchData } from '../../content/bluenode';

const breadcrumbItems = [{ label: 'Blue Node', href: '/bluenode', current: true }];
---
<Layout title="BlueNode - BlueprintNZ">
  <Breadcrumbs items={breadcrumbItems} />
  <div class="flex flex-col md:flex-row w-full px-10 h-[calc(100vh-var(--header-height)-var(--footer-height))]" id="node-container">
    <GraphCanvas />
    <NodePanel />
  </div>
  <ZoomControls />
  <script type="module" src="/scripts/node-graph.js" />
</Layout>
