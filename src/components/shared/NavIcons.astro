---
import MobileNavTooltip from './MobileNavTooltip.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from '../icons/Icons.astro';
---

<nav class="flex items-center gap-4">
  <div class="hidden md:flex items-center gap-4">
    <a href="/about" class="text-secondary hover:text-secondary-dark no-underline">About</a>
    <a href="/services" class="text-secondary hover:text-secondary-dark no-underline">Services</a>
    <a href="/contact" class="text-secondary hover:text-secondary-dark no-underline">Contact</a>
  </div>
  
  <ThemeToggle />
  
  <div class="md:hidden">
    <button id="mobile-menu-button" class="p-2 rounded-full hover:bg-gray-100">
      <Icon name="Settings" />
    </button>
    <MobileNavTooltip />
  </div>
</nav>

<script>
  // Mobile menu toggle functionality
  const button = document.getElementById('mobile-menu-button');
  const tooltip = document.getElementById('mobile-nav-tooltip');
  
  if (button && tooltip) {
    button.addEventListener('click', () => {
      tooltip.classList.toggle('hidden');
    });
    
    // Close when clicking outside
    document.addEventListener('click', (event) => {
      if (!button.contains(event.target as Node) && !tooltip.contains(event.target as Node)) {
        tooltip.classList.add('hidden');
      }
    });
  }
</script>
