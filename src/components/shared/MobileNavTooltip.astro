---
// MobileNavTooltip.astro - Tooltip component for mobile navigation icons
---

<div id="mobile-nav-tooltip" class="hidden absolute right-4 top-16 bg-white shadow-lg rounded-lg p-4 z-50 w-48">
  <div class="flex flex-col space-y-4">
    <a href="/about" class="text-secondary hover:text-secondary-dark">About</a>
    <a href="/services" class="text-secondary hover:text-secondary-dark">Services</a>
    <a href="/contact" class="text-secondary hover:text-secondary-dark">Contact</a>
  </div>
</div>

<style>
  #mobile-nav-tooltip {
    border: 1px solid var(--color-border);
  }
  
  #mobile-nav-tooltip::before {
    content: '';
    position: absolute;
    top: -8px;
    right: 16px;
    width: 16px;
    height: 16px;
    background-color: var(--color-background);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    transform: rotate(45deg);
  }
</style>
