---
// <!-- Imported by: components/navigation/MainNav.astro -->
// import Icon from '../../../ui/Icon.astro';
// import type { NavItem as NavItemType } from '../../../../content/navigation';
// import ThemeToggle from '../../../common/ThemeToggle.astro';

// interface Props extends NavItemType {
//   iconSize?: number;
// }

const { 
  label, 
  href, 
  icon, 
  mobileOnly = false, 
  desktopOnly = false,
  isButtonGroup = false,
  // dropdownItems = [],
  buttonItems = [],
  // iconSize = 16
} = Astro.props;

const visibilityClass = mobileOnly 
  ? 'md:flex' 
  : desktopOnly 
    ? 'hidden md:flex' 
    : '';

const id = `nav-item-${label.toLowerCase().replace(/\s+/g, '-')}`;
---
  <div>
    {/* <!-- Mobile dropdown --> */}
    {!desktopOnly && (
      <div class={`md:hidden flex items-center ${visibilityClass}`} id="nav-setting-mobile">
        {/* <label for="font-size-dropdown" class="text-sm font-medium mr-2">{label}</label> */}
        <select 
          id="font-size-dropdown" 
          class="text-sm border border-gray-300 rounded px-3 py-1 focus:outline-none focus:ring-2 focus:ring-accent"
        >

          {buttonItems.map((item) => {
            const dropFontSize = 
              item.value === 'small' ? 'text-xs' : 
              item.value === 'medium' ? 'text-sm' :
              'text-base font-bold';
            return (<option class={`${dropFontSize}`} value={item.value}>{item.label}</option>)
          }
          )}
        </select>
      </div>
    )}

    {/* <!-- Desktop button group --> */}
    <div class={`hidden md:flex items-center ${visibilityClass}`} id="nav-setting-desktop">
      <span class="text-sm font-medium mr-4">{label}</span>
      <div class="flex borde rounded-md overflow-hidden" id={id}>
        {buttonItems.map((item) => {
          const fontSize =
            item.value === 'small' ? 'text-xs' :
            item.value === 'medium' ? 'text-sm' :
            'text-base font-bold';
          return (
            <button 
              class={`px-4 py-1 ${fontSize} transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-opacity-50`}
              data-value={item.value}
              aria-label={item.ariaLabel}
              style="border-color: var(--color-palette-one);"
            >
              {item.label}
            </button>
          );
        })}
      </div>
    </div>
  </div>

<script define:vars={{ id, label }}>
  // Add event listeners for dropdowns and button groups
  document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById(id);
    
    if (element) {
      const buttons = element.querySelectorAll('button[data-value]');
      
      // Set active state based on stored preference
      if (label === 'Font Size') {
        const storedFontSize = localStorage.getItem('fontSizePreference') || 'medium';
        buttons.forEach(button => {
          if (button.getAttribute('data-value') === storedFontSize) {
            button.classList.add('bg-red-100', 'text-blue-900');
          } else {
          button.classList.remove('bg-red-600', 'text-blue-900');
        }
        });
      }
      
      buttons.forEach(button => {
        button.addEventListener('click', (e) => {
          const value = button.getAttribute('data-value');
          button.style.backgroundColor = 'var(--color-palette-one)';
          button.style.color = 'var(--color-palette-five)';
          
          if (label === 'Font Size') {
            console.log(`Font size changed to: ${value}`);
            
            // Remove existing font size classes
            document.documentElement.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');
            
            // Add new font size class
            switch(value) {
              case 'small':
                document.documentElement.classList.add('text-sm');
                break;
              case 'medium':
                document.documentElement.classList.add('text-base');
                break;
              case 'large':
                document.documentElement.classList.add('text-xl'); // Changed from text-lg to text-xl for larger size
                break;
            }
            
            // Update active state
            // buttons.forEach(btn =>{
            // btn.classList.remove('bg-gray-100')
            // btn.classList.remove('text-blue-900')
          // });
            // button.classList.add('bg-gray-100');
            // button.classList.add('text-blue-900');
            
            // Store preference
            localStorage.setItem('fontSizePreference', value);
          }
        });
      });
    }
  });
  
  // Initialize font size from stored preference
  const storedFontSize = localStorage.getItem('fontSizePreference');
  if (storedFontSize) {
    switch(storedFontSize) {
      case 'small':
        document.documentElement.classList.add('text-sm');
        break;
      case 'medium':
        document.documentElement.classList.add('text-base');
        break;
      case 'large':
        document.documentElement.classList.add('text-xl'); // Changed from text-lg to text-xl for larger size
        break;
    }
  }

  const dropdown = document.getElementById('font-size-dropdown');
  if (dropdown && label === 'Font Size') {
    const storedFontSize = localStorage.getItem('fontSizePreference') || 'medium';
    dropdown.value = storedFontSize;

    dropdown.addEventListener('change', (e) => {
      const value = dropdown.value;
      console.log(`Font size changed to: ${value}`);

      document.documentElement.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');

      switch (value) {
        case 'small':
          document.documentElement.classList.add('text-sm');
          break;
        case 'medium':
          document.documentElement.classList.add('text-base');
          break;
        case 'large':
          document.documentElement.classList.add('text-xl');
          break;
      }

      localStorage.setItem('fontSizePreference', value);
    });
  }
</script>