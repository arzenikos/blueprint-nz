---

<div class="flex-shrink-0 w-45 md:w-65">
    <a href="/" class="flex items-center">
    <img 
        id="site-logo"
        src="/assets/images/logo-13232A-6DA3C0.png" 
        alt='BlueprintNZ Logo'
        class="object-contain"
        style={`height: ${logoSizes.mobile};`}
    />
    </a>
</div> 

