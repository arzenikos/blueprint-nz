---
// <!-- Referenced by: layouts/BaseLayout.astro -->
import { siteData } from '../../../content/site';
import { imageSizes } from '../../../lib/themes-and-layout/image';
import { componentSpacing } from '../../../lib/themes-and-layout/spacing';
import MainNav from './navigation/MainNav.astro';

// Get logo sizes from centralized file
const logoSizes = imageSizes.logo.default.height;
// Get header margin from centralized file
const headerMarginTop = componentSpacing.header.margin.top;
const headerMarginBottom = componentSpacing.header.margin.bottom;
---

<header class="sticky top-0 z-40 w-full bg-transparent">
  <!-- Spacer div for mobile top margin -->
  <div class="md:hidden" style={`margin-top: ${headerMarginTop.mobile};`}></div>
  <div class="hidden md:block" style={`margin-top: ${headerMarginTop.desktop};`}></div>

  <div class="container mx-auto px-6 max-w-[2000px]">
    <!-- Desktop layout -->
    <div class="hidden md:flex md:flex-row md:items-center md:justify-between h-16">
      <!-- Logo (left) - Size from centralized file -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center">
          <img 
            src="/src/assets/images/logo-03045e-6985c0.png" 
            alt={siteData.site.title} 
            class="max-h-full object-contain dark:hidden"
            style={`height: ${logoSizes.desktop}; @media (min-width: 1440px) { height: ${logoSizes.large}; }`}
          />
          <img 
            src="/src/assets/images/logo-13232A-6DA3C0.png" 
            alt={siteData.site.title} 
            class="max-h-full object-contain hidden dark:block"
            style={`height: ${logoSizes.desktop}; @media (min-width: 1440px) { height: ${logoSizes.large}; }`}
          />
        </a>
      </div>
      
      <!-- Right Navigation Items -->
      <div class="flex items-center space-x-1 sm:space-x-8">
        <MainNav />
      </div>
    </div>
    
    <!-- Mobile layout -->
    <div class="md:hidden flex flex-row items-center justify-between h-16">
      <!-- Logo (left) - Size from centralized file -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center">
          <img 
            src="/src/assets/images/logo-03045e-6985c0.png" 
            alt={siteData.site.title} 
            class="max-h-full object-contain dark:hidden"
            style={`height: ${logoSizes.mobile};`}
          />
          <img 
            src="/src/assets/images/logo-13232A-6DA3C0.png" 
            alt={siteData.site.title} 
            class="max-h-full object-contain hidden dark:block"
            style={`height: ${logoSizes.mobile};`}
          />
        </a>
      </div>
      
      <!-- Theme and Font Controls on same line as logo for mobile -->
      <div class="flex items-center">
        <MainNav class="mobile-controls" />
      </div>
    </div>
  </div>
  
  <!-- Spacer div for mobile bottom margin -->
  <div class="md:hidden" style={`margin-bottom: ${headerMarginBottom.mobile};`}></div>
  <div class="hidden md:block" style={`margin-bottom: ${headerMarginBottom.desktop};`}></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Responsive image sizing for max screen width
    const handleResize = () => {
      const isMaxWidth = window.innerWidth >= 1920;
      const icons = document.querySelectorAll('header svg:not(.logo-svg)');
      
      icons.forEach(icon => {
        if (isMaxWidth) {
          icon.classList.add('scale-75');
        } else {
          icon.classList.remove('scale-75');
        }
      });
    };
    
    // Initial call and event listener
    handleResize();
    window.addEventListener('resize', handleResize);
  });
</script>