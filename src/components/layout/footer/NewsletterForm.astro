---
interface Props {
  title: string;
  description: string;
  placeholder: string;
  buttonText: string;
}

const { title, description, placeholder, buttonText } = Astro.props;
---

<div class="w-full lg:w-1/3">
  <h3 class="text-sm font-semibold text-white mb-2">{title}</h3>
  <p class="text-xs text-neutral/80 dark:text-gray-300 mb-4">{description}</p>
  
  <form class="flex flex-col sm:flex-row gap-2">
    <input 
      type="email" 
      placeholder={placeholder}
      class="bg-white/10 text-white placeholder-white/50 border border-white/20 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-white/30 w-full"
      required
    />
    <button 
      type="submit"
      class="bg-primary hover:bg-primary/90 text-secondary font-medium rounded-md px-4 py-2 text-sm transition-colors"
    >
      {buttonText}
    </button>
  </form>
</div>
