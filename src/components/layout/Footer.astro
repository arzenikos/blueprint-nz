---
import { siteData } from '../../data/site';
import PixelRibbon from '../shared/PixelRibbon.astro';
import { componentSpacing } from '../../styles/spacing';
import { palette } from '../../styles/theme';

const { footer } = siteData;

// Get spacing values from centralized file
const footerPaddingX = componentSpacing.footer.padding.x;
const footerPaddingY = componentSpacing.footer.padding.y;
const footerMarginTop = componentSpacing.footer.margin.top;
const footerDividerMargin = componentSpacing.footer.divider.margin.y;
---

<footer class="w-full border-t border-secondary/20 bg-secondary" style={`
  padding-top: ${footerPaddingY};
  padding-bottom: ${footerPaddingY};
  margin-top: ${footerMarginTop};
`}>
  <PixelRibbon pixelSize={2} />
  <div class="container mx-auto max-w-[2000px]" style={`
    padding-left: ${footerPaddingX.mobile}; 
    padding-right: ${footerPaddingX.mobile};
    @media (min-width: 768px) {
      padding-left: ${footerPaddingX.tablet}; 
      padding-right: ${footerPaddingX.tablet};
    }
    @media (min-width: 1024px) {
      padding-left: ${footerPaddingX.desktop}; 
      padding-right: ${footerPaddingX.desktop};
    }
  `}>
    <nav aria-label="Secondary" class="flex flex-col lg:flex-row justify-between gap-8 lg:gap-16 pt-4">
      <div class="flex flex-col md:max-lg:w-1/2 lg:max-w-sm">
        <p class="font-semibold text-base md:text-lg text-neutral">{footer.newsletterSection.title}</p>
        <p class="mb-4 pt-2 text-primary text-sm">
          {footer.newsletterSection.description}
        </p>
        <form
          action="#"
          method="post"
          class="flex flex-col sm:flex-row gap-2">
          <input 
            class="h-9 rounded-lg border border-primary bg-secondary px-3 py-1 text-neutral text-sm focus:outline-none focus:ring-[1px] focus:ring-primary flex-grow" 
            type="email"
            placeholder={footer.newsletterSection.placeholder}
            name="email"
            id="email"
            required>
          <button
            type="submit"
            class="h-9 px-4 border border-secondary/10 text-sm font-light bg-accent hover:bg-accent/80 text-neutral hover:cursor-pointer rounded-lg">
            {footer.newsletterSection.buttonText}
          </button>
        </form>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8">
        {footer.sections.map((section, index) => (
          <section class="flex flex-col">
            <h2 id={`footerHeading${index}`} class="mb-3 text-neutral font-semibold text-sm">{section.title}</h2>
            <ul aria-labelledby={`footerHeading${index}`} class="flex flex-col gap-1.5">
              {section.links.map(link => (
                <li><a href={link.url} class="footer-link text-xs">{link.text}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </nav>
    
    <hr class="border-primary/30" style={`margin-top: ${footerDividerMargin}; margin-bottom: ${footerDividerMargin};`}>
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="text-xs text-center md:text-left text-neutral/60">
        {footer.copyright}
      </div>
      <div class="flex items-center gap-3">
        {footer.socialLinks.map(social => (
          <a href={social.url} class="text-neutral hover:text-primary" aria-label={social.ariaLabel}>
            <span class="sr-only">{social.ariaLabel}</span>
            <svg class="w-4 h-4" aria-hidden="true">
              <use href="/assets/svg/icons.svg#${social.platform}"></use>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: rgba(185, 214, 242, 0.6); /* primary color with opacity */
    transition: color 0.2s ease;
  }
  
  .footer-link:hover {
    color: rgba(185, 214, 242, 1); /* primary color full opacity */
  }
</style>
