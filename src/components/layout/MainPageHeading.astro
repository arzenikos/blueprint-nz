---
import Breadcrumbs from '../ui/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  heading: string;
  description?: string | string[];
  breadcrumbItems?: BreadcrumbItem[];
}

const { heading, description, breadcrumbItems = [] } = Astro.props;
const descriptionList = Array.isArray(description) ? description : description ? [description] : [];
---

<header class="mb-10">
  {breadcrumbItems.length > 0 && <Breadcrumbs items={breadcrumbItems} />}
  <h1 class="text-3xl font-bold text-[var(--color-palette-five)] md:text-4xl">{heading}</h1>
  {descriptionList.map((line) => (
    <p class="mt-3 max-w-3xl text-[var(--color-palette-four)]">{line}</p>
  ))}
</header>
