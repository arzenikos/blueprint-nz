<!-- Imported by: components/footer/SocialLinks.astro, components/navigation/NavItem.astro, components/navigation/SearchBar.astro, components/navigation/SearchButton.astro, components/shared/NavIcons.astro -->
---
/**
 * Icon Component - A centralized component for rendering SVG icons
 * 
 * Usage:
 * <Icon name="search" size="24" class="text-primary" />
 */

import { icons } from './IconLibrary';

interface Props {
  name: keyof typeof icons;
  size?: number | string;
  class?: string;
  title?: string;
}

const { 
  name, 
  size = 24, 
  class: className = '',
  title
} = Astro.props;

// Get the SVG path data from the icon library
const icon = icons[name];

if (!icon) {
  console.error(`Icon "${name}" not found in icon library`);
}

// Determine the viewBox
const viewBox = icon?.viewBox || '0 0 24 24';

// Combine classes
const classes = `icon icon-${name} ${className}`.trim();
---

{icon ? (
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width={size} 
    height={size} 
    viewBox={viewBox}
    class={classes}
    aria-hidden={!title ? 'true' : undefined}
    role={title ? 'img' : undefined}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {title && <title>{title}</title>}
    <path d={icon.path}></path>
  </svg>
) : (
  <span class="text-red-500">Icon "{name}" not found</span>
)}
